<div class="mt-8 w-64 flex-initial">
  <h2 class="bg-amber-300 py-3 px-5 font-medium text-sm tracking-wide rounded-t-xl">
    <%= lucide_icon("book", class: "w-4 h-4 shrink-0") %>
    Grade books
  </h2>

  <% if grade_books.any? %>
    <ul class="divide-y divide-slate-200 bg-white rounded-md shadow">
      <% grade_books.each do |book| %>
        <li class="px-6 py-4 hover:bg-slate-50">
          <%= link_to classroom_grade_book_path(@classroom, book),
                      class: "tw-link font-medium" do %>
            <span class="flex flex-between items-center justify-between w-full">
              <%= book.quarter.name %>
              <%= lucide_icon("arrow-right", class: "w-4 h-4 shrink-0") %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="text-center py-8 text-slate-500">
      No grade books created for this classroom yet.
    </div>
  <% end %>
</div>
