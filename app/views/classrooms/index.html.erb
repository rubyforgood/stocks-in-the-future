<div class="flex flex-col h-full w-full">

  <header class="flex items-center justify-between px-6 py-4 border-b">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 py-2">Classrooms</h1>
    <% if policy(Classroom).new? %>
      <%= link_to "New classroom", new_classroom_path,
                  class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
    <% end %>
  </header>

  <div class="flex-1 py-6">
    <%= render "shared/table_container" do %>
      <thead>
        <tr class="table-header-row">
          <th scope="col" class="table-header-cell table-header-cell-left">
            <%= sort_link(:name, "Name") %>
          </th>
          <th scope="col" class="table-header-cell table-header-cell-left">
            Teacher(s)
          </th>
          <th scope="col" class="table-header-cell table-header-cell-left">
            <%= sort_link(:student_count, "Student Count") %>
          </th>
          <th scope="col" class="table-header-cell table-header-cell-right">
            <%= sort_link(:total_earnings, "Total Earnings") %>
          </th>
          <th scope="col" class="table-header-cell table-header-cell-center">
            Edit
          </th>
        </tr>
      </thead>
      <tbody>
        <% if @classrooms.any? %>
          <% @classrooms.each do |classroom| %>
            <tr class="table-body-row">
              <td class="table-body-cell">
                <span class="table-cell-content">
                  <%= link_to classroom.name, classroom_path(classroom), class: "text-black underline hover:text-sitf-primary-dark" %>
                </span>
              </td>
              <td class="table-body-cell py-4">
                <div class="flex gap-1 overflow-x-auto py-1" style="max-width: 510px; min-height: 36px;">
                  <% if classroom.teachers.any? %>
                    <% classroom.teachers.each do |teacher| %>
                      <span class="inline-flex items-center px-2.5 py-1.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200 whitespace-nowrap flex-shrink-0">
                        <%= lucide_icon("user-round", class: "mr-1 text-blue-600 w-4 h-4 shrink-0") %>
                        <%= teacher.display_name %>
                      </span>
                    <% end %>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-500 border border-slate-200 whitespace-nowrap">
                      <%= lucide_icon("user-x", class: "mr-1 text-slate-500 w-4 h-4 shrink-0") %>
                      No teacher assigned
                    </span>
                  <% end %>
                </div>
              </td>
              <td class="table-body-cell">
                <span class="table-cell-content">
                  <%= classroom.students.count %>
                </span>
              </td>
              <td class="table-body-cell table-body-cell-right">
                <span class="table-cell-content">
                  <%# Sum integer cents and convert once, rather than adding up
                      per-student Floats and accumulating error across a class. %>
                  <%= number_to_currency(classroom.students.sum { |s| s.portfolio&.calculate_total_value_cents || 0 } / 100.0) %>
                </span>
              </td>
              <td class="table-body-cell table-body-cell-center">
                <% if policy(classroom).edit? %>
                  <%= render partial: "components/action_icon_button",
                             locals: {
                               options: {
                                 path: edit_classroom_path(classroom),
                                 icon: "pencil",
                                 title: "Edit classroom",
                                 aria_label: "Edit classroom",
                                 text_class: "text-black"
                               }
                             } %>
                <% else %>
                  <span class="table-no-permission">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr class="table-body-row">
            <td class="table-empty-cell" colspan="5">
              <p class="text-lg">No classrooms found</p>
              <p class="mt-2">Create your first classroom to get started!</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </div>
</div>
