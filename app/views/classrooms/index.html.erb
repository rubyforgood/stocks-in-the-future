<% content_for :title, "Classes" %>
<%# A plain block, like every other index page - see the note in orders#index, which carried the same
    `flex flex-col h-full w-full` shell around a bare header wrapper. %>
<div>

  <%# The button was bg-blue-500 with white bold text: off-brand, and 3.68:1, which fails the
      4.5:1 gate for label text. tw-btn-primary is the brand teal at 6.18:1. %>
  <%= render layout: "components/ui/page_header", locals: { title: "Classrooms" } do %>
    <% if policy(Classroom).new? %>
      <%= link_to "New classroom", new_classroom_path, class: "tw-btn-primary" %>
    <% end %>
  <% end %>

  <%# Whether the actions column can ever hold anything for this viewer.

      ClassroomPolicy#edit? was `user.admin?`, so a teacher had an unlabelled trailing column
      containing nothing but italic hyphens, on every row - a column that says only "there is a
      column here".

      That comment used to add "the dash is the right convention when a column holds actions for
      *some* rows and not others, which is what portfolios#show does". It was not what that page
      did: `Trade` there is gated on the viewer, so its column was all links or all dashes, and it
      was reported as a hyphen against every holding. Both dashes are gone from the app now, and
      with them `.table-no-permission` - see migration.md for the declaration if a genuinely mixed
      column ever needs it back.

      `any?` rather than `policy(Classroom).edit?` because edit? is defined per record. It happens
      to ignore the record today, and asking per record is what keeps this correct if it stops. %>
  <% actions_column = @classrooms.any? { |classroom| policy(classroom).edit? } %>

  <div>
    <%= render "shared/table_container" do %>
      <thead>
        <tr class="table-header-row">
          <th scope="col" class="table-header-cell table-header-cell-left">
            <%= sort_link(:name, "Name") %>
          </th>
          <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
            Teacher(s)
          </th>
          <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
            <%= sort_link(:student_count, "Student count") %>
          </th>
          <th scope="col" class="table-header-cell table-header-cell-right hidden lg:table-cell">
            <%= sort_link(:total_earnings, "Total earnings") %>
          </th>
          <%# The trailing actions column is unlabelled, like every other table in the app - a
              header naming one action stops being true as soon as a second one is added. %>
          <% if actions_column %>
            <th scope="col" class="table-header-cell table-header-cell-right table-actions-cell hidden lg:table-cell">
              <span class="sr-only">Actions</span>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% if @classrooms.any? %>
          <% @classrooms.each do |classroom| %>
            <%# Each cell's content is captured once and rendered at whichever width is in play - in its
                own column at lg, or as a labelled line inside the Name cell below it, where this table
                is one column. Captured rather than written twice, so the two widths cannot come to show
                different things. This table overflowed its scroller by 227px at 375px. %>
            <% teachers_cell = capture do %>
                <%# max-w-128 is 512px, on the scale, and caps the badge strip so a class with six
                    teachers scrolls rather than widening the column.
                    No `py-4` on the cell and no `py-1` or `min-h-9` on the strip. All three were
                    carried over from an inline `style="max-width: 510px; min-height: 36px"`, and
                    together they put this cell's text 14px below every other column in the row and
                    made the row 69px against the 48px this document sets. `items-start` keeps the
                    badges on the same line as the neighbouring text rather than stretching them to
                    the row's height. %>
                <div class="flex max-w-128 items-start gap-1 overflow-x-auto">
                  <% if classroom.teachers.any? %>
                    <% classroom.teachers.each do |teacher| %>
                      <%= render "components/ui/badge",
                                 label: teacher.display_name,
                                 tone: :info,
                                 class: "shrink-0 whitespace-nowrap" %>
                    <% end %>
                  <% else %>
                    <%= render "components/ui/badge",
                               label: "No teacher assigned",
                               tone: :neutral,
                               class: "whitespace-nowrap" %>
                  <% end %>
                </div>
            <% end %>

            <% students_cell = capture do %>
              <span class="table-cell-content">
                <%= classroom.students.count %>
              </span>
            <% end %>

            <% earnings_cell = capture do %>
              <span class="table-cell-content">
                <%# Sum integer cents and convert once, rather than adding up
                    per-student Floats and accumulating error across a class. %>
                <%= number_to_currency(classroom.students.sum { |s| s.portfolio&.calculate_total_value_cents || 0 } / 100.0) %>
              </span>
            <% end %>

            <%# The capture is entered whatever `actions_column` says, and comes back blank when the
                column is not there - a blank capture is `blank?`, so the stacked block renders nothing
                for it. Wrapping the capture in the `if` instead would leave the local undefined. %>
            <% row_actions = capture do %>
              <% if actions_column %>
                <% if policy(classroom).edit? %>
                  <%= ghost_action_link "Edit", edit_classroom_path(classroom), icon: "pencil" %>
                <% end %>
              <% end %>
            <% end %>

            <tr class="table-body-row">
              <td class="table-body-cell">
                <span class="table-cell-content">
                  <%= link_to classroom.name, classroom_path(classroom), class: "tw-link font-medium" %>
                </span>

                <%= render "shared/stacked_row_fields",
                           fields: [["Teacher(s)", teachers_cell], ["Student count", students_cell],
                                    ["Total earnings", earnings_cell]],
                           actions: row_actions %>
              </td>
              <td class="table-body-cell hidden lg:table-cell">
                <%= teachers_cell %>
              </td>
              <td class="table-body-cell hidden lg:table-cell">
                <%= students_cell %>
              </td>
              <td class="table-body-cell table-body-cell-right hidden lg:table-cell">
                <%= earnings_cell %>
              </td>
              <% if actions_column %>
                <td class="table-body-cell table-body-cell-right table-actions-cell hidden lg:table-cell">
                  <%# No dash on a row without the action, because no such row reaches here.
                      `ClassroomPolicy::Scope` gives a teacher only the classrooms they teach and `edit?`
                      permits exactly those, and an admin may edit all of them - so `actions_column` being
                      true means *every* row has the link, not merely one. The per-row check stays as the
                      guard for a scope that widens; what went is the branch that could not fire. %>
                  <div class="flex items-center justify-end gap-1">
                    <% if policy(classroom).edit? %>
                      <%= ghost_action_link "Edit", edit_classroom_path(classroom), icon: "pencil" %>
                    <% end %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% else %>
          <tr class="table-body-row">
            <td class="table-empty-cell" colspan="<%= actions_column ? 5 : 4 %>">
              <p class="text-lg">No classrooms found</p>
              <p class="mt-2">Create your first classroom to get started!</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </div>
</div>
