<div class="flex flex-col h-full w-full">

  <div class="pt-6">
    <%# The button was bg-blue-500 with white bold text: off-brand, and 3.68:1, which fails the
        4.5:1 gate for label text. tw-btn-primary is the brand teal at 6.18:1. %>
    <%= render layout: "components/ui/page_header", locals: { title: "Classrooms" } do %>
      <% if policy(Classroom).new? %>
        <%= link_to "New classroom", new_classroom_path, class: "tw-btn-primary" %>
      <% end %>
    <% end %>
  </div>

  <div class="flex-1 pb-6">
    <%= render "shared/table_container" do %>
      <thead>
        <tr class="table-header-row">
          <th scope="col" class="table-header-cell table-header-cell-left">
            <%= sort_link(:name, "Name") %>
          </th>
          <th scope="col" class="table-header-cell table-header-cell-left">
            Teacher(s)
          </th>
          <th scope="col" class="table-header-cell table-header-cell-left">
            <%= sort_link(:student_count, "Student count") %>
          </th>
          <th scope="col" class="table-header-cell table-header-cell-right">
            <%= sort_link(:total_earnings, "Total earnings") %>
          </th>
          <%# The trailing actions column is unlabelled, like every other table in the app - a
              header naming one action stops being true as soon as a second one is added. %>
          <th scope="col" class="table-header-cell table-header-cell-right table-actions-pinned">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody>
        <% if @classrooms.any? %>
          <% @classrooms.each do |classroom| %>
            <tr class="table-body-row">
              <td class="table-body-cell">
                <span class="table-cell-content">
                  <%= link_to classroom.name, classroom_path(classroom), class: "tw-link font-medium" %>
                </span>
              </td>
              <td class="table-body-cell py-4">
                <%# max-w-128 is 512px and min-h-9 is 36px, both on the scale. This was an inline
                    style="max-width: 510px; min-height: 36px" - the 2px difference is not visible
                    and the scale value is checkable. %>
                <div class="flex max-w-128 min-h-9 gap-1 overflow-x-auto py-1">
                  <% if classroom.teachers.any? %>
                    <% classroom.teachers.each do |teacher| %>
                      <%= render "components/ui/badge",
                                 label: teacher.display_name,
                                 tone: :info,
                                 class: "shrink-0 whitespace-nowrap" %>
                    <% end %>
                  <% else %>
                    <%= render "components/ui/badge",
                               label: "No teacher assigned",
                               tone: :neutral,
                               class: "whitespace-nowrap" %>
                  <% end %>
                </div>
              </td>
              <td class="table-body-cell">
                <span class="table-cell-content">
                  <%= classroom.students.count %>
                </span>
              </td>
              <td class="table-body-cell table-body-cell-right">
                <span class="table-cell-content">
                  <%# Sum integer cents and convert once, rather than adding up
                      per-student Floats and accumulating error across a class. %>
                  <%= number_to_currency(classroom.students.sum { |s| s.portfolio&.calculate_total_value_cents || 0 } / 100.0) %>
                </span>
              </td>
              <td class="table-body-cell table-body-cell-right table-actions-pinned">
                <div class="flex items-center justify-end gap-1">
                  <% if policy(classroom).edit? %>
                    <%= ghost_action_link "Edit", edit_classroom_path(classroom), icon: "pencil" %>
                  <% else %>
                    <span class="table-no-permission">-</span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr class="table-body-row">
            <td class="table-empty-cell" colspan="5">
              <p class="text-lg">No classrooms found</p>
              <p class="mt-2">Create your first classroom to get started!</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </div>
</div>
