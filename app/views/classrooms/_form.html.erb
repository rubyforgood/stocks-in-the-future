<%= form_with(model: classroom, class: "contents") do |form| %>
  <% if classroom.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-700 px-3 py-2 font-medium rounded-lg mt-3">
      <h2>
        <%= pluralize(classroom.errors.count, "error") %> prohibited this classroom from being saved:
      </h2>

      <ul>
        <% classroom.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name, class: 'tw-label-primary' do %>
      Name<span class="required-indicator">*</span>
    <% end %>
    <div class="mt-2">
      <%= form.text_field :name, class: "tw-input-primary", required: true %>
    </div>
  </div>

<%# School, year and the teacher assignment are admin-only, matching ClassroomPolicy's permitted
    attributes. A teacher who saw these would be filling in fields whose values are dropped on submit,
    which is worse than not offering them: the page would look like it saved and quietly would not.
    The check is the same policy the parameter filter uses, so the two cannot drift apart. %>
<% admin_fields = policy(classroom).permitted_attributes.include?(:school_id) %>

<% if admin_fields %>
  <div class="my-5">
    <%= form.label :school_id, "School name", class: 'tw-label-primary' %>
    <div class="mt-2">
      <% school_year = classroom&.school_year
         selected_school_id = school_year&.school&.id %>
      <%= form.select :school_id,
                      options_from_collection_for_select(@schools, :id, :name, selected_school_id),
                      { prompt: "Select a school" },
                      { class: "tw-input-primary" } %>
    </div>
  </div>

  <div class="my-5">
    <%= form.label :year_id, "Year", class: 'tw-label-primary' %>
    <div class="mt-2">
      <% school_year = classroom&.school_year
         selected_year_id = school_year&.year&.id %>
      <%= form.select :year_id,
                      options_from_collection_for_select(@years, :id, :name, selected_year_id),
                      { prompt: "Select a year" },
                      { class: "tw-input-primary" } %>
    </div>
  </div>
<% end %>

  <%# These three checkboxes were the only controls in the app with no focus indicator of their own.
      They carried `focus-visible:ring-sitf-primary`, which sets a ring *colour* and no ring *width*, so
      nothing painted and they fell back to Chrome's default 1px outline - measured, `1px auto
      rgb(16, 16, 16)` against every other control's `2px solid rgb(0, 105, 140)`. The same shape as the
      `ring-2` trap already recorded here: a ring needs a width, and this app draws focus with `outline`.

      Three more things were wrong with the same string. `text-sitf-primary` does nothing to a native
      checkbox - `accent-color` is what tints it - `rounded` is an 8px radius on a 16px box, which reads
      as a circle, and there was no size. `components/ui/_checkbox` had all four right the whole time.
      Matched to it here rather than converted, because these are collection checkboxes inside a form
      builder; a call site that can use the component should. %>
  <div class="my-5">
  <%= form.label :grade_ids, class: 'tw-label-primary flex items-center gap-2' do %>
    Grades<span class="required-indicator">*</span>
  <% end %>

  <!-- Single hidden field to handle empty selections -->
  <%= hidden_field_tag "classroom[grade_ids][]", "" %>

  <div class="mt-3 grid grid-cols-2 lg:grid-cols-4 gap-3 max-h-60 overflow-y-auto p-3 border border-slate-200 rounded-lg bg-slate-50">
    <% Grade.where(level: Classroom::GRADE_RANGE).order(:level).each do |grade| %>
      <%# Check if this grade is selected for the classroom %>
      <% is_checked = classroom.persisted? ? classroom.grades.include?(grade) : false %>

      <label class="flex items-center gap-3 p-3 hover:bg-white rounded-lg cursor-pointer transition-colors">
        <%= check_box_tag "classroom[grade_ids][]",
                          grade.id,
                          is_checked,
                          class: "size-4 shrink-0 rounded-sm border-slate-300 accent-sitf-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary" %>

        <div class="flex-1">
          <div class="font-medium text-slate-900">
            <%= grade.name %>
          </div>
        </div>
      </label>
    <% end %>
  </div>

  <p class="text-sm text-slate-600 mt-2">
    <span class="text-red-700 font-medium">* Required:</span> Select at least one grade that applies to this classroom.
  </p>
  </div>

  <div class="my-5">
    <div class="flex items-center gap-3">
      <%= form.check_box :trading_enabled, class: "size-4 shrink-0 rounded-sm border-slate-300 accent-sitf-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary" %>
      <%= form.label :trading_enabled, "Enable trading", class: 'tw-label-primary' %>
    </div>
    <p class="text-sm text-slate-600 mt-1">When enabled, students in this classroom can place buy and sell orders.</p>
  </div>

  <% if admin_fields %>
  <div class="my-5">
    <%= label_tag :teacher_ids, "Teachers", class: 'tw-label-primary flex items-center gap-2' %>

    <!-- Single hidden field to handle empty selections -->
    <%= hidden_field_tag "classroom[teacher_ids][]", "" %>

    <div class="mt-3 grid grid-cols-1 lg:grid-cols-3 gap-2 max-h-60 overflow-y-auto p-2 border border-slate-200 rounded-lg bg-slate-50">
      <% @teachers.each do |teacher| %>
        <%# Check if teacher is assigned to this classroom %>
        <% is_checked = classroom.persisted? ? classroom.teachers.include?(teacher) : false %>

        <label class="flex items-start gap-2 p-3 hover:bg-white rounded-lg cursor-pointer transition-colors">
          <%= check_box_tag "classroom[teacher_ids][]",
                            teacher.id,
                            is_checked,
                            {
                              class: "mt-0.5 size-4 shrink-0 rounded-sm border-slate-300 accent-sitf-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary",
                              id: "classroom_teacher_ids_#{teacher.id}"
                            } %>

          <div class="flex items-start gap-2 min-w-0 flex-1">
            <%# bg-blue-500 with white text measures 3.68:1. The brand teal is 6.18:1. %>
            <div class="w-8 h-8 bg-sitf-primary rounded-full flex items-center justify-center text-sitf-on-primary text-sm font-medium flex-shrink-0 mt-1">
              <%= teacher.display_name.first.upcase %>
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-slate-900 font-medium truncate">
                <%= teacher.display_name %>
              </div>
              <div class="text-xs text-slate-500 truncate">
                @<%= teacher.email %>
              </div>
            </div>
          </div>
        </label>
      <% end %>
    </div>
  </div>
  <% end %>

  <div class="inline">
    <%# The label is explicit because a bare form.submit lets Rails generate one from the model
        name - "Create Classroom" - which is Title Case and invisible to any copy sweep, since
        the string exists nowhere in the source. %>
    <% submit_label = classroom.persisted? ? "Update classroom" : "Create classroom" %>
    <%= form.submit submit_label, class: "tw-btn-primary" %>
  </div>
<% end %>
