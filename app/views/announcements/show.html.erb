<% content_for :title, @announcement.title %>

<div class="max-w-7xl mx-auto space-y-6 pb-16">

  <%# The title was a saturated bg-teal-700 band inside the card, at text-lg with tracking-wide -
      Tailwind's teal, which is a mint green and not the brand (sitf-primary is #00698c), and two
      steps off the type scale. It was also the only thing on the page that looked like a heading
      while not being one: this page had no h1 at all.

      It is the page's h1 now, on the shared header, like every other page in the app. %>
  <%= render layout: "components/ui/page_header",
             locals: { title: @announcement.title } do %><% end %>

  <div class="tw-card">
    <div class="p-8">
      <div class="trix-content text-slate-700 leading-relaxed">
        <%= @announcement.content %>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-200">
        <%= link_to "Back", :back, class: "tw-btn-secondary" %>
      </div>
    </div>
  </div>
</div>
