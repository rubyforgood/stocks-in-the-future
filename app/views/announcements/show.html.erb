<% content_for :title, @announcement.title %>

<div class="max-w-[1180px] mx-auto space-y-6 pb-16">

  <!-- Announcement Content Card -->
  <div class="rounded-xl border border-slate-200 bg-white overflow-hidden">
    <div class="bg-teal-700 text-white py-4 px-6 font-semibold text-lg tracking-wide">
      <%= @announcement.title %>
    </div>
    <div class="p-8">
      <div class="trix-content text-slate-700 leading-relaxed">
        <%= @announcement.content %>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-200">
        <%= link_to "Back", :back, class: "inline-flex items-center rounded-md px-4 py-2.5 bg-slate-100 hover:bg-slate-50 font-medium text-slate-700 transition-colors" %>
      </div>
    </div>
  </div>
</div>
