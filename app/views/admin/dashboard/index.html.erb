<div class="max-w-7xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Admin Dashboard</h1>
    <p class="text-gray-600 mt-2">Welcome to the in-house admin interface</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Academic Resources -->
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <div class="flex items-center mb-4">
        <%= lucide_icon("graduation-cap", class: "text-blue-600 w-6 h-6 mr-3 shrink-0") %>
        <h2 class="text-lg font-semibold text-gray-900">Academic</h2>
      </div>
      <ul class="space-y-2 text-sm">
        <li>
          <%= link_to admin_classrooms_path, class: "text-blue-600 hover:text-blue-800 hover:underline" do %>
            <%= lucide_icon("presentation", class: "w-4 mr-2 h-4 shrink-0") %>Classrooms
          <% end %>
        </li>
        <li>
          <%= link_to admin_schools_path, class: "text-blue-600 hover:text-blue-800 hover:underline" do %>
            <%= lucide_icon("school", class: "w-4 mr-2 h-4 shrink-0") %>Schools
          <% end %>
        </li>
        <li>
          <%= link_to admin_school_years_path, class: "text-blue-600 hover:text-blue-800 hover:underline" do %>
            <%= lucide_icon("calendar-check", class: "w-4 mr-2 h-4 shrink-0") %>School Years
          <% end %>
        </li>
      </ul>
    </div>

    <!-- User Management -->
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <div class="flex items-center mb-4">
        <%= lucide_icon("users", class: "text-green-600 w-6 h-6 mr-3 shrink-0") %>
        <h2 class="text-lg font-semibold text-gray-900">User Management</h2>
      </div>
      <ul class="space-y-2 text-sm">
        <li>
          <%= link_to admin_students_path, class: "text-blue-600 hover:text-blue-800 hover:underline" do %>
            <%= lucide_icon("graduation-cap", class: "w-4 mr-2 h-4 shrink-0") %>Students
          <% end %>
        </li>
        <li>
          <%= link_to admin_teachers_path, class: "text-blue-600 hover:text-blue-800 hover:underline" do %>
            <%= lucide_icon("presentation", class: "w-4 mr-2 h-4 shrink-0") %>Teachers
          <% end %>
        </li>
        <li>
          <%= link_to admin_users_path, class: "text-blue-600 hover:text-blue-800 hover:underline" do %>
            <%= lucide_icon("users", class: "w-4 mr-2 h-4 shrink-0") %>Users
          <% end %>
        </li>
      </ul>
    </div>

    <!-- Portfolio & Finance -->
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <div class="flex items-center mb-4">
        <%= lucide_icon("chart-line", class: "text-purple-600 w-6 h-6 mr-3 shrink-0") %>
        <h2 class="text-lg font-semibold text-gray-900">Portfolio & Finance</h2>
      </div>
      <ul class="space-y-2 text-sm">
        <li>
          <%= link_to admin_stocks_path, class: "text-blue-600 hover:text-blue-800 hover:underline" do %>
            <%= lucide_icon("chart-line", class: "w-4 mr-2 h-4 shrink-0") %>Stocks
          <% end %>
        </li>
        <li class="text-gray-600"><%= lucide_icon("arrow-left-right", class: "w-4 mr-2 h-4 shrink-0") %>Portfolio Transactions</li>
      </ul>
    </div>

    <!-- Content -->
    <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
      <div class="flex items-center mb-4">
        <%= lucide_icon("megaphone", class: "text-orange-600 w-6 h-6 mr-3 shrink-0") %>
        <h2 class="text-lg font-semibold text-gray-900">Content</h2>
      </div>
      <ul class="space-y-2 text-sm">
        <li>
          <%= link_to admin_announcements_path, class: "text-blue-600 hover:text-blue-800 hover:underline" do %>
            <%= lucide_icon("megaphone", class: "w-4 mr-2 h-4 shrink-0") %>Announcements
          <% end %>
        </li>
      </ul>
    </div>
  </div>

  <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
    <div class="flex items-start">
      <%= lucide_icon("triangle-alert", class: "text-yellow-600 mt-1 mr-3 w-4 h-4 shrink-0") %>
      <div>
        <h3 class="font-semibold text-yellow-900 mb-1">Development Status</h3>
        <p class="text-sm text-yellow-800">
          Resource pages are being built incrementally. Use the sidebar navigation to access completed resources.
          Links marked with "#" are not yet implemented.
        </p>
      </div>
    </div>
  </div>
</div>
