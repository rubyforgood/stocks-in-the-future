<%# A teacher's lifecycle actions, in the page header.

    Extracted so the record page's `actions:` local stays one line - and because the set is conditional, which
    is not something to inline inside a `capture` block. **No "Edit" here:** the record's page edits in place,
    so a control that navigates to the page you are on has nothing to do. %>
<% if teacher.discarded? %>
  <%= link_to admin_teacher_reactivation_path(teacher),
              data: { turbo_method: :post, turbo_confirm: teacher_reactivate_confirm(teacher) },
              class: admin_secondary_button_class do %>
    <%= lucide_icon("user-check", class: "h-5 w-5 shrink-0 text-slate-500") %>
    Reactivate
  <% end %>

  <%= link_to admin_teacher_path(teacher),
              data: { turbo_method: :delete, turbo_confirm: teacher_delete_confirm(teacher) },
              class: admin_danger_button_class do %>
    <%= lucide_icon("trash-2", class: "h-5 w-5 shrink-0") %>
    Permanently delete
  <% end %>
<% else %>
  <%= link_to admin_teacher_deactivation_path(teacher),
              data: { turbo_method: :post, turbo_confirm: teacher_deactivate_confirm(teacher) },
              class: admin_danger_button_class do %>
    <%# `user-x`, not `trash-2`. This wore the delete glyph on the same page as a real "Permanently
        delete" wearing it too, so one icon meant both "reversible, they keep everything" and "gone". %>
    <%= lucide_icon("user-x", class: "h-5 w-5 shrink-0") %>
    Deactivate
  <% end %>
<% end %>
