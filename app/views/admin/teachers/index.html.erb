<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "Teachers" } do %>
    <%= link_to "New teacher", new_admin_teacher_path, class: admin_primary_button_class %>
  <% end %>

  <%= render "admin/shared/discard_filter_tabs",
             current: current_discard_filter,
             tabs: [["Active", :active, admin_teachers_path],
                    ["Deactivated", :discarded, admin_teachers_path(discarded: true)],
                    ["All", :all, admin_teachers_path(all: true)]] %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr class="table-header-row">
            <%# **Name leads, and there is no Username column.** `Teacher#sync_username_from_email` sets
                `username = email` before every validation, so those two columns printed the same string
                twice - 108px of duplication in a 718px scroller. The name is what a person scans a staff
                list for, and it is what the record page is titled with. %>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:name, "Name") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              <%= sort_link(:email, "Email") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              Status
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right table-actions-cell hidden lg:table-cell">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <% if @teachers.any? %>
            <% @teachers.each do |teacher| %>
              <tr class="table-body-row" id="<%= dom_id(teacher) %>">
                <% email_cell = capture do %>
                  <%= teacher.email %>
                <% end %>
                <% status_cell = capture do %>
                  <%= render "components/ui/badge",
                             label: teacher.discarded? ? "Deactivated" : "Active",
                             tone: teacher.discarded? ? :danger : :success %>
                <% end %>
                <% row_actions = capture do %>
                    <%= ghost_action_link "Edit", edit_admin_teacher_path(teacher), icon: "pencil" %>
                    <% if teacher.discarded? %>
                      <%= ghost_action_link "Reactivate", admin_teacher_reactivation_path(teacher),
                                            icon: "circle-check",
                                            data: { turbo_method: :post,
                                                    turbo_confirm: teacher_reactivate_confirm(teacher) } %>
                    <% else %>
                      <%= ghost_action_link "Deactivate", admin_teacher_deactivation_path(teacher),
                                            icon: "ban", variant: :danger,
                                            data: { turbo_method: :post,
                                                    turbo_confirm: teacher_deactivate_confirm(teacher) } %>
                    <% end %>
                <% end %>

                <td class="table-body-cell">
                  <%# `display_name`, so a teacher with no name yet still has a link to click - it falls back
                      to the username, which for a teacher is their email. %>
                  <%= link_to teacher.display_name, admin_teacher_path(teacher), class: "tw-link" %>

                  <%= render "shared/stacked_row_fields",
                             fields: [["Email", email_cell], ["Status", status_cell]],
                             actions: row_actions %>
                </td>
                <%# No `whitespace-nowrap`, and `break-words`: an email is one unbreakable token, so a long
                    one sets the column's minimum width and pushed the actions off screen. Allowed to break,
                    the column can shrink and the row grows by a line instead. %>
                <td class="table-body-cell wrap-anywhere hidden lg:table-cell">
                  <%= email_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= status_cell %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap table-actions-cell hidden lg:table-cell">
                  <div class="flex items-center justify-end gap-1"><%= row_actions %></div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%# The Archived tab needs its own sentence: with nothing archived this said "No teachers yet" and
                offered a New button, on a list of archived records. %>
            <% if current_discard_filter == :discarded %>
              <%= render "admin/shared/empty_row",
                         colspan: 4,
                         **archived_empty_state("teacher") %>
            <% else %>
              <%= render "admin/shared/empty_row",
                         colspan: 4,
                         title: "No teachers yet",
                         body: "Teachers manage classrooms and enter grades for their students.",
                         action_label: "New teacher",
                         action_path: new_admin_teacher_path %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
