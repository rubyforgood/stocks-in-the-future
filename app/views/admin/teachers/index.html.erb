<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "Teachers" } do %>
    <%= link_to "New teacher", new_admin_teacher_path, class: admin_primary_button_class %>
  <% end %>

  <%= render "admin/shared/discard_filter_tabs",
             current: current_discard_filter,
             tabs: [["Active", :active, admin_teachers_path],
                    ["Deactivated", :discarded, admin_teachers_path(discarded: true)],
                    ["All", :all, admin_teachers_path(all: true)]] %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-300">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:id, "ID") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:username, "Username") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:email, "Email") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:name, "Name") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:created_at, "Created at") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              Status
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @teachers.any? %>
            <% @teachers.each do |teacher| %>
              <tr id="<%= dom_id(teacher) %>" class="hover:bg-slate-50 transition-colors">
                <td class="table-body-cell whitespace-nowrap">
                  <%= teacher.id %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= teacher.username %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= teacher.email %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= teacher.name %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= teacher.created_at.strftime("%B %d, %Y") %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= render "components/ui/badge",
                             label: teacher.discarded? ? "Deactivated" : "Active",
                             tone: teacher.discarded? ? :danger : :success %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap">
                  <div class="flex items-center justify-end gap-1">
                    <%= ghost_action_link "View", admin_teacher_path(teacher), icon: "eye" %>
                    <%= ghost_action_link "Edit", edit_admin_teacher_path(teacher), icon: "pencil" %>
                    <% if teacher.discarded? %>
                      <%= ghost_action_link "Reactivate", admin_teacher_reactivation_path(teacher),
                                            icon: "circle-check",
                                            data: { turbo_method: :post, turbo_confirm: "Reactivate #{teacher.display_name}?" } %>
                    <% else %>
                      <%= ghost_action_link "Deactivate", admin_teacher_deactivation_path(teacher),
                                            icon: "ban", variant: :danger,
                                            data: { turbo_method: :post, turbo_confirm: "Deactivate #{teacher.display_name}? They will lose access, but their data is preserved." } %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "admin/shared/empty_row",
                       colspan: 7,
                       title: "No teachers yet",
                       body: "Teachers manage classrooms and enter grades for their students.",
                       action_label: "New teacher",
                       action_path: new_admin_teacher_path %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
