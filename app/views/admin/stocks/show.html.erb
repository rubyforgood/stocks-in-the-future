<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: @stock.ticker } do %>
    <%= render "admin/shared/show_actions",
               record: @stock,
               edit_path: edit_admin_stock_path(@stock),
               delete_path: admin_stock_path(@stock) %>
  <% end %>

  <%# Each block was a mt-6 pt-6 border-t section inside one big card. They are cards
      now, so the rules go and each section carries its own h2. %>
  <div class="space-y-6">
    <%= admin_show_attributes(
          @stock,
          attributes: %i[id ticker company_name company_website stock_exchange archived created_at updated_at]
        ) %>

    <% if @stock.description.present? %>
      <%= render layout: "components/ui/card", locals: { title: "Description" } do %>
        <p class="text-sm text-slate-900 whitespace-pre-wrap"><%= @stock.description %></p>
      <% end %>
    <% end %>

    <%= render layout: "components/ui/card", locals: { title: "Price information" } do %>
      <dl class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <div>
          <dt class="text-sm font-medium text-slate-700">Current price</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= number_to_currency(@stock.current_price) %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-700">Yesterday's price</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= number_to_currency(@stock.yesterday_price) %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-700">Percentage change</dt>
          <dd class="mt-1 text-sm">
            <span class="<%= @stock.percentage_change.positive? ? 'text-green-700' : 'text-red-700' %>">
              <%= @stock.percentage_change_formatted %>
            </span>
          </dd>
        </div>
      </dl>
    <% end %>

    <%= render layout: "components/ui/card", locals: { title: "Company information" } do %>
      <dl class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-slate-700">Employees</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @stock.employees || "—" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-700">Industry</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @stock.industry || "—" %></dd>
        </div>
      </dl>
    <% end %>

    <%= render layout: "components/ui/card", locals: { title: "Financial metrics" } do %>
      <dl class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <% { "Cash flow" => @stock.cash_flow, "Debt" => @stock.debt,
             "Debt to equity" => @stock.debt_to_equity, "Profit margin" => @stock.profit_margin,
             "Sales growth" => @stock.sales_growth }.each do |term, value| %>
          <div>
            <dt class="text-sm font-medium text-slate-700"><%= term %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= value || "—" %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <%= render layout: "components/ui/card", locals: { title: "Industry averages" } do %>
      <dl class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <% { "Avg debt to equity" => @stock.industry_avg_debt_to_equity,
             "Avg profit margin" => @stock.industry_avg_profit_margin,
             "Avg sales growth" => @stock.industry_avg_sales_growth }.each do |term, value| %>
          <div>
            <dt class="text-sm font-medium text-slate-700"><%= term %></dt>
            <dd class="mt-1 text-sm text-slate-900"><%= value || "—" %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <% if @stock.management.present? %>
      <%= render layout: "components/ui/card", locals: { title: "Management" } do %>
        <p class="text-sm text-slate-900 whitespace-pre-wrap"><%= @stock.management %></p>
      <% end %>
    <% end %>

    <% if @stock.competitor_names.present? %>
      <%= render layout: "components/ui/card", locals: { title: "Competitor names" } do %>
        <p class="text-sm text-slate-900 whitespace-pre-wrap"><%= @stock.competitor_names %></p>
      <% end %>
    <% end %>

    <% if @stock.portfolio_stocks.any? %>
      <%= render layout: "components/ui/card",
                 locals: { title: "Portfolio stocks (#{@stock.portfolio_stocks.count})" } do %>
        <p class="text-sm text-slate-600">
          This stock is held in <%= pluralize(@stock.portfolio_stocks.count, "portfolio") %>.
        </p>
      <% end %>
    <% end %>
  </div>
</div>
