<%= form_with model: portfolio_transaction, url: portfolio_transaction.persisted? ? admin_portfolio_transaction_path(portfolio_transaction) : admin_portfolio_transactions_path, builder: Ui::FormBuilder, class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", record: portfolio_transaction, subject: "transaction" %>

  <%# `components/ui/_card`, and no heading of its own.

      The surface was hand-rolled in ten form partials - `<div class="tw-card"><div class="p-5">` - so it
      was declared eleven times, which is the mechanism that produced four different padding values before
      anyone noticed. And each opened with an `h3` naming the record type, under a page header that had
      just named it: "Teacher details" below "Edit teacher", 24px apart, in two sizes. Polaris drops a
      card's header when the page has one card. A heading returns the moment a form has two - see
      admin/students, where it separates them. %>
  <%= render layout: "components/ui/card", locals: {} do %>
    <div>
        <%= f.association_select :portfolio_id,
                                 collection: Portfolio.includes(:user).order("users.username"),
                                 label: "Portfolio",
                                 required: true,
                                 label_method: ->(portfolio) { "#{portfolio.user.username} (ID: #{portfolio.id})" },
                                 hint: "Select the portfolio for this transaction" %>

        <%= f.select :transaction_type,
                     PortfolioTransaction.transaction_types.keys.map { |type| [type.humanize, type] },
                     label: "Transaction type",
                     width: :half,
                     required: true,
                     hint: "Type of transaction (deposit, withdrawal, credit, debit, fee)",
                     include_blank: "Select transaction type..." %>

        <%= f.select :reason,
                     PortfolioTransaction.reasons.keys.map { |r| [r.humanize, r] },
                     label: "Reason",
                     width: :half,
                     hint: "Reason for this transaction (optional)",
                     include_blank: "Select reason..." %>

        <%= f.currency_field :amount_cents,
                             label: "Amount",
                             width: :half,
                             required: true,
                             hint: "Transaction amount in dollars",
                             multiplier: 0.01,
                             decimals: 2 %>

        <%= f.text_area :description,
                        label: "Description",
                        hint: "Optional description for this transaction",
                        rows: 4 %>
    </div>
    <% end %>

  <div class="tw-form-actions">
    <%= f.submit_button portfolio_transaction.persisted? ? "Update portfolio transaction" : "Create portfolio transaction" %>
    <%= f.cancel_button "Cancel", url: portfolio_transaction.persisted? ? admin_portfolio_transaction_path(portfolio_transaction) : admin_root_path %>
  </div>
<% end %>
