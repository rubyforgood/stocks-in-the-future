<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%# "Portfolio transaction" was Title Case. Sentence case per design.md. %>
  <%= render layout: "components/ui/page_header",
             locals: { title: "Portfolio transaction ##{@portfolio_transaction.id}" } do %>
    <%= render "admin/shared/show_actions",
               record: @portfolio_transaction,
               edit_path: edit_admin_portfolio_transaction_path(@portfolio_transaction),
               delete_path: admin_portfolio_transaction_path(@portfolio_transaction) %>
  <% end %>

  <%# dt labels are slate-700, matching admin/shared/_show_attributes: slate-500 read as
      muted metadata rather than as the key half of a key/value pair. %>
  <div class="space-y-6">
    <%= admin_show_attributes(
          @portfolio_transaction,
          attributes: %i[id created_at updated_at]
        ) %>

    <%= render layout: "components/ui/card", locals: { title: "Portfolio" } do %>
      <dl class="grid grid-cols-1 gap-4">
        <div>
          <dt class="text-sm font-medium text-slate-700">Portfolio ID</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @portfolio_transaction.portfolio_id %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-700">User</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @portfolio_transaction.portfolio.user.username %></dd>
        </div>
      </dl>
    <% end %>

    <%= render layout: "components/ui/card", locals: { title: "Transaction details" } do %>
      <dl class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-slate-700">Transaction type</dt>
          <dd class="mt-1 text-sm text-slate-900">
            <%= render "components/ui/badge",
                       label: @portfolio_transaction.transaction_type.humanize,
                       tone: @portfolio_transaction.deposit? ? :success : :neutral %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-700">Amount</dt>
          <dd class="mt-1 text-sm font-semibold text-slate-900">
            <%= number_to_currency(@portfolio_transaction.amount_cents / 100.0) %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-700">Reason</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @portfolio_transaction.reason&.humanize || "—" %></dd>
        </div>
      </dl>
    <% end %>

    <% if @portfolio_transaction.description.present? %>
      <%= render layout: "components/ui/card", locals: { title: "Description" } do %>
        <p class="text-sm text-slate-900 whitespace-pre-wrap"><%= @portfolio_transaction.description %></p>
      <% end %>
    <% end %>

    <% if @portfolio_transaction.order.present? %>
      <%= render layout: "components/ui/card", locals: { title: "Associated order" } do %>
        <p class="text-sm text-slate-900">Order #<%= @portfolio_transaction.order.id %></p>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to "Back", :back, class: admin_secondary_button_class %>
  </div>
</div>
