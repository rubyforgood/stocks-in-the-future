<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: @school.name } do %>
    <%= render "admin/shared/show_actions",
               record: @school,
               edit_path: edit_admin_school_path(@school),
               delete_path: admin_school_path(@school) %>
  <% end %>

  <div class="space-y-6">
    <%= admin_show_attributes(
          @school,
          attributes: %i[id name created_at updated_at]
        ) %>

    <%= render "school_years", school: @school, school_years: @school_years,
                               addable: @addable_years, manage: false %>

  </div>
</div>
