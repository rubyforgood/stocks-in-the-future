<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: @school.name } do %>
    <%= render "admin/shared/show_actions",
               record: @school,
               edit_path: edit_admin_school_path(@school),
               delete_path: admin_school_path(@school) %>
  <% end %>

  <div class="space-y-6">
    <%= admin_show_attributes(
          @school,
          attributes: %i[id name created_at updated_at]
        ) %>

    <%= render layout: "components/ui/card", locals: { title: "Associated years" } do %>
      <% if @school.years.any? %>
        <ul class="space-y-2">
          <% @school.years.each do |year| %>
            <li class="text-sm text-slate-900"><%= year.name %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-600">No years associated with this school yet.</p>
      <% end %>
    <% end %>
  </div>
</div>
