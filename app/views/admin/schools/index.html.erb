<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "Schools" } do %>
    <%= link_to "New school", new_admin_school_path, class: admin_primary_button_class %>
  <% end %>

  <%= admin_table(
        @schools,
        columns: [
          { attribute: :name, label: "Name", sortable: true },
          { attribute: :created_at, label: "Created", sortable: true }
        ],
        empty_message: "No schools found. Create your first school to get started."
      ) %>
</div>
