<%= form_with model: @school, url: @school.persisted? ? admin_school_path(@school) : admin_schools_path, builder: Ui::FormBuilder, class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", record: @school, subject: "school" %>

  <%# `components/ui/_card`, and no heading of its own.

      The surface was hand-rolled in ten form partials - `<div class="tw-card"><div class="p-5">` - so it
      was declared eleven times, which is the mechanism that produced four different padding values before
      anyone noticed. And each opened with an `h3` naming the record type, under a page header that had
      just named it: "Teacher details" below "Edit teacher", 24px apart, in two sizes. Polaris drops a
      card's header when the page has one card. A heading returns the moment a form has two - see
      admin/students, where it separates them. %>
  <%= render layout: "components/ui/card", locals: {} do %>
      <%= f.text_field :name,
                       label: "Name",
                       hint: "Enter the school name",
                       placeholder: "Lincoln elementary school" %>

      <%# **No years here.** They were a `collection_check_boxes` on `year_ids`, and that was two defects
          rather than a layout problem: unchecking a box silently destroyed a school year and its four
          quarters, and doing it to a year with a classroom raised `PG::ForeignKeyViolation` - a 500 - because
          the join went before `restrict_with_error` could speak.

          A year is provisioned, not preferred, so it is a list with an explicit add and remove on the
          school's own page. That is also what the field does rather than a multi-select: GOV.UK advises
          against `select multiple` outright, and Polaris, Material and Carbon ship none. %>
  <% end %>

  <div class="tw-form-actions">
    <%# PREVIEW: on a detail page the submit names what it saves, and there is nothing to cancel *to* -
        you are already on the record. On `new` it still needs both. %>
    <% if @school.persisted? %>
      <%= f.submit_button "Save details" %>
    <% else %>
      <%= f.submit_button "Create school" %>
      <%= f.cancel_button "Cancel", url: admin_schools_path %>
    <% end %>
  </div>
<% end %>
