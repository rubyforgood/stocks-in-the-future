<%= form_with model: @school, url: @school.persisted? ? admin_school_path(@school) : admin_schools_path, builder: Ui::FormBuilder, class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", record: @school, subject: "school" %>

  <%# `components/ui/_card`, and no heading of its own.

      The surface was hand-rolled in ten form partials - `<div class="tw-card"><div class="p-5">` - so it
      was declared eleven times, which is the mechanism that produced four different padding values before
      anyone noticed. And each opened with an `h3` naming the record type, under a page header that had
      just named it: "Teacher details" below "Edit teacher", 24px apart, in two sizes. Polaris drops a
      card's header when the page has one card. A heading returns the moment a form has two - see
      admin/students, where it separates them. %>
  <%= render layout: "components/ui/card", locals: {} do %>
      <%= f.text_field :name,
                       label: "Name",
                       hint: "Enter the school name",
                       placeholder: "Lincoln elementary school" %>

      <%# Three columns from `lg`, one below. Fourteen years in a single column measured 608px and put the
          submit at y=1094 in a 625px viewport; three columns is 212px. The labels are short and uniform,
          which is the shape GOV.UK and Polaris both allow a multi-column group for.

          The current school year is marked, because the list is ordered newest-first and "newest" is not
          the one anybody wants - it is the one in progress. A callable `text_method`, which the builder
          already supports, so the badge is part of the option rather than a second list beside it. %>
      <%= f.collection_check_boxes :year_ids, @years, :id,
                                   ->(year) { year_option_label(year) },
                                   label: "Years",
                                   hint: "Select the school years this school will be active",
                                   columns: 3 %>
  <% end %>

  <div class="tw-form-actions">
    <%= f.submit_button @school.persisted? ? "Update school" : "Create school" %>
    <%= f.cancel_button "Cancel", url: @school.persisted? ? admin_school_path(@school) : admin_schools_path %>
  </div>
<% end %>
