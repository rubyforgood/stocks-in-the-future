<%= form_with model: @school, url: @school.persisted? ? admin_school_path(@school) : admin_schools_path, builder: Admin::FormBuilder, class: "space-y-6" do |f| %>
  <div class="tw-card">
    <div class="px-6 py-6">
      <h3 class="text-lg font-medium text-slate-900 mb-6">School details</h3>

      <%= f.text_field :name,
                       label: "Name",
                       hint: "Enter the school name",
                       placeholder: "Lincoln elementary school" %>

      <%= f.collection_check_boxes :year_ids, @years, :id, :name,
                                   label: "Years",
                                   hint: "Select the school years this school will be active" %>
    </div>
  </div>

  <div class="flex items-center justify-end gap-x-4">
    <%= f.cancel_button "Cancel", url: @school.persisted? ? admin_school_path(@school) : admin_schools_path %>
    <%= f.submit_button @school.persisted? ? "Update school" : "Create school" %>
  </div>
<% end %>
