<%= render layout: "admin/shared/record_page",
           locals: { title: @school_year.name, breadcrumbs: @breadcrumbs,
                     description: school_year_summary(@school_year),
                     actions: capture do
                       link_to "Delete school year", admin_school_year_path(@school_year),
                               data: { turbo_method: :delete,
                                       turbo_confirm: school_year_delete_confirm(@school_year) },
                               class: admin_danger_button_class
                     end } do %>
  <%# **No "Quarters" card.** A school year always has exactly four - they come from
      `SchoolYear#create_quarters`, nothing else makes one, and there are no quarter routes - so listing them
      was an invariant rendered as data. The count is in the summary line, where it is context rather than a
      list you could act on. %>
  <%= render layout: "admin/shared/record_section",
             locals: { title: "Details" } do %>
    <%= render "form" %>
  <% end %>

  <%# A collection worth scanning: which classrooms run in this year.
      **The section says it is read-only, because the page around it is not.** Details above is a live form,
      so a list under it reads as another thing you can change here - and the only clue that it was not was
      this comment, which nobody browsing the page can see. Each name is a link to the classroom's own page,
      which is where it is edited; a new one comes from the Classrooms screen, where it needs its grades and
      teachers too. %>
  <%= render layout: "admin/shared/record_section",
             locals: { title: "Classrooms",
                       hint: "Open one to edit it. New classrooms are added from the Classrooms " \
                             "screen, where they also need their grades and teachers." } do %>
    <%= render layout: "components/ui/card", locals: {} do %>
      <% if @school_year.classrooms.any? %>
        <ul class="divide-y divide-slate-100">
          <% @school_year.classrooms.each do |classroom| %>
            <li class="py-2 text-sm">
              <%= link_to classroom.name, admin_classroom_path(classroom), class: "tw-link" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-600">No classrooms in this school year yet.</p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
