<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header",
             locals: { title: "#{@school_year.school_name} (#{@school_year.year_name})" } do %>
    <%= render "admin/shared/show_actions",
               record: @school_year,
               edit_path: edit_admin_school_year_path(@school_year),
               delete_path: admin_school_year_path(@school_year) %>
  <% end %>

  <div class="space-y-6">
    <%= admin_show_attributes(
          @school_year,
          attributes: %i[school_name year_name]
        ) %>

    <%= render layout: "components/ui/card",
               locals: { title: "Classrooms (#{@school_year.classrooms.count})" } do %>
      <% if @school_year.classrooms.any? %>
        <ul class="space-y-2">
          <% @school_year.classrooms.limit(10).each do |classroom| %>
            <li class="text-sm text-slate-900"><%= classroom.name %></li>
          <% end %>
          <% if @school_year.classrooms.count > 10 %>
            <li class="text-sm text-slate-600">
              ... and <%= @school_year.classrooms.count - 10 %> more
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-600">No classrooms associated with this school year yet.</p>
      <% end %>
    <% end %>

    <% if @school_year.quarters.any? %>
      <%= render layout: "components/ui/card", locals: { title: "Quarters" } do %>
        <ul class="space-y-2">
          <% @school_year.quarters.order(:number).each do |quarter| %>
            <li class="text-sm text-slate-900"><%= quarter.name %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
