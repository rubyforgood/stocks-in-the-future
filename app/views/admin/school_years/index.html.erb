<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "School years" } do %>
    <%= link_to "New school year", new_admin_school_year_path, class: admin_primary_button_class %>
  <% end %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr class="table-header-row">
            <th scope="col" class="table-header-cell table-header-cell-left">
              School
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              Year
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              <%= sort_link(:created_at, "Created at") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right table-actions-cell hidden lg:table-cell">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <% if @school_years.any? %>
            <% @school_years.each do |school_year| %>
              <tr class="table-body-row cursor-pointer"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= admin_school_year_path(school_year) %>"
                  data-action="click->clickable-row#navigate">
                <% year_cell = capture do %>
                  <%= school_year.year_name %>
                <% end %>
                <% created_at_cell = capture do %>
                  <%= school_year.created_at.strftime("%B %d, %Y") %>
                <% end %>
                <% row_actions = capture do %>
                    <%= ghost_action_link action_label("Delete", school_year), admin_school_year_path(school_year),
                                          icon: "trash-2", variant: :danger,
                                          data: { turbo_method: :delete,
                                                  turbo_confirm: school_year_delete_confirm(school_year) } %>
                <% end %>

                <td class="table-body-cell">
                  <%= link_to school_year.school_name, admin_school_year_path(school_year), class: "tw-link" %>

                  <%= render "components/ui/stacked_row_fields",
                             fields: [["Year", year_cell], ["Created at", created_at_cell]],
                             actions: row_actions %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= year_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= created_at_cell %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap table-actions-cell hidden lg:table-cell">
                  <div class="flex items-center justify-end gap-1"><%= row_actions %></div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "admin/shared/empty_row",
                       colspan: 4,
                       icon: "calendar-check",
                       title: "No school years yet",
                       body: "A school year holds the quarters that earnings are calculated " \
                             "against. School years you add appear here." %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
