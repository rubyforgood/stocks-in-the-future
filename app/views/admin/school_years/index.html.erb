<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "School years" } do %>
    <%= link_to "New school year", new_admin_school_year_path, class: admin_primary_button_class %>
  <% end %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-300">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:id, "ID") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              School
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              Year
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:created_at, "Created at") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @school_years.any? %>
            <% @school_years.each do |school_year| %>
              <tr class="hover:bg-slate-50 transition-colors cursor-pointer"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= admin_school_year_path(school_year) %>"
                  data-action="click->clickable-row#navigate">
                <td class="table-body-cell whitespace-nowrap">
                  <%= school_year.id %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= school_year.school_name %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= school_year.year_name %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= school_year.created_at.strftime("%B %d, %Y") %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap">
                  <div class="flex justify-end gap-2">
                    <%= link_to "View", admin_school_year_path(school_year), class: "tw-link" %>
                    <%= link_to "Edit", edit_admin_school_year_path(school_year), class: "text-slate-600 hover:text-slate-800" %>
                    <%= link_to "Delete", admin_school_year_path(school_year),
                                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                                class: "text-red-600 hover:text-red-800" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "admin/shared/empty_row",
                       colspan: 5,
                       title: "No school years yet",
                       body: "A school year holds the quarters that earnings are calculated against.",
                       action_label: "New school year",
                       action_path: new_admin_school_year_path %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
