<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: @user.username } do %>
    <%= render "admin/shared/show_actions",
               record: @user,
               edit_path: edit_admin_user_path(@user),
               delete_path: admin_user_path(@user) %>
  <% end %>

  <div class="space-y-6">
    <%= admin_show_attributes(
          @user,
          attributes: %i[id username type email admin classroom created_at updated_at]
        ) %>

    <%= render layout: "components/ui/card", locals: { title: "Portfolio" } do %>
      <% if @user.portfolio.present? %>
        <div class="text-sm text-slate-900">
          Portfolio ID: <%= @user.portfolio.id %>
          <% if @user.student? %>
            <%= link_to "View portfolio", user_portfolio_path(@user, @user.portfolio),
                        class: "ml-2 tw-link" %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-600">No portfolio associated with this user.</p>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to "Back to users", admin_users_path, class: admin_secondary_button_class %>
  </div>
</div>
