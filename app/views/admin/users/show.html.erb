<%= render layout: "admin/shared/record_page",
           locals: { title: @user.username, breadcrumbs: @breadcrumbs,
                     description: user_summary(@user),
                     badge: user_status_badge(@user),
                     actions: capture do
                       link_to "Delete user", admin_user_path(@user),
                               data: { turbo_method: :delete, turbo_confirm: delete_confirm(@user) },
                               class: admin_danger_button_class
                     end } do %>
  <%# Details first here, and last on a page with a collection: this record has no collection to lead with. %>
  <%= render layout: "admin/shared/record_section", locals: { title: "Details" } do %>
    <%= render "form" %>
  <% end %>

  <%= render layout: "admin/shared/record_section", locals: { title: "Portfolio" } do %>
    <%= render layout: "components/ui/card", locals: {} do %>
      <% if @user.portfolio.present? %>
        <p class="text-sm text-slate-900">
          <% if @user.student? %>
            <%= link_to "View portfolio", user_portfolio_path(@user, @user.portfolio), class: "tw-link" %>
          <% else %>
            This user has a portfolio.
          <% end %>
        </p>
      <% else %>
        <p class="text-sm text-slate-600">No portfolio associated with this user.</p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
