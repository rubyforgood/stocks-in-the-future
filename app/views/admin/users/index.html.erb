<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header",
             locals: { title: "Users",
                       description: "Every account in the app, including the students and teachers " \
                                    "with their own pages in the sidebar." } do %>
    <%= link_to "New user", new_admin_user_path, class: admin_primary_button_class %>
  <% end %>

  <%= render "admin/shared/discard_filter_tabs",
             current: discard_filter,
             tabs: [["Active", :active, admin_users_path],
                    ["Archived", :discarded, admin_users_path(discarded: true)],
                    ["All", :all, admin_users_path(all: true)]] %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr class="table-header-row">
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:username, "Username") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              <%= sort_link(:type, "Type") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              <%= sort_link(:email, "Email") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              Classroom
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right table-actions-cell hidden lg:table-cell">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <% if @users.any? %>
            <% @users.each do |user| %>
              <tr class="table-body-row cursor-pointer"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= user_show_path(user) %>"
                  data-action="click->clickable-row#navigate">
                <%# The role, not the STI class name. An admin is `type: "User"` with `admin: true`, so this
                    column read "User" for the one account that can do everything, while the Admin column
                    beside it carried the actual answer in a yes/no badge. `account_role_label` is the helper
                    the account menu uses, so a role reads the same wherever it appears. %>
                <% type_cell = capture do %>
                  <%= account_role_label(user) %>
                <% end %>
                <% email_cell = capture do %>
                  <%= user.email.presence || content_tag(:span, "—", class: "text-slate-600") %>
                <% end %>
                <% classroom_cell = capture do %>
                  <%= user.classroom&.name || content_tag(:span, "—", class: "text-slate-600") %>
                <% end %>
                <% row_actions = capture do %>
                    <%# "Archive", not "Delete", because that is what happens: the controller discards,
                        and `User#destroy` raises rather than hard-delete a person. The old label and its
                        "This cannot be undone" were both false - and the same string on the students
                        list already reads "They will lose access, but their data is preserved". %>
                    <%# Restore on a discarded row, Archive on a live one - never both, and never neither.
                      There was no Restore at all: `admin/students#restore` and the teachers'
                      reactivation cover the two subclasses, so a user who is neither had no way back,
                      and the discard is reversible in the data and was irreversible only here. %>
                  <% if user.discarded? %>
                    <%= ghost_action_link action_label("Restore", user), restore_admin_user_path(user),
                                          icon: "rotate-ccw",
                                          data: { turbo_method: :patch,
                                                  turbo_confirm: "Restore #{user.username}?\n\n" \
                                                                 "They can sign in again and reappear " \
                                                                 "in the lists they belong to." } %>
                  <% else %>
                    <%= ghost_action_link action_label("Archive", user), admin_user_path(user),
                                          icon: "archive", variant: :danger,
                                          data: { turbo_method: :delete,
                                                  turbo_confirm: "Archive #{user.username}?\n\n" \
                                                                 "They lose access immediately and " \
                                                                 "leave this list. Nothing is deleted: " \
                                                                 "the account and everything attached " \
                                                                 "to it are kept." } %>
                  <% end %>
                <% end %>

                <%# `break-words` here too, and for a reason particular to this table: a **teacher's** username
                    *is* their email - `Teacher#sync_username_from_email` - so this column holds an
                    unbreakable 192px token on any list that includes staff. Allowed to break it shrinks and
                    the row actions stay on screen at 1024px. %>
                <td class="table-body-cell wrap-anywhere">
                  <%= link_to user.username, admin_user_path(user), class: "tw-link" %>

                  <%= render "shared/stacked_row_fields",
                             fields: [["Type", type_cell], ["Email", email_cell], ["Classroom", classroom_cell]],
                             actions: row_actions %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= type_cell %>
                </td>
                <%# No `whitespace-nowrap`, and `break-words`: an email is one unbreakable token, so a long
                    one sets this column's minimum width - which is what pushed the row actions off screen at
                    1024px. Nothing is truncated; the row grows by a line when it has to. %>
                <td class="table-body-cell wrap-anywhere hidden lg:table-cell">
                  <%= email_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= classroom_cell %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap table-actions-cell hidden lg:table-cell">
                  <div class="flex items-center justify-end gap-1"><%= row_actions %></div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%# One sentence, because only one is reachable. The viewer is a `User` and is not discarded, so
                the Active and All tabs always contain at least the admin reading the page - this index has no
                search and no pagination, so nothing else can empty them. The "No users yet" branch that used
                to sit here could not render, and offered a New button for a state the app cannot be in.

                Every other index keeps both branches, because a school or a stock list genuinely can be
                empty. This one is the exception and this is why. %>
            <%= render "admin/shared/empty_row", colspan: 5, **archived_empty_state("user") %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
