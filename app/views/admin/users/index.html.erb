<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "Users" } do %>
    <%= link_to "New user", new_admin_user_path, class: admin_primary_button_class %>
  <% end %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-300">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">
              <%= sort_link(:id, "ID") %>
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">
              <%= sort_link(:username, "Username") %>
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">
              <%= sort_link(:type, "Type") %>
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">
              <%= sort_link(:email, "Email") %>
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">
              Classroom
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">
              <%= sort_link(:admin, "Admin") %>
            </th>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 lg:pr-6">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @users.any? %>
            <% @users.each do |user| %>
              <tr class="hover:bg-slate-50 transition-colors cursor-pointer"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= user_show_path(user) %>"
                  data-action="click->clickable-row#navigate">
                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900">
                  <%= user.id %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900">
                  <%= user.username %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900">
                  <%= user.type %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900">
                  <%= user.email.presence || content_tag(:span, "—", class: "text-slate-500") %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900">
                  <%= user.classroom&.name || content_tag(:span, "—", class: "text-slate-500") %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900">
                  <%= render "components/ui/badge",
                             label: user.admin? ? "Yes" : "No",
                             tone: user.admin? ? :success : :neutral %>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium lg:pr-6">
                  <div class="flex justify-end gap-2">
                    <%= link_to "View", user_show_path(user), class: "tw-link" %>
                    <%= link_to "Edit", edit_admin_user_path(user), class: "text-slate-600 hover:text-slate-800" %>
                    <%= link_to "Delete", admin_user_path(user),
                                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                                class: "text-red-600 hover:text-red-800" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "admin/shared/empty_row",
                       colspan: 7,
                       title: "No users yet",
                       body: "Users include admins, teachers and students across every school.",
                       action_label: "New user",
                       action_path: new_admin_user_path %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
