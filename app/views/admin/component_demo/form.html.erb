<% content_for :own_heading, true %>
<div class="max-w-7xl mx-auto">
  <!-- Page Header -->
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <div class="mb-6">
    <%= render layout: "components/ui/page_header",
               locals: { title: "Form builder demo" } do %><% end %>
    <p class="text-slate-600">Showcase of Admin::FormBuilder with all field types</p>
  </div>

  <!-- Alert Box -->
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
    <div class="flex items-start">
      <%= lucide_icon("info", class: "text-blue-600 mt-1 mr-3 w-4 h-4 shrink-0") %>
      <div>
        <h3 class="font-semibold text-blue-900 mb-1">Form builder features</h3>
        <p class="text-sm text-blue-800">
          This form builder provides consistent Tailwind styling, automatic error display,
          and support for all common field types including associations, currency fields, and rich text.
        </p>
      </div>
    </div>
  </div>

  <!-- Form Demo -->
  <div class="tw-card mb-6">
    <div class="px-6 py-6">
      <h2 class="text-xl font-semibold text-slate-900 mb-6">Sample form</h2>

      <%= form_with model: @user, url: "#", builder: Admin::FormBuilder, class: "space-y-6" do |f| %>
        <!-- Text Fields -->
        <div class="border-b border-slate-200 pb-6">
          <h3 class="text-lg font-medium text-slate-900 mb-4">Text fields</h3>

          <%= f.text_field :name,
                           label: "Full name",
                           hint: "Enter the user's full name" %>

          <%= f.email_field :email,
                            label: "Email address",
                            placeholder: "user@example.com" %>

          <%= f.password_field :password,
                               label: "Password",
                               hint: "Minimum 8 characters" %>
        </div>

        <!-- Number & Currency Fields -->
        <div class="border-b border-slate-200 pb-6">
          <h3 class="text-lg font-medium text-slate-900 mb-4">Number & currency fields</h3>

          <%= f.number_field :id,
                             label: "User ID",
                             hint: "Auto-generated unique identifier" %>

          <%= f.currency_field :id,
                               label: "Account balance",
                               multiplier: 0.01,
                               decimals: 2,
                               hint: "Currency field with $ prefix" %>
        </div>

        <!-- Text Area -->
        <div class="border-b border-slate-200 pb-6">
          <h3 class="text-lg font-medium text-slate-900 mb-4">Text area</h3>

          <%= f.text_area :email,
                          label: "Biography",
                          rows: 4,
                          hint: "Tell us about yourself" %>
        </div>

        <!-- Select Fields -->
        <div class="border-b border-slate-200 pb-6">
          <h3 class="text-lg font-medium text-slate-900 mb-4">Select fields</h3>

          <%= f.select_field :type,
                             label: "User type",
                             collection: [%w[Student Student], %w[Teacher Teacher], %w[User User]],
                             include_blank: "Select a type..." %>
        </div>

        <!-- Boolean Field -->
        <div class="border-b border-slate-200 pb-6">
          <h3 class="text-lg font-medium text-slate-900 mb-4">Boolean field</h3>

          <%= f.boolean_field :admin,
                              label: "Administrator",
                              hint: "Grant admin privileges to this user" %>
        </div>

        <!-- Date & DateTime Fields -->
        <div class="border-b border-slate-200 pb-6">
          <h3 class="text-lg font-medium text-slate-900 mb-4">Date & DateTime fields</h3>

          <%= f.date_field :created_at,
                           label: "Registration date" %>

          <%= f.datetime_field :updated_at,
                               label: "Last updated" %>
        </div>

        <!-- Read-only fields -->
        <div class="border-b border-slate-200 pb-6">
          <h3 class="text-lg font-medium text-slate-900 mb-4">Read-only fields</h3>

          <%= f.read_only_field :id,
                                label: "User ID (read-only)" %>

          <%= f.read_only_field :created_at,
                                label: "Member since" %>

          <%= f.read_only_field :admin,
                                label: "Administrator status" %>
        </div>

        <!-- Form Actions -->
        <div class="flex flex-wrap items-center gap-3 pt-4">
          <%= f.submit_button "Save changes" %>
          <%= f.cancel_button "Cancel", url: admin_component_demo_index_path %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Validation Error Demo -->
  <div class="tw-card mb-6">
    <div class="px-6 py-6">
      <h2 class="text-xl font-semibold text-slate-900 mb-4">Validation error display</h2>
      <p class="text-slate-600 mb-4">
        The form builder automatically displays validation errors inline with fields.
      </p>

      <%= link_to "Show form with errors",
                  form_admin_component_demo_index_path(show_errors: true),
                  class: "tw-btn-primary" %>
    </div>
  </div>

  <!-- Usage Examples -->
  <div class="tw-card mb-6">
    <div class="px-6 py-6">
      <h2 class="text-xl font-semibold text-slate-900 mb-4">Usage examples</h2>

      <div class="space-y-6">
        <div>
          <h3 class="text-sm font-semibold text-slate-900 mb-3">Basic form setup</h3>
          <pre class="text-xs bg-slate-50 p-4 rounded border border-slate-200 overflow-x-auto"><code>&lt;%= form_with model: @resource, builder: Admin::FormBuilder do |f| %>
  &lt;%= f.text_field :name, label: "Name", hint: "Enter the resource name" %>
  &lt;%= f.submit_button "Save" %>
&lt;% end %></code></pre>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-slate-900 mb-3">Currency field</h3>
          <pre class="text-xs bg-slate-50 p-4 rounded border border-slate-200 overflow-x-auto"><code>&lt;%= f.currency_field :amount_cents,
    multiplier: 0.01,
    decimals: 2,
    label: "Amount" %></code></pre>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-slate-900 mb-3">Association select</h3>
          <pre class="text-xs bg-slate-50 p-4 rounded border border-slate-200 overflow-x-auto"><code>&lt;%= f.association_select :classroom_id,
    collection: Classroom.all,
    label_method: :name,
    value_method: :id,
    include_blank: "Select a classroom..." %></code></pre>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-slate-900 mb-3">Boolean field</h3>
          <pre class="text-xs bg-slate-50 p-4 rounded border border-slate-200 overflow-x-auto"><code>&lt;%= f.boolean_field :active,
    label: "Active",
    hint: "Check to activate this resource" %></code></pre>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-slate-900 mb-3">Read-only field</h3>
          <pre class="text-xs bg-slate-50 p-4 rounded border border-slate-200 overflow-x-auto"><code>&lt;%= f.read_only_field :created_at,
    label: "Created at",
    value: @resource.created_at.strftime("%B %d, %Y") %></code></pre>
        </div>
      </div>
    </div>
  </div>

  <!-- Field Reference -->
  <div class="tw-card mb-6">
    <div class="px-6 py-6">
      <h2 class="text-xl font-semibold text-slate-900 mb-4">Available field types</h2>

      <div class="overflow-x-auto">
        <table class="table-base">
          <thead>
            <tr class="table-header-row">
              <th scope="col" class="table-header-cell table-header-cell-left">Method</th>
              <th scope="col" class="table-header-cell table-header-cell-left">Description</th>
              <th scope="col" class="table-header-cell table-header-cell-left">Options</th>
            </tr>
          </thead>
          <tbody>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">text_field</td>
              <td class="table-body-cell text-slate-700">Standard text input</td>
              <td class="table-body-cell text-slate-700">label, hint, placeholder</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">email_field</td>
              <td class="table-body-cell text-slate-700">Email input with validation</td>
              <td class="table-body-cell text-slate-700">label, hint, placeholder</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">password_field</td>
              <td class="table-body-cell text-slate-700">Password input (masked)</td>
              <td class="table-body-cell text-slate-700">label, hint</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">number_field</td>
              <td class="table-body-cell text-slate-700">Numeric input</td>
              <td class="table-body-cell text-slate-700">label, hint, step</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">currency_field</td>
              <td class="table-body-cell text-slate-700">Currency with $ prefix</td>
              <td class="table-body-cell text-slate-700">multiplier, decimals, label, hint</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">text_area</td>
              <td class="table-body-cell text-slate-700">Multi-line text input</td>
              <td class="table-body-cell text-slate-700">label, hint, rows</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">rich_text_area</td>
              <td class="table-body-cell text-slate-700">Rich text editor (Trix)</td>
              <td class="table-body-cell text-slate-700">label, hint</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">select_field</td>
              <td class="table-body-cell text-slate-700">Dropdown select</td>
              <td class="table-body-cell text-slate-700">collection, include_blank, label, hint</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">boolean_field</td>
              <td class="table-body-cell text-slate-700">Checkbox with label</td>
              <td class="table-body-cell text-slate-700">label, hint</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">date_field</td>
              <td class="table-body-cell text-slate-700">Date picker</td>
              <td class="table-body-cell text-slate-700">label, hint</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">datetime_field</td>
              <td class="table-body-cell text-slate-700">Date and time picker</td>
              <td class="table-body-cell text-slate-700">label, hint</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">association_select</td>
              <td class="table-body-cell text-slate-700">Association dropdown</td>
              <td class="table-body-cell text-slate-700">collection, label_method, value_method, include_blank</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">read_only_field</td>
              <td class="table-body-cell text-slate-700">Display-only field</td>
              <td class="table-body-cell text-slate-700">label, value, hint</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">submit_button</td>
              <td class="table-body-cell text-slate-700">Submit button (blue)</td>
              <td class="table-body-cell text-slate-700">text</td>
            </tr>
            <tr class="table-body-row">
              <td class="table-body-cell font-mono">cancel_button</td>
              <td class="table-body-cell text-slate-700">Cancel link (styled as button)</td>
              <td class="table-body-cell text-slate-700">text, url</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
