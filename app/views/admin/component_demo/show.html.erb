<% content_for :own_heading, true %>
<div class="mx-auto max-w-4xl">
  <%= render "admin/component_demo/environment_banner" %>

  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header",
             locals: { title: "User details" } do %><% end %>

  <%= admin_show_attributes(
        @user,
        attributes: %i[id email name type admin classroom_id created_at updated_at]
      ) %>

  <div class="mt-6">
    <%= admin_actions(
          @user,
          actions: %i[edit delete],
          # No "Back to list": the breadcrumb at the top of every admin page is the way back, and a
          # second one in the actions row is the same journey twice - which is also why the nine show
          # pages lost their footer button.
          custom_actions: []
        ) %>
  </div>
</div>
