<div class="max-w-4xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">User details</h1>
  </div>

  <%= admin_show_attributes(
        @user,
        attributes: %i[id email name type admin classroom_id created_at updated_at]
      ) %>

  <div class="mt-6">
    <%= admin_actions(
          @user,
          actions: %i[edit delete],
          custom_actions: [
            {
              label: "Back to list",
              path: admin_component_demo_index_path,
              icon: "arrow-left",
              class: "text-slate-700 bg-white hover:bg-slate-50 border-slate-300"
            }
          ]
        ) %>
  </div>
</div>
