<% content_for :own_heading, true %>
<div class="max-w-7xl mx-auto">
  <%= render layout: "components/ui/page_header",
             locals: { title: "Admin components demo",
                       description: "Showcase of all reusable admin components" } do %><% end %>

  <!-- Alert Box -->
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
    <div class="flex items-start">
      <%= lucide_icon("info", class: "text-blue-600 mt-1 mr-3 w-4 h-4 shrink-0") %>
      <div>
        <h3 class="font-semibold text-blue-900 mb-1">Component demo page</h3>
        <p class="text-sm text-blue-800">
          This page demonstrates all the reusable components created for the Admin V2 interface.
          These components will be used across all admin resource pages.
        </p>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="tw-card p-4 mb-6">
    <h3 class="text-sm font-semibold text-slate-900 mb-3">Component demos</h3>
    <div class="flex gap-3">
      <%= link_to form_admin_component_demo_index_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-sitf-primary hover:bg-sitf-primary-dark" do %>
        <%= lucide_icon("square-pen", class: "mr-2 w-4 h-4 shrink-0") %>
        Form builder demo
      <% end %>
    </div>
  </div>

  <!-- Breadcrumbs Demo -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Breadcrumbs component</h2>
    <%= admin_breadcrumbs(@breadcrumbs) %>
  </div>

  <hr class="my-8">

  <!-- Search/Filter Demo -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Search & filter component</h2>
    <%= admin_search_filter(
          filters: @filters,
          search_placeholder: "Search users..."
        ) %>
  </div>

  <hr class="my-8">

  <!-- Table Demo -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Table component</h2>
    <p class="text-slate-600 mb-4">
      Responsive table with sortable columns and empty states.
      Click column headers to sort. (Action buttons disabled in demo - see Action Buttons section below)
    </p>

    <%# No title or actions: the table card holds the table only, and a page title and
        its actions are rendered by components/ui/_page_header above the card. %>
    <%= admin_table(
          @users,
          columns: @columns,
          empty_message: "No users found. Create your first user to get started.",
          show_actions: false
        ) %>
  </div>

  <hr class="my-8">

  <!-- Show Attributes Demo -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Show attributes component</h2>
    <p class="text-slate-600 mb-4">Clean attribute display for show/detail pages.</p>

    <%= admin_show_attributes(
          @sample_user,
          attributes: %i[id email name type admin created_at updated_at]
        ) %>
  </div>

  <hr class="my-8">

  <!-- Action Buttons Demo -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Action buttons component</h2>
    <p class="text-slate-600 mb-4">Standard and custom action buttons with icons.</p>

    <div class="tw-card p-6">
      <h3 class="text-sm font-medium text-slate-900 mb-4">Standard actions (edit + delete)</h3>
      <div class="flex flex-wrap gap-3">
        <%= link_to "#", class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus-visible:ring-sitf-primary" do %>
          <%= lucide_icon("square-pen", class: "h-5 w-5 shrink-0 text-slate-500") %>
          Edit
        <% end %>
        <%= link_to "#", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus-visible:ring-red-700" do %>
          <%= lucide_icon("trash-2", class: "h-5 w-5 shrink-0 text-red-500") %>
          Delete
        <% end %>
      </div>

      <hr class="my-6">

      <h3 class="text-sm font-medium text-slate-900 mb-4">With custom actions</h3>
      <div class="flex flex-wrap gap-3">
        <%= link_to "#", class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus-visible:ring-sitf-primary" do %>
          <%= lucide_icon("square-pen", class: "h-5 w-5 shrink-0 text-slate-500") %>
          Edit
        <% end %>
        <%= link_to "#", class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-blue-700 bg-blue-50 hover:bg-blue-100 border-blue-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus-visible:ring-sitf-primary" do %>
          <%= lucide_icon("mail", class: "h-5 w-5 shrink-0") %>
          Send email
        <% end %>
        <%= link_to "#", data: { turbo_confirm: "Archive this user?" }, class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus-visible:ring-sitf-primary" do %>
          <%= lucide_icon("archive", class: "h-5 w-5 shrink-0") %>
          Archive
        <% end %>
      </div>
    </div>
  </div>

  <hr class="my-8">

  <!-- Boolean Badge Demo -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Boolean badges</h2>
    <div class="tw-card p-6">
      <div class="flex gap-4 items-center">
        <div>
          <span class="text-sm text-slate-600 mr-2">True:</span>
          <%= boolean_badge(true) %>
        </div>
        <div>
          <span class="text-sm text-slate-600 mr-2">False:</span>
          <%= boolean_badge(false) %>
        </div>
      </div>
    </div>
  </div>

  <hr class="my-8">

  <!-- Format Attribute Demo -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Attribute formatting examples</h2>
    <div class="tw-card p-6">
      <dl class="space-y-4">
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-slate-500">String:</dt>
          <dd class="text-sm text-slate-900"><%= format_attribute(@sample_user, :email) %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-slate-500">Boolean:</dt>
          <dd class="text-sm text-slate-900"><%= format_attribute(@sample_user, :admin) %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-slate-500">Date:</dt>
          <dd class="text-sm text-slate-900"><%= format_attribute(@sample_user, :created_at) %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm font-medium text-slate-500">Nil Value:</dt>
          <dd class="text-sm text-slate-900"><%= format_attribute(User.new, :name) %></dd>
        </div>
      </dl>
    </div>
  </div>

  <hr class="my-8">

  <!-- Component Usage Examples -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Usage examples</h2>
    <div class="bg-slate-50 p-6 rounded-lg">
      <h3 class="text-sm font-semibold text-slate-900 mb-3">Table component</h3>
      <pre class="text-xs bg-white p-4 rounded border border-slate-200 overflow-x-auto"><code>&lt;%= admin_table(
  @resources,
  columns: [
    { attribute: :name, label: "Name", sortable: true, link: true },
    { attribute: :status, label: "Status", sortable: true }
  ]
) %&gt;

&lt;%# The title and actions go above the card, not into it: %&gt;
&lt;%= render layout: "components/ui/page_header", locals: { title: "Resources" } do %&gt;
  &lt;%= link_to "New resource", [:new, :admin, :resource], class: admin_primary_button_class %&gt;
&lt;% end %&gt;</code></pre>

      <h3 class="text-sm font-semibold text-slate-900 mb-3 mt-6">Show attributes</h3>
      <pre class="text-xs bg-white p-4 rounded border border-slate-200 overflow-x-auto"><code>&lt;%= admin_show_attributes(
  @resource,
  attributes: [:name, :email, :created_at]
) %&gt;</code></pre>
    </div>
  </div>
</div>
