<div class="flex flex-wrap gap-3">
  <% if actions.include?(:edit) %>
    <%= link_to [:edit, :admin, resource], class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
      <%= lucide_icon("square-pen", class: "-ml-1 mr-2 h-5 w-5 text-slate-500 shrink-0") %>
      Edit
    <% end %>
  <% end %>

  <% if actions.include?(:delete) %>
    <%= link_to [:admin, resource],
                data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this #{resource.class.name.downcase}?" },
                class: "inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
      <%= lucide_icon("trash-2", class: "-ml-1 mr-2 h-5 w-5 text-red-500 shrink-0") %>
      Delete
    <% end %>
  <% end %>

  <% custom_actions.each do |action| %>
    <%= link_to action[:path],
                method: action[:method] || :get,
                data: action[:data] || {},
                class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md #{action[:class] || 'text-slate-700 bg-white hover:bg-slate-50'} focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
      <% if action[:icon] %>
        <%= lucide_icon(action[:icon], class: "-ml-1 mr-2 h-5 w-5 shrink-0") %>
      <% end %>
      <%= action[:label] %>
    <% end %>
  <% end %>
</div>
