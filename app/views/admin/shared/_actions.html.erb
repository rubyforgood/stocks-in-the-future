<div class="flex flex-wrap gap-3">
  <% if actions.include?(:edit) %>
    <%= link_to [:edit, :admin, resource], class: admin_secondary_button_class do %>
      <%= lucide_icon("pencil", class: "h-5 w-5 shrink-0 text-slate-500") %>
      Edit
    <% end %>
  <% end %>

  <% if actions.include?(:delete) %>
    <%= button_to [:admin, resource],
                  method: :delete, form: { class: "inline-flex" }, data: { turbo_confirm: delete_confirm(resource) },
                  class: admin_danger_button_class do %>
      <%= lucide_icon("trash-2", class: "h-5 w-5 shrink-0") %>
      Delete
    <% end %>
  <% end %>

  <% custom_actions.each do |action| %>
    <%= link_to action[:path],
                method: action[:method] || :get,
                data: action[:data] || {},
                class: "#{admin_secondary_button_class} #{action[:class]}" do %>
      <% if action[:icon] %>
        <%= lucide_icon(action[:icon], class: "h-5 w-5 shrink-0") %>
      <% end %>
      <%= action[:label] %>
    <% end %>
  <% end %>
</div>
