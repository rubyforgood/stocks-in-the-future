<div class="bg-white shadow-sm ring-1 ring-slate-900/5 rounded-lg overflow-hidden">
  <% if local_assigns[:title] || local_assigns[:actions] %>
    <div class="px-4 py-5 lg:px-6 border-b border-slate-200 flex justify-between items-center">
      <% if local_assigns[:title] %>
        <h2 class="text-lg font-semibold text-slate-900"><%= title %></h2>
      <% end %>
      <% if local_assigns[:actions] %>
        <div class="flex gap-2">
          <%= actions %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-slate-300">
      <thead class="bg-slate-50">
        <tr>
          <% columns.each do |column| %>
            <%# Column headers are chrome, not content: smaller and muted so they
                do not read at the same weight as the data. Matches tables.css. %>
            <th scope="col" class="px-3 py-3 text-left text-xs font-semibold text-slate-600">
              <% if column[:sortable] %>
                <%= sort_link(column[:attribute], column[:label]) %>
              <% else %>
                <%= column[:label] %>
              <% end %>
            </th>
          <% end %>
          <% if options[:show_actions] != false %>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 lg:pr-6">
              <span class="sr-only">Actions</span>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 bg-white">
        <% if collection.any? %>
          <% collection.each do |record| %>
            <tr id="<%= dom_id(record) %>" class="hover:bg-slate-50 transition-colors cursor-pointer"
                data-controller="clickable-row"
                data-clickable-row-url-value="<%= url_for([:admin, route_model(record)]) %>"
                data-action="click->clickable-row#navigate">
              <% columns.each do |column| %>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-900" data-testid="<%= column[:attribute] %>">
                  <% if column[:link] %>
                    <%= link_to format_attribute(record, column[:attribute]), [:admin, route_model(record)], class: "text-blue-600 hover:text-blue-800 font-medium" %>
                  <% else %>
                    <%= format_attribute(record, column[:attribute]) %>
                  <% end %>
                </td>
              <% end %>
              <% if options[:show_actions] != false %>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium lg:pr-6">
                  <div class="flex justify-end gap-2">
                    <%= link_to "View", [:admin, route_model(record)], class: "text-blue-600 hover:text-blue-800" %>
                    <%= link_to "Edit", [:edit, :admin, route_model(record)], class: "text-slate-600 hover:text-slate-800" %>
                    <%# A vague "Are you sure?" gives no basis for the decision.
                        Name the record so the confirmation is meaningful. %>
                    <%= link_to "Delete", [:admin, route_model(record)],
                                data: { turbo_method: :delete,
                                        turbo_confirm: "Delete #{record.class.model_name.human.downcase} \"#{record.try(:name) || record.try(:username) || record.try(:title) || record.id}\"? This cannot be undone." },
                                class: "font-medium text-red-700 hover:text-red-800" %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
        <% else %>
          <%= render "admin/shared/empty_row",
                     colspan: columns.length + (options[:show_actions] == false ? 0 : 1),
                     title: options[:empty_title] || "Nothing here yet",
                     body: options[:empty_message],
                     action_label: options[:empty_action_label],
                     action_path: options[:empty_action_path] %>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if collection.respond_to?(:total_pages) && collection.total_pages > 1 %>
    <div class="px-4 py-3 border-t border-slate-200 lg:px-6">
      <%= render "admin/shared/pagination", collection: collection %>
    </div>
  <% end %>
</div>
