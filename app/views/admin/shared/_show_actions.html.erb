<%# Edit and Delete for an admin show page, rendered inside the page header rather than
    inside the card - see components/ui/_page_header.

    Paths are passed explicitly rather than derived polymorphically: Student and Teacher
    are STI subclasses of User, so [:admin, record] does not reliably name their route
    (which is why admin/shared/_table carries a route_model helper).

    The confirmation names the record and says the action cannot be undone, matching
    admin/shared/_table. "Are you sure?" gives no basis for a decision.

    Locals:
      record      - the record, used to name it in the confirmation
      edit_path   - path to the edit form
      delete_path - path for the destroy request %>
<% label = record.try(:name) || record.try(:username) || record.try(:title) || record.id %>

<%= link_to edit_path, class: admin_secondary_button_class do %>
  <%= lucide_icon("square-pen", class: "h-5 w-5 shrink-0 text-slate-500") %>
  Edit
<% end %>

<%= link_to delete_path,
            data: { turbo_method: :delete, turbo_confirm: delete_confirm(record) },
            class: admin_danger_button_class do %>
  <%= lucide_icon("trash-2", class: "h-5 w-5 shrink-0") %>
  Delete
<% end %>
