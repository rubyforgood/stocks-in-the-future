<div class="bg-white shadow-sm ring-1 ring-slate-900/5 rounded-lg overflow-hidden">
  <div class="px-4 py-5 lg:px-6">
    <dl class="divide-y divide-slate-200">
      <% attributes.each do |attribute| %>
        <div class="py-4 lg:grid lg:grid-cols-3 lg:gap-4" data-testid="<%= attribute %>">
          <dt class="text-sm font-medium text-slate-500">
            <%= attribute.to_s.humanize %>
          </dt>
          <dd class="mt-1 text-sm text-slate-900 lg:col-span-2 lg:mt-0">
            <%= format_attribute(resource, attribute) %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>
</div>
