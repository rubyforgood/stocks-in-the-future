<% filters ||= [] %>
<% search_placeholder ||= "Search..." %>
<div class="tw-card mb-6 p-5">
  <%= form_with url: request.path, method: :get, class: "space-y-4 lg:space-y-0 lg:flex lg:items-center lg:gap-4" do |form| %>
    <%# Search Field %>
    <div class="flex-1">
      <label for="search" class="sr-only">Search</label>
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
          <%= lucide_icon("search", class: "h-4 w-4 text-slate-500 shrink-0") %>
        </div>
        <%= form.text_field :search,
                            value: params[:search],
                            placeholder: search_placeholder,
                            class: "tw-input-primary pl-10" %>
      </div>
    </div>

    <%# Filter Dropdowns %>
    <% filters.each do |filter| %>
      <div class="lg:w-48">
        <label for="<%= filter[:name] %>" class="sr-only"><%= filter[:label] %></label>
        <%= form.select filter[:name],
                        options_for_select(filter[:options], params[filter[:name]]),
                        { include_blank: filter[:label] },
                        class: "tw-input-primary pr-10" %>
      </div>
    <% end %>

    <%# Action Buttons %>
    <div class="flex gap-2">
      <%= form.submit "Filter", class: admin_primary_button_class %>
      <% if params[:search].present? || filters.any? { |f| params[f[:name]].present? } %>
        <%= link_to "Clear", request.path, class: admin_secondary_button_class %>
      <% end %>
    </div>
  <% end %>
</div>
