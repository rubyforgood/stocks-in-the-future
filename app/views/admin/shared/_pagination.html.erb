<% if collection.respond_to?(:total_pages) && collection.total_pages > 1 %>
  <nav class="flex items-center justify-between" aria-label="Pagination">
    <div class="hidden lg:block">
      <p class="text-sm text-slate-700">
        Showing
        <span class="font-medium"><%= collection.offset_value + 1 %></span>
        to
        <span class="font-medium"><%= [collection.offset_value + collection.limit_value, collection.total_count].min %></span>
        of
        <span class="font-medium"><%= collection.total_count %></span>
        results
      </p>
    </div>
    <div class="flex flex-1 justify-between lg:justify-end">
      <% if collection.prev_page %>
        <%= link_to "Previous", request.params.merge(page: collection.prev_page), class: admin_secondary_button_class %>
      <% else %>
        <span class="relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-400 bg-slate-100 cursor-not-allowed" aria-disabled="true">
          Previous
        </span>
      <% end %>

      <% if collection.next_page %>
        <%= link_to "Next", request.params.merge(page: collection.next_page), class: "#{admin_secondary_button_class} ml-3" %>
      <% else %>
        <span class="ml-3 relative inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded-md text-slate-400 bg-slate-100 cursor-not-allowed" aria-disabled="true">
          Next
        </span>
      <% end %>
    </div>
  </nav>
<% end %>
