<div class="space-y-6">
  <!-- Dashboard -->
  <div>
    <%= link_to root_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
      <%= lucide_icon("house", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
      Dashboard
    <% end %>
  </div>

  <!-- Academic Section -->
  <div>
    <h3 class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
      Academic
    </h3>
    <div class="space-y-1">
      <%= link_to admin_classrooms_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
        <%= lucide_icon("presentation", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
        Classrooms
      <% end %>
      <%= link_to admin_schools_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
        <%= lucide_icon("school", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
        Schools
      <% end %>
      <%= link_to admin_school_years_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
        <%= lucide_icon("calendar-check", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
        School years
      <% end %>
    </div>
  </div>

  <!-- Users Section -->
  <div>
    <h3 class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
      Users
    </h3>
    <div class="space-y-1">
      <%= link_to admin_students_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
        <%= lucide_icon("graduation-cap", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
        Students
      <% end %>
      <%= link_to admin_teachers_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
        <%= lucide_icon("presentation", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
        Teachers
      <% end %>
      <%= link_to admin_users_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
        <%= lucide_icon("users", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
        Users
      <% end %>
    </div>
  </div>

  <!-- Portfolio Section -->
  <div>
    <h3 class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
      Portfolio
    </h3>
    <div class="space-y-1">
      <%= link_to admin_stocks_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
        <%= lucide_icon("chart-line", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
        Stocks
      <% end %>
    </div>
  </div>

  <!-- Content Section -->
  <div>
    <h3 class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
      Content
    </h3>
    <div class="space-y-1">
      <%= link_to admin_announcements_path, class: "flex items-center px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 rounded-lg transition-colors" do %>
        <%= lucide_icon("megaphone", class: "w-5 mr-3 text-slate-500 h-5 shrink-0") %>
        Announcements
      <% end %>
    </div>
  </div>

  <!-- Development Section (remove in production) -->
  <% if Rails.env.development? %>
    <div>
      <h3 class="px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">
        Development
      </h3>
      <div class="space-y-1">
        <%= link_to admin_component_demo_index_path, class: "flex items-center px-3 py-2 text-sm font-medium text-purple-700 hover:bg-purple-50 hover:text-purple-900 rounded-lg transition-colors" do %>
          <%= lucide_icon("flask-conical", class: "w-5 mr-3 text-purple-500 h-5 shrink-0") %>
          Component demo
        <% end %>
      </div>
    </div>
  <% end %>
</div>
