<%# Admin sidebar navigation.

    Rows use NavHelper, the same treatment as the app nav, so moving between the two is not a
    change of scenery. Before this the app sidebar was a saturated teal panel and this one was
    white with no selected state at all - you could not tell which admin section you were in.

    nav_section_active? matches the section and anything below it, so a show or edit page keeps
    its parent row highlighted. aria-current carries that to assistive tech, since a tint and a
    bar are colour alone (WCAG 1.4.1). %>
<% sections = [
     { heading: nil,
       items: [{ label: "Dashboard", path: admin_root_path, icon: "house", exact: true }] },
     { heading: "Academic",
       items: [{ label: "Classrooms", path: admin_classrooms_path, icon: "presentation" },
               { label: "Schools", path: admin_schools_path, icon: "school" },
               { label: "School years", path: admin_school_years_path, icon: "calendar-check" }] },
     { heading: "Users",
       items: [{ label: "Students", path: admin_students_path, icon: "graduation-cap" },
               { label: "Teachers", path: admin_teachers_path, icon: "presentation" },
               { label: "Users", path: admin_users_path, icon: "users" }] },
     { heading: "Portfolio",
       items: [{ label: "Stocks", path: admin_stocks_path, icon: "chart-line" },
               { label: "Transactions", path: admin_portfolio_transactions_path,
                 icon: "arrow-left-right" }] },
     { heading: "Content",
       items: [{ label: "Announcements", path: admin_announcements_path, icon: "megaphone" }] }
   ] %>

<div class="space-y-4">
  <% sections.each do |section| %>
    <div>
      <% if section[:heading] %>
        <h2 class="px-3 mb-1 text-xs font-semibold text-slate-500"><%= section[:heading] %></h2>
      <% end %>

      <div class="space-y-1">
        <% section[:items].each do |item| %>
          <% active = nav_section_active?(item[:path], exact: item.fetch(:exact, false)) %>
          <%= link_to item[:path],
                      aria: { current: ("page" if active) },
                      class: nav_row_class(active: active) do %>
            <span class="<%= nav_indicator_class(active: active) %>" aria-hidden="true"></span>
            <%= lucide_icon(item[:icon], class: nav_icon_class(active: active)) %>
            <span><%= item[:label] %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Development only, and deliberately off the shared treatment so it is obviously not a
      production destination. %>
  <% if Rails.env.development? %>
    <div>
      <h2 class="px-3 mb-1 text-xs font-semibold text-slate-500">Development</h2>
      <div class="space-y-1">
        <% active = nav_section_active?(admin_component_demo_index_path) %>
        <% demo_class = "flex min-h-11 w-full items-center gap-3 rounded-lg py-2 pr-3 text-sm " \
                        "font-medium text-purple-700 transition-colors hover:bg-purple-50 " \
                        "focus-visible:outline-2 focus-visible:outline-offset-2 " \
                        "focus-visible:outline-purple-700 #{'bg-purple-50' if active}" %>
        <%= link_to admin_component_demo_index_path,
                    aria: { current: ("page" if active) },
                    class: demo_class do %>
          <span class="h-5 shrink-0 border-l-[3px] <%= active ? 'border-purple-600' : 'border-transparent' %>" aria-hidden="true"></span>
          <%= lucide_icon("flask-conical", class: "h-5 w-5 shrink-0 text-purple-600") %>
          <span>Component demo</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
