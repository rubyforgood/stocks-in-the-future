<nav class="flex mb-6" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 lg:space-x-3">
    <li class="inline-flex items-center">
      <%= link_to admin_root_path, class: "inline-flex items-center text-sm font-medium text-slate-700 hover:text-blue-600" do %>
        <%= lucide_icon("house", class: "w-4 h-4 mr-2 shrink-0") %>
        Dashboard
      <% end %>
    </li>

    <% breadcrumbs.each_with_index do |crumb, index| %>
      <li>
        <div class="flex items-center">
          <%= lucide_icon("chevron-right", class: "w-3 h-3 text-slate-500 mx-1 shrink-0") %>
          <% if index == breadcrumbs.length - 1 %>
            <span class="ml-1 text-sm font-medium text-slate-500 lg:ml-2">
              <%= crumb[:label] %>
            </span>
          <% else %>
            <%= link_to crumb[:label], crumb[:path], class: "ml-1 text-sm font-medium text-slate-700 hover:text-blue-600 lg:ml-2" %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ol>
</nav>
