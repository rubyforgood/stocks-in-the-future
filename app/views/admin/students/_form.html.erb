<%# A student's account: the fields, and nothing that is not one.

    **No heading of its own.** The card was headed "Student details" under a page header that had just
    named the student. The record page's section heading says "Details" once, above this - the same
    treatment every other form on this shape gets.

    **The transaction form has moved out**, into `_transaction_form`, because it is a second write with a
    second button and a section heading of its own. Keeping the two in one partial is what produced two
    titled cards, two submits and an "Add portfolio transaction" heading indistinguishable in weight from
    the page's own. %>
<%= form_with model: @student,
              url: @student.persisted? ? admin_student_path(@student) : admin_students_path,
              builder: Ui::FormBuilder, class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", record: @student, subject: "student" %>

  <%= render layout: "components/ui/card", locals: {} do %>
    <div>
      <%# Both halves of the product get the field. Admin keeps showing the username as well, because
          an administrator manages the account and the username is what the student signs in with. %>
      <%= f.text_field :name,
                       label: "Full name",
                       width: :half,
                       required: true,
                       hint: "Displayed wherever this student appears. If left blank, their " \
                             "username is shown instead." %>

      <%# `required: true` on both, matching the teacher's own form, which had it all along. The model
          requires a username and a classroom on this path, and the markup said neither: no asterisk on the
          label, no `required` attribute, so the browser let an empty form through to be rejected by the
          server. The asterisk is why the classroom hint no longer ends "(required)" - design.md's rule is
          that a requirement is stated once. %>
      <%= f.text_field :username,
                       label: "Username",
                       width: :half,
                       required: true,
                       hint: "Used to sign in. Must be unique.",
                       placeholder: "johndoe" %>

      <%= f.select :classroom_id,
                   options_from_collection_for_select(
                     Classroom.order(:name),
                     :id,
                     :name,
                     @student.classroom_id
                   ),
                   label: "Classroom",
                   width: :half,
                   required: true,
                   hint: "Determines which grade book pays them and whether they can trade.",
                   include_blank: "Select a classroom" %>

      <% if @student.new_record? %>
        <div class="mt-6 pt-6 border-t border-slate-200">
          <h3 class="text-base font-medium text-slate-900 mb-4">Password</h3>
          <p class="text-sm text-slate-600 mb-4">Leave blank to generate a random password automatically</p>

          <%= f.password_field :password,
                               label: "Password (optional)",
                               width: :half,
                               hint: "At least 6 characters. If left blank, one is generated.",
                               placeholder: "••••••••" %>

          <%= f.password_field :password_confirmation,
                               label: "Password confirmation",
                               width: :half,
                               placeholder: "••••••••" %>
        </div>
    </div>
    <% end %>
  <% end %>

  <%# Primary first, then cancel - design.md sets that order for a leading-edge row, and
      `form_actions_test` asserts it on the teacher-facing twin of this form. %>
  <div class="tw-form-actions">
    <%= f.submit_button @student.persisted? ? "Update student" : "Create student" %>
    <%= f.cancel_button "Cancel", url: @student.persisted? ? admin_student_path(@student) : admin_students_path %>
  </div>
<% end %>
