<div data-controller="dialog">
<%# data-controller wraps both the trigger and the dialog, which are siblings. %>
<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%# Inside the data-controller="dialog" wrapper above, so the import trigger still
      reaches the dialog it opens. %>
  <%= render layout: "components/ui/page_header", locals: { title: "Students" } do %>
    <%= link_to "Download template", template_admin_students_path, class: admin_secondary_button_class %>
    <%# A control that opens a dialog is a button, not a link to "#". %>
    <button type="button"
            data-action="click->dialog#open"
            aria-haspopup="dialog"
            class="<%= admin_secondary_button_class %>">
      Import students
    </button>
    <%= link_to "New student", new_admin_student_path, class: admin_primary_button_class %>
  <% end %>

  <%= render "admin/shared/discard_filter_tabs",
             current: current_discard_filter,
             tabs: [["Active", :active, admin_students_path],
                    ["Archived", :discarded, admin_students_path(discarded: true)],
                    ["All", :all, admin_students_path(all: true)]] %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr class="table-header-row">
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:username, "Username") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              Classroom
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              <%= sort_link(:created_at, "Created at") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right table-actions-cell hidden lg:table-cell">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <% if @students.any? %>
            <% @students.each do |student| %>
              <tr class="table-body-row cursor-pointer"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= admin_student_path(student) %>"
                  data-action="click->clickable-row#navigate">
                <%# Nil-safe: the form requires a classroom, and a student imported before that or
                    unassigned by hand still has to appear in this list rather than raising from it.
                    The em dash in slate-500 is `format_attribute`'s absent-value marker - slate-400
                    measures 2.6:1 and fails AA. %>
                <% classroom_cell = capture do %>
                  <%= student.classroom&.name || tag.span("—", class: "text-slate-500") %>
                <% end %>
                <% created_at_cell = capture do %>
                  <%= student.created_at.strftime("%B %d, %Y") %>
                <% end %>
                <% row_actions = capture do %>
                    <% unless student.discarded? %>
                      <%= ghost_action_link "Edit", edit_admin_student_path(student), icon: "pencil" %>
                    <% end %>
                    <%= discard_restore_action(student) %>
                <% end %>

                <td class="table-body-cell">
                  <%= link_to student.username, admin_student_path(student), class: "tw-link" %>

                  <%= render "shared/stacked_row_fields",
                             fields: [["Classroom", classroom_cell], ["Created at", created_at_cell]],
                             actions: row_actions %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= classroom_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= created_at_cell %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap table-actions-cell hidden lg:table-cell">
                  <div class="flex items-center justify-end gap-1"><%= row_actions %></div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "admin/shared/empty_row",
                       colspan: 4,
                       title: "No students yet",
                       body: "Add students one at a time, or import a whole classroom from a CSV.",
                       action_label: "New student",
                       action_path: new_admin_student_path %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%# Import Modal %>
<div id="import-modal" data-dialog-target="dialog" class="hidden fixed inset-0 z-50 flex items-center justify-center" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <%# Scrim. Clicking it dismisses, but that is a convenience only - the close
      and cancel buttons and Escape all work, so it needs no keyboard role.
      aria-hidden keeps it out of the accessibility tree. %>
  <div class="fixed inset-0 bg-black/50 transition-opacity"
       data-action="click->dialog#close"
       aria-hidden="true"></div>

  <%# rounded-2xl and shadow-2xl, matching the trading modal and the `cards/panels rounded-2xl`
      token. This was rounded-lg with shadow-xl - two modals, two surfaces. %>
  <div class="relative z-50 mx-4 w-full max-w-lg rounded-2xl bg-white shadow-2xl" data-dialog-target="panel" tabindex="-1">
    <div class="px-6 py-4">
      <div class="flex justify-between items-center mb-4">
        <%# h2 at text-base font-semibold, the same token as the trading modal and every card
            title. It was an h3 at text-lg font-medium. %>
        <h2 class="text-base font-semibold text-slate-900" id="modal-title">
          Import students from CSV
        </h2>
        <button type="button"
                data-action="click->dialog#close"
                class="flex min-w-11 min-h-11 items-center justify-center rounded-lg text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary">
          <span class="sr-only">Close import dialog</span>
          <%= lucide_icon "x", class: "size-5 shrink-0" %>
        </button>
      </div>

      <%# All three columns, because all three are required. This said "classroom_id, username" and stayed
          saying it when name became required - so the dialog told an admin to build a file the importer
          would then reject on every row. Helper text that lists a format is part of that format. %>
      <div class="mb-4 space-y-2 text-sm text-slate-600">
        <p>
          Upload a CSV with a header row and these columns:
          <strong class="text-slate-900">classroom_id, username, name</strong>. All three are required.
        </p>
        <p>
          A student&rsquo;s name is what appears throughout the app - a roster of usernames alone is hard to
          read - so a row without one is reported rather than imported.
        </p>
        <p>
          <%= link_to "Download a template", template_admin_students_path, class: "tw-link" %>
          to start from an example.
        </p>
      </div>

      <%= form_with url: import_admin_students_path, multipart: true, local: true do |form| %>
        <div class="mb-4">
          <%# The same named class as every other field. A file input renders its own native button
              inside itself, so it keeps cursor-pointer; everything else - border, radius, focus
              outline - comes from the token rather than a seventh hand-rolled string. %>
          <%= form.file_field :csv_file,
                              accept: ".csv",
                              class: "tw-input-primary cursor-pointer" %>
        </div>
        <div class="flex justify-end gap-3">
          <button type="button"
                  data-action="click->dialog#close"
                  class="<%= admin_secondary_button_class %>">
            Cancel
          </button>
          <%= form.submit "Import students",
                          class: admin_primary_button_class %>
        </div>
      <% end %>
    </div>
  </div>
</div>
</div>
