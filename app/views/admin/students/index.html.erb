<div data-controller="dialog">
<%# data-controller wraps both the trigger and the dialog, which are siblings. %>
<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%# Inside the data-controller="dialog" wrapper above, so the import trigger still
      reaches the dialog it opens. %>
  <%= render layout: "components/ui/page_header", locals: { title: "Students" } do %>
    <%= link_to "Template", template_admin_students_path, class: admin_secondary_button_class %>
    <%# A control that opens a dialog is a button, not a link to "#". %>
    <button type="button"
            data-action="click->dialog#open"
            aria-haspopup="dialog"
            class="<%= admin_secondary_button_class %>">
      Import students
    </button>
    <%= link_to "New student", new_admin_student_path, class: admin_primary_button_class %>
  <% end %>

  <%= render "admin/shared/discard_filter_tabs",
             current: current_discard_filter,
             tabs: [["Active", :active, admin_students_path],
                    ["Archived", :discarded, admin_students_path(discarded: true)],
                    ["All", :all, admin_students_path(all: true)]] %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-300">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:id, "ID") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:username, "Username") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              Classroom
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:created_at, "Created at") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% if @students.any? %>
            <% @students.each do |student| %>
              <tr class="hover:bg-slate-50 transition-colors cursor-pointer"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= admin_student_path(student) %>"
                  data-action="click->clickable-row#navigate">
                <td class="table-body-cell whitespace-nowrap">
                  <%= student.id %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= student.username %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= student.classroom.name %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= student.created_at.strftime("%B %d, %Y") %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap">
                  <div class="flex justify-end gap-2">
                    <%= link_to "View", admin_student_path(student), class: "tw-link" %>
                    <% unless student.discarded? %>
                      <%= link_to "Edit", edit_admin_student_path(student), class: "text-slate-600 hover:text-slate-800" %>
                    <% end %>
                    <%= discard_restore_action(student) %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "admin/shared/empty_row",
                       colspan: 5,
                       title: "No students yet",
                       body: "Add students one at a time, or import a whole classroom from a CSV.",
                       action_label: "New student",
                       action_path: new_admin_student_path %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Import Modal -->
<div id="import-modal" data-dialog-target="dialog" class="hidden fixed inset-0 z-50 flex items-center justify-center" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <%# Scrim. Clicking it dismisses, but that is a convenience only - the close
      and cancel buttons and Escape all work, so it needs no keyboard role.
      aria-hidden keeps it out of the accessibility tree. %>
  <div class="fixed inset-0 bg-slate-500/75 transition-opacity"
       data-action="click->dialog#close"
       aria-hidden="true"></div>

  <div class="relative bg-white rounded-lg shadow-xl max-w-lg w-full mx-4 z-50" data-dialog-target="panel" tabindex="-1">
    <div class="px-6 py-4">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-medium text-slate-900" id="modal-title">
          Import students from CSV
        </h3>
        <button type="button"
                data-action="click->dialog#close"
                class="flex min-w-11 min-h-11 items-center justify-center rounded-full text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary">
          <span class="sr-only">Close import dialog</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <p class="text-sm text-slate-500 mb-4">
        Upload a CSV file with columns: <strong>classroom_id, username</strong>
      </p>

      <%= form_with url: import_admin_students_path, multipart: true, local: true do |form| %>
        <div class="mb-4">
          <%= form.file_field :csv_file,
                              accept: ".csv",
                              class: "block w-full text-sm text-slate-900 border border-slate-300 rounded-lg cursor-pointer bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary p-2" %>
        </div>
        <div class="flex justify-end gap-3">
          <button type="button"
                  data-action="click->dialog#close"
                  class="inline-flex justify-center items-center min-h-11 px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-md hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary">
            Cancel
          </button>
          <%= form.submit "Import students",
                          class: "inline-flex justify-center px-4 py-2 text-sm font-medium text-sitf-on-primary bg-sitf-primary border border-transparent rounded-md hover:bg-sitf-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
</div>
