<%# The ninth and last admin resource on the shared record-page shape. What it replaced: a 1047px
    column, three titled cards, five heading levels, and a separate /edit page holding the two forms.

    The three-way rule the other eight were converted with, applied here:

    - an attribute the form edits appears **once**, as a field. `admin_show_attributes` printed username
      and classroom above a form that edits both.
    - a collection worth scanning or acting on gets a **section**. Transactions and attendance are two.
    - a lone read-only fact goes in the **header summary**. Cash balance and total value were two of four
      `text-2xl` tiles; the third was the portfolio's **id**, and the fourth said "Total stocks".

    Sections run editable first, read-only after, which is what the shell's own note prescribes. %>
<%= render layout: "admin/shared/record_page",
           locals: { title: @student.display_name, breadcrumbs: @breadcrumbs,
                     description: student_summary(@student),
                     actions: capture { render "admin/students/record_actions", student: @student } } do %>
  <%= render layout: "admin/shared/record_section",
             locals: { title: "Details", hint: "Saved when you press Update student." } do %>
    <%= render "form" %>
  <% end %>

  <% if @student.portfolio.present? %>
    <%# The second write on this page, and the one that moves money. Its own section, so the heading says
        what the button does and the hint says when it takes effect - the confusing thing about a page that
        mixes a form you submit with an action that applies at once. %>
    <%= render layout: "admin/shared/record_section",
               locals: { title: "Add a transaction",
                         hint: "Applies as soon as you press Add transaction: it changes what this " \
                               "student can invest, and appears in the transactions below." } do %>
      <%= render "transaction_form", student: @student, adjustment: @cash_adjustment %>
    <% end %>

    <%= render layout: "admin/shared/record_section",
               locals: { title: "Earnings",
                         hint: "Where this student's cash came from, and what trading has cost them." } do %>
      <%= render "shared/earnings_breakdown", summary: @earnings_summary %>
    <% end %>

    <%# The hint derives from what is in the section, so it cannot say "0 transactions, newest first" -
        which is what a fixed string did, promising an order for an empty list. %>
    <%= render layout: "admin/shared/record_section",
               locals: { title: "Transactions",
                         hint: ("#{pluralize(@transactions.size, 'transaction')}, newest first." if @transactions.any?) } do %>
      <% if @transactions.any? %>
        <%= render "transactions_table", transactions: @transactions %>
      <% else %>
        <p class="text-sm text-slate-600">No money has moved in or out of this portfolio yet.</p>
      <% end %>
    <% end %>
  <% else %>
    <%# A student created through the app always has a portfolio - `Student#ensure_portfolio` runs after
        create - so this is a legacy or half-imported record. One sentence, not three empty sections, and
        no transaction form: it would post to a nil `belongs_to` and could only fail. %>
    <%= render layout: "admin/shared/record_section", locals: { title: "Money" } do %>
      <%= render layout: "components/ui/card", locals: {} do %>
        <p class="text-sm text-slate-600">
          This student has no portfolio, so there is nowhere to hold cash, earnings or transactions.
        </p>
      <% end %>
    <% end %>
  <% end %>

  <%= render layout: "admin/shared/record_section",
             locals: { title: "Attendance", hint: "Entered on each quarter's grade book." } do %>
    <% if @attendance_entries.any? %>
      <%= render "attendance_table", entries: @attendance_entries %>
    <% else %>
      <p class="text-sm text-slate-600">No attendance records found.</p>
    <% end %>
  <% end %>
<% end %>
