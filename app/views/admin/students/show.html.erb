<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <div class="bg-white shadow-sm ring-1 ring-slate-900/5 rounded-lg mb-6">
    <div class="px-6 py-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-slate-900"><%= @student.username %></h2>
        <div class="flex gap-3">
          <%= link_to edit_admin_student_path(@student),
                      class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50" do %>
            <%= lucide_icon("square-pen", class: "-ml-1 mr-2 h-5 w-5 text-slate-500 shrink-0") %>
            Edit
          <% end %>
          <%= link_to admin_student_path(@student),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to archive this student?" },
                      class: "inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50" do %>
            <%= lucide_icon("archive", class: "-ml-1 mr-2 h-5 w-5 text-red-500 shrink-0") %>
            Archive
          <% end %>
        </div>
      </div>

      <div class="bg-white shadow-sm ring-1 ring-slate-900/5 rounded-lg overflow-hidden">
        <div class="px-4 py-5 lg:px-6">
          <dl class="divide-y divide-slate-200">
            <div class="py-4 lg:grid lg:grid-cols-3 lg:gap-4">
              <dt class="text-sm font-medium text-slate-500">Id</dt>
              <dd class="mt-1 text-sm text-slate-900 lg:col-span-2 lg:mt-0"><%= @student.id %></dd>
            </div>
            <div class="py-4 lg:grid lg:grid-cols-3 lg:gap-4">
              <dt class="text-sm font-medium text-slate-500">Username</dt>
              <dd class="mt-1 text-sm text-slate-900 lg:col-span-2 lg:mt-0"><%= @student.username %></dd>
            </div>
            <div class="py-4 lg:grid lg:grid-cols-3 lg:gap-4">
              <dt class="text-sm font-medium text-slate-500">Classroom</dt>
              <dd class="mt-1 text-sm text-slate-900 lg:col-span-2 lg:mt-0"><%= @student.classroom.name %></dd>
            </div>
            <div class="py-4 lg:grid lg:grid-cols-3 lg:gap-4">
              <dt class="text-sm font-medium text-slate-500">Created at</dt>
              <dd class="mt-1 text-sm text-slate-900 lg:col-span-2 lg:mt-0"><%= @student.created_at.strftime("%B %d, %Y") %></dd>
            </div>
            <div class="py-4 lg:grid lg:grid-cols-3 lg:gap-4">
              <dt class="text-sm font-medium text-slate-500">Updated at</dt>
              <dd class="mt-1 text-sm text-slate-900 lg:col-span-2 lg:mt-0"><%= @student.updated_at.strftime("%B %d, %Y") %></dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Associated Portfolio -->
      <% if @student.portfolio.present? %>
        <div class="mt-6 pt-6 border-t border-slate-200">
          <h3 class="text-sm font-medium text-slate-500 mb-3">Portfolio details</h3>
          <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-6">
            <div class="bg-blue-50 p-4 rounded-lg">
              <div class="text-xs font-medium text-blue-600 mb-1" data-testid="cash_balance_label">
                Cash balance
              </div>
              <div class="text-2xl font-bold text-blue-900 tabular-nums"><%= number_to_currency(@student.portfolio.cash_balance) %></div>
            </div>
            <div class="bg-green-50 p-4 rounded-lg">
              <div class="text-xs font-medium text-green-600 mb-1" data-testid="total_portfolio_worth_label">
                Total portfolio worth
              </div>
              <div class="text-2xl font-bold text-green-900 tabular-nums"><%= number_to_currency(@student.portfolio.total_portfolio_worth) %></div>
            </div>
            <div class="bg-purple-50 p-4 rounded-lg">
              <div class="text-xs font-medium text-purple-600 mb-1">Total stocks</div>
              <div class="text-2xl font-bold text-purple-900"><%= @student.portfolio.portfolio_stocks.sum(:shares).to_i %></div>
            </div>
            <%= link_to portfolio_path(@student.portfolio), class: "bg-slate-50 p-4 rounded-lg block hover:bg-slate-100 transition-colors" do %>
              <div class="text-xs font-medium text-slate-600 mb-1">Portfolio ID</div>
              <div class="text-2xl font-bold text-slate-900">#<%= @student.portfolio.id %></div>
            <% end %>
            </div>
          </div>

          <!-- Earnings Summary -->
          <h4 class="text-sm font-medium text-slate-700 mb-3">Earnings summary</h4>
          <div class="overflow-hidden shadow ring-1 ring-black/5 rounded-lg mb-6">
            <table class="min-w-full divide-y divide-slate-300">
              <thead class="bg-slate-50">
                <tr>
                  <th scope="col" class="table-header-cell table-header-cell-left">Category</th>
                  <th scope="col" class="table-header-cell table-header-cell-right">Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr>
                  <td class="px-3 py-2 text-sm text-slate-900">Attendance earnings</td>
                  <td class="px-3 py-2 text-sm text-right font-medium text-slate-900 tabular-nums"><%= number_to_currency(@earnings_summary.attendance_earnings_cents / 100.0) %></td>
                </tr>
                <tr>
                  <td class="px-3 py-2 text-sm text-slate-900">Math earnings</td>
                  <td class="px-3 py-2 text-sm text-right font-medium text-slate-900 tabular-nums"><%= number_to_currency(@earnings_summary.math_earnings_cents / 100.0) %></td>
                </tr>
                <tr>
                  <td class="px-3 py-2 text-sm text-slate-900">Rewards</td>
                  <td class="px-3 py-2 text-sm text-right font-medium text-slate-900 tabular-nums"><%= number_to_currency(@earnings_summary.awards_cents / 100.0) %></td>
                </tr>
                <tr class="bg-green-50">
                  <td class="px-3 py-2 text-sm font-semibold text-slate-900">Total earnings</td>
                  <td class="px-3 py-2 text-sm text-right font-bold text-slate-900 tabular-nums"><%= number_to_currency(@earnings_summary.total_earnings_cents / 100.0) %></td>
                </tr>
                <tr>
                  <td class="px-3 py-2 text-sm font-medium text-red-600">Transaction fees</td>
                  <td class="px-3 py-2 text-sm text-right font-medium text-red-600 tabular-nums"><%= number_to_currency(@earnings_summary.transaction_fees_cents / 100.0) %></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Transactions -->
          <% transactions = @student.portfolio.portfolio_transactions.order(created_at: :desc) %>
          <% if transactions.any? %>
            <h4 class="text-sm font-medium text-slate-700 mb-3">All Transactions (<%= transactions.count %>)</h4>
            <div class="overflow-hidden shadow ring-1 ring-black/5 rounded-lg mb-4">
              <table class="min-w-full divide-y divide-slate-300">
                <thead class="bg-slate-50">
                  <tr>
                    <th scope="col" class="table-header-cell table-header-cell-left">Date</th>
                    <th scope="col" class="table-header-cell table-header-cell-left">Type</th>
                    <th scope="col" class="table-header-cell table-header-cell-left">Reason</th>
                    <th scope="col" class="table-header-cell table-header-cell-right">Amount</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                  <% transactions.each do |transaction| %>
                    <tr>
                      <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-900">
                        <%= transaction.created_at.strftime("%m/%d/%Y") %>
                      </td>
                      <td class="whitespace-nowrap px-3 py-2 text-sm">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= transaction.transaction_type == 'deposit' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= transaction.transaction_type.capitalize %>
                        </span>
                      </td>
                      <td class="px-3 py-2 text-sm text-slate-900">
                        <%= transaction.reason&.humanize || 'N/A' %>
                      </td>
                      <td class="whitespace-nowrap px-3 py-2 text-sm text-right font-medium text-slate-900">
                        <%= number_to_currency(transaction.amount_cents / 100.0) %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-sm text-slate-500 mb-4">No transactions yet.</p>
          <% end %>
        </div>
      <% else %>
        <div class="mt-6 pt-6 border-t border-slate-200">
          <p class="text-sm text-slate-500">No portfolio associated with this student.</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Attendance -->
  <div class="bg-white shadow-sm ring-1 ring-slate-900/5 rounded-lg mb-6">
    <div class="px-6 py-6">
      <h3 class="text-sm font-medium text-slate-500 mb-3">Attendance</h3>
      <% if @attendance_entries.any? %>
        <div class="overflow-hidden shadow ring-1 ring-black/5 rounded-lg">
          <table class="min-w-full divide-y divide-slate-300">
            <thead class="bg-slate-50">
              <tr>
                <th scope="col" class="table-header-cell table-header-cell-left">Year</th>
                <th scope="col" class="table-header-cell table-header-cell-left">Quarter</th>
                <th scope="col" class="table-header-cell table-header-cell-right">Attendance days</th>
                <th scope="col" class="table-header-cell table-header-cell-center">Perfect attendance</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% @attendance_entries.each do |entry| %>
                <tr>
                  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-900">
                    <%= entry.year_name %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-900">
                    <%= entry.quarter_name %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2 text-sm text-right text-slate-900">
                    <%= entry.attendance_days_display %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2 text-sm text-center">
                    <% if entry.perfect_attendance? %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Yes</span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600">No</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-500">No attendance records found.</p>
      <% end %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= link_to "Back to students", admin_students_path,
                class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50" %>
  </div>
</div>
