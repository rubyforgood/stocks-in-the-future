<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: @student.username } do %>
    <%= link_to edit_admin_student_path(@student), class: admin_secondary_button_class do %>
      <%= lucide_icon("square-pen", class: "-ml-1 mr-2 h-5 w-5 text-slate-500 shrink-0") %>
      Edit
    <% end %>

    <%= link_to admin_student_path(@student),
                data: { turbo_method: :delete,
                        turbo_confirm: "Archive #{@student.username}? They will no longer appear in the active list." },
                class: admin_danger_button_class do %>
      <%= lucide_icon("archive", class: "-ml-1 mr-2 h-5 w-5 text-red-500 shrink-0") %>
      Archive
    <% end %>
  <% end %>

  <div class="space-y-6">
    <%# Was a hand-rolled dl repeating what admin_show_attributes already renders, with
        slate-500 labels rather than the slate-700 the shared partial uses. %>
    <%= admin_show_attributes(
          @student,
          attributes: %i[id username classroom created_at updated_at]
        ) %>

    <% if @student.portfolio.present? %>
      <%= render layout: "components/ui/card", locals: { title: "Portfolio details" } do %>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-4">
          <div class="rounded-lg bg-blue-50 p-4">
            <div class="mb-1 text-xs font-medium text-blue-700" data-testid="cash_balance_label">
              Cash balance
            </div>
            <div class="text-2xl font-bold text-blue-900 tabular-nums">
              <%= number_to_currency(@student.portfolio.cash_balance) %>
            </div>
          </div>

          <%# green-600 on green-50 measured 3.4:1, below the 4.5:1 gate for text this
              size. green-700 is 4.8:1. %>
          <div class="rounded-lg bg-green-50 p-4">
            <div class="mb-1 text-xs font-medium text-green-700" data-testid="total_portfolio_worth_label">
              Total portfolio worth
            </div>
            <div class="text-2xl font-bold text-green-900 tabular-nums">
              <%= number_to_currency(@student.portfolio.total_portfolio_worth) %>
            </div>
          </div>

          <div class="rounded-lg bg-purple-50 p-4">
            <div class="mb-1 text-xs font-medium text-purple-700">Total stocks</div>
            <div class="text-2xl font-bold text-purple-900 tabular-nums">
              <%= @student.portfolio.portfolio_stocks.sum(:shares).to_i %>
            </div>
          </div>

          <%= link_to portfolio_path(@student.portfolio),
                      class: "block rounded-lg bg-slate-50 p-4 transition-colors hover:bg-slate-100 " \
                             "focus-visible:outline-2 focus-visible:outline-offset-2 " \
                             "focus-visible:outline-sitf-primary" do %>
            <div class="mb-1 text-xs font-medium text-slate-600">Portfolio ID</div>
            <div class="text-2xl font-bold text-slate-900 tabular-nums">#<%= @student.portfolio.id %></div>
          <% end %>
        </div>

        <h3 class="mt-6 mb-3 text-sm font-medium text-slate-700">Earnings summary</h3>
        <div class="overflow-x-auto border-t border-slate-200">
          <table class="min-w-full divide-y divide-slate-300">
            <thead class="bg-slate-50">
              <tr>
                <th scope="col" class="table-header-cell table-header-cell-left">Category</th>
                <th scope="col" class="table-header-cell table-header-cell-right">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% { "Attendance earnings" => @earnings_summary.attendance_earnings_cents,
                   "Math earnings" => @earnings_summary.math_earnings_cents,
                   "Rewards" => @earnings_summary.awards_cents }.each do |label, cents| %>
                <tr>
                  <td class="px-3 py-2 text-sm text-slate-900"><%= label %></td>
                  <td class="px-3 py-2 text-right text-sm font-medium text-slate-900 tabular-nums">
                    <%= number_to_currency(cents / 100.0) %>
                  </td>
                </tr>
              <% end %>
              <tr class="bg-green-50">
                <td class="px-3 py-2 text-sm font-semibold text-slate-900">Total earnings</td>
                <td class="px-3 py-2 text-right text-sm font-bold text-slate-900 tabular-nums">
                  <%= number_to_currency(@earnings_summary.total_earnings_cents / 100.0) %>
                </td>
              </tr>
              <%# red-600 on white is 4.0:1, under the gate. red-700 is 5.9:1. %>
              <tr>
                <td class="px-3 py-2 text-sm font-medium text-red-700">Transaction fees</td>
                <td class="px-3 py-2 text-right text-sm font-medium text-red-700 tabular-nums">
                  <%= number_to_currency(@earnings_summary.transaction_fees_cents / 100.0) %>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <% transactions = @student.portfolio.portfolio_transactions.order(created_at: :desc) %>
        <h3 class="mt-6 mb-3 text-sm font-medium text-slate-700">
          All transactions (<%= transactions.count %>)
        </h3>
        <% if transactions.any? %>
          <div class="overflow-x-auto border-t border-slate-200">
            <table class="min-w-full divide-y divide-slate-300">
              <thead class="bg-slate-50">
                <tr>
                  <th scope="col" class="table-header-cell table-header-cell-left">Date</th>
                  <th scope="col" class="table-header-cell table-header-cell-left">Type</th>
                  <th scope="col" class="table-header-cell table-header-cell-left">Reason</th>
                  <th scope="col" class="table-header-cell table-header-cell-right">Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <% transactions.each do |transaction| %>
                  <tr>
                    <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-900">
                      <%= transaction.created_at.strftime("%m/%d/%Y") %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-2 text-sm">
                      <span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium <%= transaction.deposit? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                        <%= transaction.transaction_type.humanize %>
                      </span>
                    </td>
                    <td class="px-3 py-2 text-sm text-slate-900">
                      <%= transaction.reason&.humanize || "—" %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-2 text-right text-sm font-medium text-slate-900 tabular-nums">
                      <%= number_to_currency(transaction.amount_cents / 100.0) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-sm text-slate-600">No transactions yet.</p>
        <% end %>
      <% end %>
    <% else %>
      <%= render layout: "components/ui/card", locals: { title: "Portfolio details" } do %>
        <p class="text-sm text-slate-600">No portfolio associated with this student.</p>
      <% end %>
    <% end %>

    <%= render layout: "components/ui/card", locals: { title: "Attendance" } do %>
      <% if @attendance_entries.any? %>
        <div class="overflow-x-auto border-t border-slate-200">
          <table class="min-w-full divide-y divide-slate-300">
            <thead class="bg-slate-50">
              <tr>
                <th scope="col" class="table-header-cell table-header-cell-left">Year</th>
                <th scope="col" class="table-header-cell table-header-cell-left">Quarter</th>
                <th scope="col" class="table-header-cell table-header-cell-right">Attendance days</th>
                <th scope="col" class="table-header-cell table-header-cell-center">Perfect attendance</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
              <% @attendance_entries.each do |entry| %>
                <tr>
                  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-900"><%= entry.year_name %></td>
                  <td class="whitespace-nowrap px-3 py-2 text-sm text-slate-900"><%= entry.quarter_name %></td>
                  <td class="whitespace-nowrap px-3 py-2 text-right text-sm text-slate-900 tabular-nums">
                    <%= entry.attendance_days_display %>
                  </td>
                  <td class="whitespace-nowrap px-3 py-2 text-center text-sm">
                    <% if entry.perfect_attendance? %>
                      <span class="inline-flex items-center rounded bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Yes</span>
                    <% else %>
                      <span class="inline-flex items-center rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700">No</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-600">No attendance records found.</p>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to "Back to students", admin_students_path, class: admin_secondary_button_class %>
  </div>
</div>
