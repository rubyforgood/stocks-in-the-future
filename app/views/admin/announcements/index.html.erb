<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "Announcements" } do %>
    <%= link_to "New announcement", new_admin_announcement_path, class: admin_primary_button_class %>
  <% end %>

  <%= admin_table(
        @announcements,
        columns: [
          { attribute: :title, label: "Title", sortable: true },
          { attribute: :featured, label: "Featured", sortable: true },
          { attribute: :created_at, label: "Created", sortable: true },
          { attribute: :updated_at, label: "Updated", sortable: true }
        ],
        empty_message: "No announcements found. Create your first announcement to get started."
      ) %>
</div>
