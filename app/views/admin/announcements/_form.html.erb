<%= form_with model: @announcement, url: @announcement.persisted? ? admin_announcement_path(@announcement) : admin_announcements_path, builder: Ui::FormBuilder, class: "space-y-6" do |f| %>
  <%= render "shared/form_errors", record: @announcement, subject: "announcement" %>

  <%# `components/ui/_card`, and no heading of its own.

      The surface was hand-rolled in ten form partials - `<div class="tw-card"><div class="p-5">` - so it
      was declared eleven times, which is the mechanism that produced four different padding values before
      anyone noticed. And each opened with an `h3` naming the record type, under a page header that had
      just named it: "Teacher details" below "Edit teacher", 24px apart, in two sizes. Polaris drops a
      card's header when the page has one card. A heading returns the moment a form has two - see
      admin/students, where it separates them. %>
  <%= render layout: "components/ui/card", locals: {} do %>
      <%= f.text_field :title,
                       label: "Title",
                       required: true,
                       hint: "Enter the announcement title (max 255 characters)",
                       placeholder: "Important update" %>

      <%= f.rich_text_area :content,
                           label: "Content",
                           required: true,
                           hint: "Write the full announcement content" %>

      <%= f.boolean_field :featured,
                          label: "Featured",
                          hint: "Only one announcement can be featured at a time. Featuring this will unfeature the current one." %>
  <% end %>

  <div class="tw-form-actions">
    <%= f.submit_button @announcement.persisted? ? "Update announcement" : "Create announcement" %>
    <%= f.cancel_button "Cancel", url: @announcement.persisted? ? admin_announcement_path(@announcement) : admin_announcements_path %>
  </div>
<% end %>
