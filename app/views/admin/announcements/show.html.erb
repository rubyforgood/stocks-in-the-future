<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%# The title and its actions sit at page level, on the page background. They used to
      be nested inside the card alongside admin_show_attributes - which renders a card
      of its own, so the page held a card inside a card. %>
  <%= render layout: "components/ui/page_header", locals: { title: @announcement.title } do %>
    <%= render "admin/shared/show_actions",
               record: @announcement,
               edit_path: edit_admin_announcement_path(@announcement),
               delete_path: admin_announcement_path(@announcement) %>
  <% end %>

  <div class="space-y-6">
    <%= admin_show_attributes(
          @announcement,
          attributes: %i[id title featured created_at updated_at]
        ) %>

    <%= render layout: "components/ui/card", locals: { title: "Content" } do %>
      <div class="prose max-w-none">
        <%= @announcement.content %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to "Back to announcements", admin_announcements_path, class: admin_secondary_button_class %>
  </div>
</div>
