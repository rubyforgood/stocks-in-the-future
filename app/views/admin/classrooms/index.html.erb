<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "Classrooms" } do %>
    <%= link_to "New classroom", new_admin_classroom_path, class: admin_primary_button_class %>
  <% end %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr class="table-header-row">
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:id, "ID") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:name, "Name") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              Grade
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              School year
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:archived, "Archived") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:trading_enabled, "Trading enabled") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right table-actions-pinned">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <% if @classrooms.any? %>
            <% @classrooms.each do |classroom| %>
              <tr class="table-body-row" id="<%= dom_id(classroom) %>" class="hover:bg-slate-50 transition-colors cursor-pointer"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= admin_classroom_path(classroom) %>"
                  data-action="click->clickable-row#navigate">
                <td class="table-body-cell whitespace-nowrap">
                  <%= classroom.id %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= classroom.name %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= classroom.grades.pluck(:name).join(', ') %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= "#{classroom.school_name} - #{classroom.year_name}" %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= render "components/ui/badge",
                             label: classroom.archived? ? "Yes" : "No",
                             tone: classroom.archived? ? :danger : :neutral %>
                </td>
                <td class="table-body-cell whitespace-nowrap">
                  <%= render "components/ui/badge",
                             label: classroom.trading_enabled? ? "Yes" : "No",
                             tone: classroom.trading_enabled? ? :success : :neutral %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap table-actions-pinned">
                  <div class="flex items-center justify-end gap-1">
                    <%= ghost_action_link "View", admin_classroom_path(classroom), icon: "eye" %>
                    <%= ghost_action_link "Edit", edit_admin_classroom_path(classroom), icon: "pencil" %>
                    <% if classroom.archived? %>
                      <%= ghost_action_link "Activate", toggle_archive_admin_classroom_path(classroom),
                                            icon: "circle-check",
                                            data: { turbo_method: :patch, turbo_confirm: "Activate #{classroom.name}?" } %>
                    <% else %>
                      <%= ghost_action_link "Archive", toggle_archive_admin_classroom_path(classroom),
                                            icon: "archive", variant: :danger,
                                            data: { turbo_method: :patch, turbo_confirm: "Archive #{classroom.name}? Teachers and students will no longer be able to access it, but all historical data is preserved." } %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "admin/shared/empty_row",
                       colspan: 7,
                       title: "No classrooms yet",
                       body: "Classrooms group students with a teacher, a school year and grades.",
                       action_label: "New classroom",
                       action_path: new_admin_classroom_path %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
