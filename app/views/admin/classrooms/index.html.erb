<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "Classrooms" } do %>
    <%= link_to "New classroom", new_admin_classroom_path, class: admin_primary_button_class %>
  <% end %>

  <%# The same three tabs as students, teachers and users, reading the same query params - see
      `SoftDeletableFiltering#discard_filter`. "Archived", not "Deactivated": a classroom is archived, which is
      the word the row action and the flash both use. %>
  <%= render "admin/shared/discard_filter_tabs",
             current: discard_filter,
             tabs: [["Active", :active, admin_classrooms_path],
                    ["Archived", :discarded, admin_classrooms_path(discarded: true)],
                    ["All", :all, admin_classrooms_path(all: true)]] %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr class="table-header-row">
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:name, "Name") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              Grade
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              School year
            </th>
            <%# One Status column, not an "Archived" yes/no beside a "Trading enabled" yes/no. Two badge
                columns cost 236px of a 718px scroller at 1024px and pushed the row actions off screen; this
                is ~110px and says the state in words rather than answering two questions with "Yes".
                Matches the Status column on admin/teachers.

                Not sortable, and that is a real loss: with no archived filter on this page, sorting by
                Archived was how you grouped them. Filter tabs are the better answer - noted in
                design-todo. %>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              Status
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right table-actions-cell hidden lg:table-cell">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <% if @classrooms.any? %>
            <% @classrooms.each do |classroom| %>
              <tr class="table-body-row cursor-pointer" id="<%= dom_id(classroom) %>"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= admin_classroom_path(classroom) %>"
                  data-action="click->clickable-row#navigate">
                <% grade_cell = capture do %>
                  <%= classroom.grades.pluck(:name).join(', ') %>
                <% end %>
                <% school_year_cell = capture do %>
                  <%= "#{classroom.school_name} - #{classroom.year_name}" %>
                <% end %>
                <%# Archived outranks trading: an archived classroom's switch position is moot, because
                    nobody is using it. One badge, one fact, the fact that matters for this row. %>
                <%# The same helper the record page's title badge uses. It was written out here and the
                    record page derived the same thing again as words on its summary line, which is how a
                    classroom came to read "Trading off" in the list and "trading on" on its own page. %>
                <% status_cell = capture { classroom_status_badge(classroom) } %>
                <% row_actions = capture do %>
                    <% if classroom.archived? %>
                      <%= ghost_action_link "Activate", toggle_archive_admin_classroom_path(classroom),
                                            icon: "circle-check",
                                            data: { turbo_method: :patch,
                                                    turbo_confirm: classroom_toggle_confirm(classroom) } %>
                    <% else %>
                      <%= ghost_action_link "Archive", toggle_archive_admin_classroom_path(classroom),
                                            icon: "archive", variant: :danger,
                                            data: { turbo_method: :patch,
                                                    turbo_confirm: classroom_toggle_confirm(classroom) } %>
                    <% end %>
                <% end %>

                <td class="table-body-cell">
                  <%= link_to classroom.name, admin_classroom_path(classroom), class: "tw-link" %>

                  <%= render "shared/stacked_row_fields",
                             fields: [["Grade", grade_cell], ["School year", school_year_cell], ["Status", status_cell]],
                             actions: row_actions %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= grade_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= school_year_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= status_cell %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap table-actions-cell hidden lg:table-cell">
                  <div class="flex items-center justify-end gap-1"><%= row_actions %></div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%# The Archived tab is a different sentence: there are classrooms, none of them archived, and a
                New button would not put one in this list. `archived_empty_state` is the one copy of it. %>
            <% if discard_filter == :discarded %>
              <%= render "admin/shared/empty_row", colspan: 5, **archived_empty_state("classroom") %>
            <% else %>
              <%= render "admin/shared/empty_row",
                         colspan: 5,
                         title: "No classrooms yet",
                         body: "Classrooms group students with a teacher, a school year and grades." %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
