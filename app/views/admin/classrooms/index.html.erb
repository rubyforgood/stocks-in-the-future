<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%= render layout: "components/ui/page_header", locals: { title: "Classrooms" } do %>
    <%= link_to "New classroom", new_admin_classroom_path, class: admin_primary_button_class %>
  <% end %>

  <div class="tw-card">
    <div class="overflow-x-auto">
      <table class="table-base">
        <thead>
          <tr class="table-header-row">
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              <%= sort_link(:id, "ID") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left">
              <%= sort_link(:name, "Name") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              Grade
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              School year
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              <%= sort_link(:archived, "Archived") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-left hidden lg:table-cell">
              <%= sort_link(:trading_enabled, "Trading enabled") %>
            </th>
            <th scope="col" class="table-header-cell table-header-cell-right table-actions-cell hidden lg:table-cell">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="bg-white">
          <% if @classrooms.any? %>
            <% @classrooms.each do |classroom| %>
              <tr class="table-body-row cursor-pointer" id="<%= dom_id(classroom) %>"
                  data-controller="clickable-row"
                  data-clickable-row-url-value="<%= admin_classroom_path(classroom) %>"
                  data-action="click->clickable-row#navigate">
                <% id_cell = capture do %>
                  <%= classroom.id %>
                <% end %>
                <% grade_cell = capture do %>
                  <%= classroom.grades.pluck(:name).join(', ') %>
                <% end %>
                <% school_year_cell = capture do %>
                  <%= "#{classroom.school_name} - #{classroom.year_name}" %>
                <% end %>
                <% archived_cell = capture do %>
                  <%= render "components/ui/badge",
                             label: classroom.archived? ? "Yes" : "No",
                             tone: classroom.archived? ? :danger : :neutral %>
                <% end %>
                <% trading_enabled_cell = capture do %>
                  <%= render "components/ui/badge",
                             label: classroom.trading_enabled? ? "Yes" : "No",
                             tone: classroom.trading_enabled? ? :success : :neutral %>
                <% end %>
                <%# One trigger, not three labelled ghosts.

                    `View` is gone: the classroom's name is a link to that page as of the previous change,
                    so the row carried two controls to the same place - which this document already calls a
                    defect where a dashboard had two ghosts with the same href.

                    The rest live behind the menu. Measured, three ghosts made this cell 260px, the widest
                    column in the table and 36% of the 703px visible at 1024px; a 44px trigger makes it 76px
                    and takes the table's overflow at 1024 from 215px to 32px.

                    **The items are captured once and the menu is rendered twice, with different ids.** This
                    row is emitted in two places - the trailing cell at `lg`, and inside the primary cell
                    below it through `stacked_row_fields` - and a popover is addressed by id, so one id used
                    twice means every visible trigger opens the *hidden* copy's panel. It did: the panel
                    measured 0x0 and reported itself open. The items themselves stay a single definition,
                    because two copies of a row's actions is the drift this codebase keeps recording. %>
                <% action_items = capture do %>
                  <%= menu_action_link "Edit", edit_admin_classroom_path(classroom), icon: "pencil" %>
                  <% if classroom.archived? %>
                    <%= menu_action_link "Activate", toggle_archive_admin_classroom_path(classroom),
                                         icon: "circle-check",
                                         data: { turbo_method: :patch,
                                                 turbo_confirm: classroom_toggle_confirm(classroom) } %>
                  <% else %>
                    <%= menu_action_link "Archive", toggle_archive_admin_classroom_path(classroom),
                                         icon: "archive", variant: :danger,
                                         data: { turbo_method: :patch,
                                                 turbo_confirm: classroom_toggle_confirm(classroom) } %>
                  <% end %>
                <% end %>

                <% row_actions_stacked = capture do %>
                  <%= render layout: "components/ui/row_actions",
                             locals: { id: "row-actions-stacked-#{dom_id(classroom)}",
                                       label: "Actions for #{classroom.name}" } do %>
                    <%= action_items %>
                  <% end %>
                <% end %>

                <% row_actions = capture do %>
                  <%= render layout: "components/ui/row_actions",
                             locals: { id: "row-actions-#{dom_id(classroom)}",
                                       label: "Actions for #{classroom.name}" } do %>
                    <%= action_items %>
                  <% end %>
                <% end %>

                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= id_cell %>
                </td>
                <td class="table-body-cell">
                  <%= link_to classroom.name, admin_classroom_path(classroom), class: "tw-link" %>

                  <%= render "shared/stacked_row_fields",
                             fields: [["ID", id_cell], ["Grade", grade_cell], ["School year", school_year_cell], ["Archived", archived_cell], ["Trading enabled", trading_enabled_cell]],
                             actions: row_actions_stacked %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= grade_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= school_year_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= archived_cell %>
                </td>
                <td class="table-body-cell whitespace-nowrap hidden lg:table-cell">
                  <%= trading_enabled_cell %>
                </td>
                <td class="table-body-cell table-body-cell-right whitespace-nowrap table-actions-cell hidden lg:table-cell">
                  <div class="flex items-center justify-end gap-1"><%= row_actions %></div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <%= render "admin/shared/empty_row",
                       colspan: 7,
                       title: "No classrooms yet",
                       body: "Classrooms group students with a teacher, a school year and grades.",
                       action_label: "New classroom",
                       action_path: new_admin_classroom_path %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
