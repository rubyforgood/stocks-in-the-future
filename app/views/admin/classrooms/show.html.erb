<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <%# Actions are written out rather than using admin/shared/_show_actions because the
      archive toggle sits between Edit and Delete, and that order is worth keeping. %>
  <%= render layout: "components/ui/page_header", locals: { title: @classroom.name } do %>
    <%= link_to edit_admin_classroom_path(@classroom), class: admin_secondary_button_class do %>
      <%= lucide_icon("square-pen", class: "h-5 w-5 shrink-0 text-slate-500") %>
      Edit
    <% end %>

    <%= classroom_archive_toggle_button(@classroom) %>

    <%= link_to admin_classroom_path(@classroom),
                data: { turbo_method: :delete,
                        turbo_confirm: "Delete classroom \"#{@classroom.name}\"? This cannot be undone." },
                class: admin_danger_button_class do %>
      <%= lucide_icon("trash-2", class: "h-5 w-5 shrink-0 text-red-500") %>
      Delete
    <% end %>
  <% end %>

  <div class="space-y-6">
    <%= admin_show_attributes(
          @classroom,
          attributes: %i[id name grades_display archived trading_enabled school_year created_at updated_at]
        ) %>

    <%= render layout: "components/ui/card",
               locals: { title: "Students (#{@classroom.students.count})" } do %>
      <% if @classroom.students.any? %>
        <ul class="space-y-2">
          <% @classroom.students.limit(10).each do |student| %>
            <li class="text-sm text-slate-900"><%= student.username %></li>
          <% end %>
          <% if @classroom.students.count > 10 %>
            <li class="text-sm text-slate-600">
              ... and <%= @classroom.students.count - 10 %> more
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-600">No students in this classroom yet.</p>
      <% end %>
    <% end %>

    <%= render layout: "components/ui/card", locals: { title: "Teachers" } do %>
      <% if @classroom.teachers.any? %>
        <ul class="space-y-2">
          <% @classroom.teachers.each do |teacher| %>
            <li class="text-sm text-slate-900"><%= teacher.username %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-600">No teachers assigned to this classroom yet.</p>
      <% end %>
    <% end %>
  </div>

  <div class="mt-6 flex gap-3">
    <%= link_to "Back to classrooms", admin_classrooms_path, class: admin_secondary_button_class %>
  </div>
</div>
