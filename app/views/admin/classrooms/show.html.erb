<div class="max-w-7xl mx-auto">
  <%= admin_breadcrumbs(@breadcrumbs) %>

  <div class="bg-white shadow-sm ring-1 ring-slate-900/5 rounded-lg mb-6">
    <div class="px-6 py-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-slate-900"><%= @classroom.name %></h2>
        <div class="flex gap-3">
          <%= link_to edit_admin_classroom_path(@classroom),
                      class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50" do %>
            <%= lucide_icon("square-pen", class: "-ml-1 mr-2 h-5 w-5 text-slate-500 shrink-0") %>
            Edit
          <% end %>
          <%= classroom_archive_toggle_button(@classroom) %>
          <%= link_to admin_classroom_path(@classroom),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this classroom?" },
                      class: "inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50" do %>
            <%= lucide_icon("trash-2", class: "-ml-1 mr-2 h-5 w-5 text-red-500 shrink-0") %>
            Delete
          <% end %>
        </div>
      </div>

      <%= admin_show_attributes(
            @classroom,
            attributes: %i[id name grades_display archived trading_enabled school_year created_at updated_at]
          ) %>

      <!-- Associated Students -->
      <% if @classroom.students.any? %>
        <div class="mt-6 pt-6 border-t border-slate-200">
          <h3 class="text-sm font-medium text-slate-500 mb-3">Students (<%= @classroom.students.count %>)</h3>
          <ul class="space-y-2">
            <% @classroom.students.limit(10).each do |student| %>
              <li class="text-sm text-slate-900">
                <%= student.username %>
              </li>
            <% end %>
            <% if @classroom.students.count > 10 %>
              <li class="text-sm text-slate-500">
                ... and <%= @classroom.students.count - 10 %> more
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="mt-6 pt-6 border-t border-slate-200">
          <p class="text-sm text-slate-500">No students in this classroom yet.</p>
        </div>
      <% end %>

      <!-- Associated Teachers -->
      <% if @classroom.teachers.any? %>
        <div class="mt-6 pt-6 border-t border-slate-200">
          <h3 class="text-sm font-medium text-slate-500 mb-3">Teachers</h3>
          <ul class="space-y-2">
            <% @classroom.teachers.each do |teacher| %>
              <li class="text-sm text-slate-900">
                <%= teacher.username %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="mt-6 pt-6 border-t border-slate-200">
          <p class="text-sm text-slate-500">No teachers assigned to this classroom yet.</p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= link_to "Back to classrooms", admin_classrooms_path,
                class: "inline-flex items-center px-4 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50" %>
  </div>
</div>
