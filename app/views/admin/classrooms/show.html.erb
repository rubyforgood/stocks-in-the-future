<%= render layout: "admin/shared/record_page",
           locals: { title: @classroom.name, breadcrumbs: @breadcrumbs,
                     description: classroom_summary(@classroom),
                     badge: classroom_status_badge(@classroom),
                     actions: capture { classroom_archive_toggle_button(@classroom) } } do %>
  <%# **No attribute card, and no "Teachers" card.** The form edits the name, the school year, the grades and
      `teacher_ids`, so all four were being displayed a second time on a page where they could not be changed.
      Which teachers are assigned is the form's checkbox group.

      **No Delete**, and that predates the merge: it posted `DELETE` to a route that does not exist -
      `resources :classrooms, except: [:destroy]` - so it 404'd every time for as long as it had existed. Nor
      should it exist: a classroom holds grade books and a roster, and `Classroom#users` is `dependent:
      :nullify`, so deleting one would cut every student loose from their class. Archive is the reversible
      action, and it is the header's. %>
  <%= render layout: "admin/shared/record_section",
             locals: { title: "Details", hint: "Moving a class to another school year gives it that year's four grade books." } do %>
    <%= render "classrooms/form",
               classroom: @classroom,
               url: admin_classroom_path(@classroom),
               cancel_path: admin_classroom_path(@classroom) %>
  <% end %>

  <%# The roster: a collection worth scanning, and the reason somebody opens a classroom. Read-only here - a
      student is added from the teacher's own classroom page, which has the flow for it. %>
  <%= render layout: "admin/shared/record_section", locals: { title: "Students" } do %>
    <%= render layout: "components/ui/card", locals: {} do %>
      <% if @students.any? %>
        <ul class="divide-y divide-slate-100">
          <% @students.each do |student| %>
            <li class="py-2 text-sm">
              <%= link_to student.display_name.presence || student.username,
                          admin_student_path(student), class: "tw-link" %>
            </li>
          <% end %>
        </ul>

        <%# A truncated list has to say so, or "ten students" reads as the whole roster. %>
        <% if @classroom.students.size > @students.size %>
          <p class="mt-3 text-xs text-slate-600">
            Showing <%= @students.size %> of <%= @classroom.students.size %>.
          </p>
        <% end %>
      <% else %>
        <p class="text-sm text-slate-600">No students in this classroom yet.</p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
