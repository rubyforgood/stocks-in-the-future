<% content_for :title, "Forgot your password" %>

<%# Mirrors devise/sessions/new so the two auth screens stay consistent. %>
<% link_class = "font-semibold text-sitf-primary underline hover:text-sitf-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary rounded-sm" %>

<div class="flex min-h-full flex-col justify-center py-12">
  <div class="mx-auto w-full max-w-sm">
    <div class="flex w-full justify-center">
      <%= image_tag "SITF-caponly-Logo.svg", class: "h-8 w-auto", alt: "Stocks in the Future" %>
    </div>

    <h1 class="text-center text-2xl/9 font-bold tracking-tight text-slate-900 pb-4">Forgot your password?</h1>
    <p class="text-center text-sm text-slate-600 pb-4">Reset instructions are sent to the email address
      on your account.</p>

    <% opts = { as: resource_name, url: password_path(resource_name), builder: Ui::FormBuilder,
                html: { method: :post } } %>
    <%= form_for(resource, **opts) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.email_field :email,
                          label: "Email address",
                          autofocus: true,
                          autocomplete: "email",
                          required: true %>

        <%= f.submit "Send reset link", class: "tw-btn-primary w-full" %>
      </div>
    <% end %>

    <p class="mt-6 text-center text-sm text-slate-600">
      <%= link_to "Back to sign in", new_session_path(resource_name), class: link_class %>
    </p>
  </div>
</div>
