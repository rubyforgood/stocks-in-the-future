<% content_for :title, "Forgot your password" %>

<%# Mirrors devise/sessions/new so the two auth screens stay consistent. %>
<% field_class = "block w-full min-h-11 rounded-md bg-white px-3 py-2 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-sitf-primary" %>
<% label_class = "block text-sm font-medium text-gray-900 mb-1" %>
<% submit_class = "flex w-full min-h-11 items-center justify-center rounded-md bg-sitf-primary px-3 py-2 text-sm/6 font-semibold text-sitf-on-primary shadow-xs hover:bg-sitf-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary-dark cursor-pointer" %>
<% link_class = "font-semibold text-sitf-primary underline hover:text-sitf-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary rounded-sm" %>

<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="mx-auto w-full max-w-sm">
    <div class="flex w-full justify-center">
      <%= image_tag "SITF-caponly-Logo.svg", class: "h-8 w-auto", alt: "Stocks in the Future" %>
    </div>

    <h1 class="text-center text-2xl/9 font-bold tracking-tight text-gray-900 pb-4">Forgot your password?</h1>
    <p class="text-center text-sm text-gray-600 pb-4">Enter your email and we'll send you reset instructions.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-4">
        <div>
          <%= f.label :email, "Email address", class: label_class %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: field_class %>
        </div>

        <%= f.submit "Send me reset password instructions", class: submit_class %>
      </div>
    <% end %>

    <p class="mt-6 text-center text-sm text-gray-600">
      <%= link_to "Back to sign in", new_session_path(resource_name), class: link_class %>
    </p>
  </div>
</div>
