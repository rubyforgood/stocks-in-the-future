<%# Reached from a reset email. Was raw generator output: an <h2> with no page heading above it,
    div.field wrappers, <br> tags for layout and fields with no classes at all - the browser's
    default input beside the app's own. On the shared page header and the named field classes now. %>
<% content_for :title, "Change your password" %>

<div class="mx-auto w-full max-w-md">
  <%= render layout: "components/ui/page_header",
             locals: { title: "Change your password" } do %><% end %>

  <div class="tw-card p-5">
    <% opts = { as: resource_name, url: password_path(resource_name), builder: Ui::FormBuilder,
                html: { method: :put } } %>
    <%= form_for(resource, **opts) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <% length_hint = "#{@minimum_password_length} characters minimum" if @minimum_password_length %>
      <%= f.password_field :password,
                           label: "New password",
                           required: true,
                           autofocus: true,
                           autocomplete: "new-password",
                           hint: length_hint %>

      <%= f.password_field :password_confirmation,
                           label: "Confirm new password",
                           required: true,
                           autocomplete: "new-password" %>

      <%= f.submit "Change password", class: "tw-btn-primary w-full" %>
    <% end %>
  </div>

  <div class="mt-4 text-center">
    <%= render "devise/shared/links" %>
  </div>
</div>
