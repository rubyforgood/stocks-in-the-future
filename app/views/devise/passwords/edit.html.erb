<%# Reached from a reset email. Was raw generator output: an <h2> with no page heading above it,
    div.field wrappers, <br> tags for layout and fields with no classes at all - the browser's
    default input beside the app's own. On the shared page header and the named field classes now. %>
<% content_for :title, "Change your password" %>

<div class="mx-auto w-full max-w-md py-6">
  <%= render layout: "components/ui/page_header",
             locals: { title: "Change your password" } do %><% end %>

  <div class="tw-card p-6">
    <%= form_for(
          resource,
          as: resource_name,
          url: password_path(resource_name),
          html: { method: :put },
          class: "space-y-5"
        ) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "New password", class: "tw-label-primary mb-1" %>
        <%= f.password_field :password,
                             autofocus: true,
                             autocomplete: "new-password",
                             class: "tw-input-primary" %>
        <% if @minimum_password_length %>
          <p class="tw-field-hint"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "tw-label-primary mb-1" %>
        <%= f.password_field :password_confirmation,
                             autocomplete: "new-password",
                             class: "tw-input-primary" %>
      </div>

      <%= f.submit "Change my password", class: "tw-btn-primary w-full" %>
    <% end %>
  </div>

  <div class="mt-4 text-center">
    <%= render "devise/shared/links" %>
  </div>
</div>
