<% content_for :title, "Sign in" %>

<div class="flex min-h-full flex-col justify-center py-12">
  <div class="mx-auto w-full max-w-sm">
    <div class="flex w-full justify-center">
      <%= image_tag "SITF-caponly-Logo.svg", class: "h-8 w-auto", alt: "Stocks in the Future" %>
    </div>

    <h1 class="text-center text-2xl/9 font-bold tracking-tight text-slate-900 pb-4">Sign in to your account</h1>

    <%= render_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :username, class: "mb-1" %>
          <%= f.text_field :username, autocomplete: "username", required: true %>
        </div>

        <div>
          <%= f.label :password, class: "mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password", required: true %>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2">
          <% if devise_mapping.rememberable? %>
            <%= render_checkbox name: "user[remember_me]", label: "Remember me" %>
          <% end %>

          <%= link_to "Forgot your password?", new_password_path(resource_name), class: "tw-link-tap" %>
        </div>

        <%= f.submit "Sign in", class: "w-full" %>
      </div>
    <% end %>
  </div>
</div>
