<div class="w-full">

  <% if current_user.student? && !current_user.classroom&.trading_enabled? %>
    <%= render "components/ui/callout",
               title: "Trading is turned off for your classroom",
               body: "You cannot buy or sell right now. Your teacher can turn it back on.",
               class: "mb-5" %>
  <% end %>

  <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 pt-4 mb-6">
    <%# design.md page-title scale. Was text-4xl, which outweighed every other
        heading in the app. %>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Trading floor</h1>
    <%# show_holdings? on its own. The `|| current_user.student?` that used to be here widened
        this to students with no persisted portfolio, and the card dereferences @portfolio - which
        stocks#index only sets for a student who has one. A student without a portfolio got a 500
        on the trading floor, not a degraded page. %>
    <% if policy(Stock).show_holdings? %>
      <div class="w-full lg:w-auto">
        <%= render 'shared/earnings_to_invest_card' %>
      </div>
    <% end %>
  </div>

  <%# Was a second <main>. The layout already provides one, and a document may only
      have a single main landmark. Titles were Title Case - another hiding place
      the copy sweeps could not see, since they are keyword arguments to render. %>
  <div class="space-y-6">
    <%= render "stocks/stocks_table", title: "Active stocks", stocks: @stocks.active %>
    <%= render "stocks/stocks_table", title: "Archived stocks", stocks: @stocks.archived %>
  </div>
</div>
