<%# design.md section-title scale: text-base font-semibold. Was text-2xl, the same
    size as the page h1. %>
<h2 class="mb-3 text-base font-semibold text-slate-900"><%= title %></h2>
<%= render "shared/table_container" do %>
  <thead>
    <tr class="table-header-row">
      <th scope="col" class="table-header-cell table-header-cell-left">Company (Exchange)</th>
      <th scope="col" class="table-header-cell table-header-cell-right">Last price</th>
      <% if current_user.student? %>
        <th scope="col" class="table-header-cell table-header-cell-left">Your holdings</th>
        <th scope="col" class="table-header-cell table-header-cell-center" colspan="2"></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% if stocks.any? %>
      <% stocks.each do |stock| %>
        <%= render "stocks/index_row", stock: stock %>
      <% end %>
    <% else %>
      <%= render "admin/shared/empty_row",
                 colspan: current_user.student? ? 5 : 2,
                 icon: "chart-line",
                 title: "No #{title.downcase} to show",
                 body: "Stocks appear here once your teacher adds them." %>
    <% end %>
  </tbody>
<% end %>
