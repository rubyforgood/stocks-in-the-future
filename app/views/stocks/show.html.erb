<div class="min-h-full">
  <div class="max-w-7xl mx-auto py-6 space-y-6">
    <%# The flash used to be rendered again here, in a hand-rolled green panel, so a notice showed
        twice: once from layouts/_flash and once inside the page. design.md: only the layout renders
        the flash. %>

    <!-- Header with stock symbol and company name -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div class="flex items-center gap-3 min-w-0 flex-1">
        <div class="flex items-center gap-1 text-2xl flex-shrink-0"><span>📈📊</span></div>
        <div class="min-w-0 flex-1">
          <h1 class="text-2xl font-bold tracking-tight text-slate-900 truncate">
            <%= @stock.ticker %>
            <span class="font-normal text-slate-600 text-base lg:text-lg">| <%= @stock.company_name %></span>
          </h1>
          <% if @stock.archived? %>
            <span class="bg-red-100 text-red-800 text-sm font-medium px-3 py-1 rounded-full mt-2 inline-block">Archived</span>
          <% end %>
        </div>
      </div>
      <div class="flex gap-3 flex-shrink-0">
        <%# The destination's own h1 is "Trading floor", and so is its nav label. This said "stocks". %>
        <%= link_to "Back to trading floor", stocks_path, class: "tw-btn-secondary" %>
        <% if policy(@stock).show_trading_link? %>
          <%# "Trade", matching the portfolio table's row action, which goes to the same place. Note
              this and the back link above it share a destination - see design-todo. %>
          <%= link_to "Trade", stocks_path, class: "tw-btn-primary" %>
        <% end %>
      </div>
    </div>

    <%= render @stock %>

    <!-- Bottom spacing to ensure content doesn't get cut off -->
    <div class="h-8"></div>
  </div>
</div>
</div>
