<div class="max-w-2xl mx-auto px-4 lg:px-8">
  <h1 class="text-2xl font-bold text-slate-900 mb-6">Edit student</h1>

  <%= form_with model: [@classroom, @student], local: true, class: "space-y-6" do |f| %>
    <% if @student.errors.any? %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-smrelative" role="alert">
        <strong class="font-bold">Error:</strong>
        <ul>
          <% @student.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white shadow-sm overflow-hidden lg:rounded-md">
      <div class="px-4 py-5 lg:p-6">
        <div class="grid grid-cols-6 gap-6">
          <div class="col-span-6 lg:col-span-4">
            <%= f.label :username, class: "block text-sm font-medium text-slate-700" %>
            <%= f.text_field :username, class: "mt-1 block w-full shadow-xs lg:text-sm border-slate-300 rounded-md", required: true %>
          </div>
        </div>
      </div>
      <div class="px-4 py-3 bg-slate-50 text-right lg:px-6">
        <%= f.submit "Update student", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-xs text-sm font-medium rounded-md text-white bg-sitf-primary hover:bg-sitf-primary-dark focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus-visible:ring-sitf-primary" %>
        <%= link_to "Cancel", classroom_path(@classroom), class: "ml-3 inline-flex justify-center py-2 px-4 border border-slate-300 shadow-xs text-sm font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 focus:outline-hidden focus:ring-2 focus:ring-offset-2 focus-visible:ring-sitf-primary" %>
      </div>
    </div>
  <% end %>
</div>
