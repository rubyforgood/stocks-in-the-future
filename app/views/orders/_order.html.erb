<div id="<%= dom_id order %>" class="grid grid-cols-1 lg:grid-cols-4 gap-4 items-center">
  <div>
    <p class="text-sm text-slate-500 font-medium">Stock</p>
    <p class="text-lg font-semibold"><%= order.stock.company_name %></p>
    <p class="text-sm text-slate-600"><%= order.stock.ticker %></p>
  </div>

  <div>
    <p class="text-sm text-slate-500 font-medium">Shares</p>
    <p class="text-lg font-semibold"><%= order.shares %></p>
  </div>

  <div>
    <p class="text-sm text-slate-500 font-medium">Status</p>
    <%= render "components/ui/badge",
               label: order.status.capitalize,
               tone: order_status_tone(order) %>
  </div>

  <div>
    <p class="text-sm text-slate-500 font-medium">Total cost</p>
    <p class="text-lg font-semibold">
      <% if order.stock.price_cents && order.shares %>
        <%= number_to_currency(order.purchase_cost / 100.0) %>
      <% else %>
        <span class="text-slate-600">Price unavailable</span>
      <% end %>
    </p>
  </div>
</div>
