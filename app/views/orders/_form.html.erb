<%= form_with(
      model: order,
      class: "w-full max-w-md mx-auto",
      data: {
        controller: "order-form",
        order_form_current_price_value: order.stock.current_price,
        order_form_fee_value: order.transaction_fee / 100.0,
        turbo_frame: "_top"
      }
    ) do |form| %>

  <!-- Error Messages -->
  <% if order.errors.any? %>
    <div class="mb-6 p-4 bg-sitf-danger/10 border border-sitf-danger/20 rounded-lg">
      <h4 class="text-red-700 font-medium mb-2">
        Please fix the following errors:
      </h4>
      <ul class="text-red-700 text-sm space-y-1">
        <% order.errors.each do |error| %>
          <li>• <%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Header -->
  <div class="text-center mb-6">
    <h2 class="text-2xl font-bold text-slate-900 mb-1">
      <%= order.action&.titlecase %> <%= order.stock.ticker %>
    </h2>
    <p class="text-slate-600">
      <%= number_to_currency(order.stock.current_price) %> per share
    </p>
  </div>

  <!-- Account Info -->
  <div class="grid grid-cols-2 gap-4 mb-6">
    <div class="bg-teal-700/10 border border-teal-700/20 p-4 rounded-lg text-center">
      <p class="text-sm text-teal-700 font-medium mb-1">
        Available Cash
      </p>
      <p class="font-semibold text-black">
        <%= number_to_currency(current_user&.portfolio&.cash_balance) %>
      </p>
    </div>
    <div class="bg-sitf-ring/10 border border-sitf-ring/20 p-4 rounded-lg text-center">
      <%# violet-500 measured 4.23:1 on this near-white panel and failed AA; violet-700 is 7.10:1. %>
      <p class="text-sm text-violet-700 font-medium mb-1">
        Shares Owned
      </p>
      <p class="font-semibold text-black" data-testid="shares-owned-value">
        <%= shares_owned %>
      </p>
    </div>
  </div>

  <!-- Shares Input -->
  <div class="mb-6">
    <%= form.label :shares,
                   "Number of shares",
                   class: "block text-sm font-medium text-black mb-2" %>
    <%= form.number_field :shares,
                          min: 1,
                          step: 1,
                          required: true,
                          placeholder: "Enter quantity",
                          class: "w-full min-h-11 px-4 py-3 text-lg border-2 border-slate-500 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-sitf-primary focus:border-sitf-primary",
                          data: {
                            order_form_target: "shares",
                            action: "input->order-form#calculateTotal"
                          } %>
  </div>

  <%# Order summary, itemised.

      Previously this showed a single "Total Cost" of shares x price, with the
      trading fee mentioned only as fine print underneath - so the figure the
      student saw was not the amount they were charged. The server validates
      against purchase_cost + transaction_fee, so the two disagreed.

      The fee is charged once while an order is outstanding, not per order, so
      it shows as zero when another pending order has already incurred it. %>
  <% fee_cents = order.transaction_fee %>
  <% buying = order.action == "buy" %>
  <div class="mb-6 rounded-lg border border-slate-200 bg-slate-50 p-4">
    <dl class="space-y-2 text-sm">
      <div class="flex items-center justify-between">
        <dt class="text-slate-600"><%= buying ? "Shares" : "Proceeds" %> subtotal</dt>
        <dd class="font-medium text-slate-900 tabular-nums" data-order-form-target="subtotal">$0.00</dd>
      </div>

      <div class="flex items-center justify-between">
        <dt class="text-slate-600">
          Trading fee
          <% if fee_cents.zero? %>
            <span class="text-slate-500">(already charged)</span>
          <% end %>
        </dt>
        <dd class="font-medium text-slate-900 tabular-nums"><%= number_to_currency(fee_cents / 100.0) %></dd>
      </div>

      <div class="flex items-center justify-between border-t border-slate-200 pt-2">
        <dt class="font-semibold text-slate-900">Total <%= buying ? "cost" : "proceeds" %></dt>
        <dd class="text-xl font-bold text-slate-900 tabular-nums" data-order-form-target="totalCost">$0.00</dd>
      </div>
    </dl>

    <p class="mt-3 flex items-start gap-2 border-t border-slate-200 pt-3 text-xs text-slate-600">
      <%= lucide_icon("info", class: "h-4 w-4 shrink-0 text-slate-500") %>
      <span>The <%= number_to_currency(PortfolioTransaction::TRANSACTION_FEE_CENTS / 100.0) %> trading fee is charged once while you have an order outstanding, not once per order.</span>
    </p>
  </div>

  <!-- Hidden Fields -->
  <%= form.hidden_field :action, value: order.action %>
  <%= form.hidden_field :stock_id, value: order.stock.id %>

  <!-- Submit Button -->
  <div class="flex gap-3">
    <button type="button"
            class="flex-1 min-h-11 px-4 py-3 border border-slate-400 text-slate-600 font-medium rounded-lg hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary transition-colors cursor-pointer"
            data-action="click->modal#close">
      Cancel
    </button>
    <%= form.submit "#{order.action == 'buy' ? 'Buy' : 'Sell'} Shares",
                    class: "flex-1 px-4 py-3 #{order.action == 'buy' ? 'bg-teal-700 hover:bg-teal-800' : 'bg-amber-700 hover:bg-amber-800'} text-white font-medium rounded-lg min-h-11 transition-colors shadow-sm cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary" %>
  </div>

<% end %>
