<%= form_with(
      model: order,
      class: "w-full max-w-md mx-auto",
      data: {
        controller: "order-form",
        order_form_current_price_value: order.stock.current_price,
        order_form_fee_value: order.transaction_fee / 100.0,
        # Cents, divided once in the controller. Display only - the server
        # remains authoritative for whether the order is affordable.
        order_form_balance_cents_value: current_user&.portfolio&.cash_balance_cents.to_i,
        order_form_buying_value: order.action == "buy",
        turbo_frame: "_top"
      }
    ) do |form| %>

  <!-- Error Messages -->
  <% if order.errors.any? %>
    <%# The alert tokens - red-50 with a red-200 hairline - rather than sitf-danger at 10% and 20%
        opacity, which is red-500 tinted by transparency and lands somewhere off the scale. And a
        <p>, not an <h4>: it is a message, and there was no h3 above it to hang an h4 from. %>
    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4">
      <p class="mb-2 font-medium text-red-700">
        Please fix the following errors:
      </p>
      <ul class="space-y-1 text-sm text-red-700">
        <% order.errors.each do |error| %>
          <li>• <%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Title plus subtitle, which is the shape a card header already has, on the same
      text-base font-semibold token. It was text-2xl font-bold and centred, while the import
      dialog's title was text-lg font-medium - two modals, two title treatments, neither of them
      a token in this document. Left-aligned, because a dialog is read like anything else. %>
  <div class="mb-6 pr-10">
    <h2 class="text-base font-semibold text-slate-900">
      <%= order.action&.titlecase %> <%= order.stock.ticker %>
    </h2>
    <p class="mt-0.5 text-sm text-slate-600">
      <%= number_to_currency(order.stock.current_price) %> per share
    </p>
  </div>

  <!-- Account Info -->
  <div class="grid grid-cols-2 gap-4 mb-6">
    <%# Neutral, not hue-coded. This was bg-teal-700/10 with teal-700 ink and its neighbour was
        sitf-ring/10 with violet-700 - a mint panel beside an indigo one, colouring two account
        figures for no reason either colour carries. design.md hue-codes a KPI's *icon tile*, never
        the panel fill, and says a numeral is always slate-900 and never carries state. %>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-center">
      <p class="mb-1 text-sm font-medium text-slate-600">
        Available cash
      </p>
      <p class="font-semibold text-slate-900">
        <%= number_to_currency(current_user&.portfolio&.cash_balance) %>
      </p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 text-center">
      <p class="mb-1 text-sm font-medium text-slate-600">
        Shares owned
      </p>
      <p class="font-semibold text-slate-900" data-testid="shares-owned-value">
        <%= share_count(shares_owned) %>
      </p>
    </div>
  </div>

  <!-- Shares Input -->
  <div class="mb-6">
    <%# tw-label-primary and tw-input-primary, the named classes, rather than a hand-rolled pair.
        The label was text-black where the token is slate-900, and the input was border-2
        border-slate-500 at text-lg - a 2px border in a darker slate than the slate-300 token, and
        two steps up the type scale from every other field in the app. %>
    <%= form.label :shares, "Number of shares", class: "tw-label-primary mb-2" %>
    <%= form.number_field :shares,
                          min: 1,
                          step: 1,
                          required: true,
                          placeholder: "Enter quantity",
                          class: "tw-input-primary",
                          data: {
                            order_form_target: "shares",
                            action: "input->order-form#calculateTotal"
                          } %>
  </div>

  <%# Order summary, itemised.

      Previously this showed a single "Total cost" of shares x price, with the
      trading fee mentioned only as fine print underneath - so the figure the
      student saw was not the amount they were charged. The server validates
      against purchase_cost + transaction_fee, so the two disagreed.

      The fee is charged once while an order is outstanding, not per order, so
      it shows as zero when another pending order has already incurred it. %>
  <% fee_cents = order.transaction_fee %>
  <% buying = order.action == "buy" %>
  <div class="mb-6 rounded-lg border border-slate-200 bg-slate-50 p-4">
    <dl class="space-y-2 text-sm">
      <div class="flex items-center justify-between">
        <dt class="text-slate-600"><%= buying ? "Shares" : "Proceeds" %> subtotal</dt>
        <dd class="font-medium text-slate-900 tabular-nums" data-order-form-target="subtotal">$0.00</dd>
      </div>

      <div class="flex items-center justify-between">
        <dt class="text-slate-600">
          Daily trading fee
          <% if fee_cents.zero? %>
            <span class="text-slate-600">(already held today)</span>
          <% end %>
        </dt>
        <dd class="font-medium text-slate-900 tabular-nums"><%= number_to_currency(fee_cents / 100.0) %></dd>
      </div>

      <div class="flex items-center justify-between border-t border-slate-200 pt-2">
        <dt class="font-semibold text-slate-900">Total <%= buying ? "cost" : "proceeds" %></dt>
        <dd class="text-xl font-bold text-slate-900 tabular-nums" data-order-form-target="totalCost">$0.00</dd>
      </div>
    </dl>

    <p class="mt-3 flex items-start gap-2 border-t border-slate-200 pt-3 text-xs text-slate-600">
      <%= lucide_icon("info", class: "h-4 w-4 shrink-0 text-slate-500") %>
      <%# Accurate about the mechanism: the amount is held now and charged when the
          orders run, once for the day however many trades you place. Calling it a
          per-trade fee would misdescribe it, and "bundle your trades" is the
          lesson the batching is there to teach. %>
      <span>The <%= number_to_currency(PortfolioTransaction::TRANSACTION_FEE_CENTS / 100.0) %> daily trading fee is held now and charged once when your orders go through &mdash; once for the day, however many trades you place.</span>
    </p>
  </div>

  <!-- Hidden Fields -->
  <%= form.hidden_field :action, value: order.action %>
  <%= form.hidden_field :stock_id, value: order.stock.id %>

  <%# Review step.

      A trade is hard to undo once executed, so it gets a confirmation rather
      than submitting straight from the input. Error prevention over error
      messages: the student sees what they are about to do, including the figure
      that was previously nowhere in the flow - what their balance will be
      afterwards.

      Hidden until the review button is pressed. The controller moves focus here
      and back, so this is reachable by keyboard. %>
  <div class="mb-6 hidden rounded-lg border border-slate-200 bg-slate-50 p-4"
       data-order-form-target="review"
       role="group"
       aria-labelledby="review-heading"
       tabindex="-1">
    <h3 id="review-heading" class="text-sm font-semibold text-slate-900">Check this is right</h3>

    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex items-center justify-between">
        <dt class="text-slate-600">Action</dt>
        <dd class="font-medium text-slate-900">
          <%= buying ? "Buy" : "Sell" %> <%= order.stock.ticker %>
        </dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-slate-600">Shares</dt>
        <dd class="font-medium text-slate-900 tabular-nums" data-order-form-target="reviewShares">0</dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-slate-600">Price each</dt>
        <dd class="font-medium text-slate-900 tabular-nums"><%= number_to_currency(order.stock.current_price) %></dd>
      </div>
      <div class="flex items-center justify-between border-t border-slate-200 pt-2">
        <dt class="font-semibold text-slate-900">Total <%= buying ? "cost" : "proceeds" %></dt>
        <dd class="font-bold text-slate-900 tabular-nums" data-order-form-target="reviewTotal">$0.00</dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-slate-600">Balance afterwards</dt>
        <dd class="font-medium text-slate-900 tabular-nums" data-order-form-target="reviewBalance">$0.00</dd>
      </div>
    </dl>

    <%# At review time nothing has been charged yet - the order is placed as
        pending, and both the share cost and the fee are held until the orders run.
        Saying so avoids implying the money has already moved. %>
    <p class="mt-3 border-t border-slate-200 pt-3 text-xs text-slate-600">
      Placing this order holds the amount above. Nothing is charged until your orders go through.
    </p>

    <p class="mt-3 hidden items-start gap-2 rounded-lg bg-red-50 p-2 text-xs text-red-800"
       data-order-form-target="reviewWarning"
       role="status">
      That is more than you have available. Lower the number of shares.
    </p>
  </div>

  <%# No min-h-11 here. It overrode .tw-btn-*'s h-10, so these four were the only 44px buttons in
      the app that are not bare tap targets - design.md reserves 44px for controls with no other
      affordance, and a labelled dialog button is not one. %>
  <div class="flex gap-3">
    <button type="button"
            class="tw-btn-secondary flex-1"
            data-order-form-target="cancelButton"
            data-action="click->modal#close">
      Cancel
    </button>

    <button type="button"
            class="tw-btn-secondary flex-1 hidden"
            data-order-form-target="backButton"
            data-action="click->order-form#backToEdit">
      Back
    </button>

    <button type="button"
            class="tw-btn-primary flex-1"
            data-order-form-target="reviewButton"
            data-action="click->order-form#showReview">
      Review order
    </button>

    <%# "Buy Shares" was Title Case. It is interpolated, so no earlier sentence-case pass
        could see it as a literal. %>
    <%= form.submit "#{buying ? 'Buy' : 'Sell'} shares",
                    data: { order_form_target: "submitButton" },
                    class: "tw-btn-primary flex-1 hidden" %>
  </div>

<% end %>
