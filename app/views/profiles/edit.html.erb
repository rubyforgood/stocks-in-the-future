<% content_for :title, "Your profile" %>

<%# `scope: :user` on both forms is load-bearing. User is an STI base, so form_with derives the
    param key from the record's class: a Student posted `student[name]` and a Teacher
    `teacher[name]`, while the controller expects `user`, and params.expect raised
    ParameterMissing -> 400 for every submit.

    It is `scope:`, not `as:`. `as:` is form_for's keyword; form_with accepts it silently into
    **options and keeps deriving the scope from the model, so the fix looks applied and changes
    nothing. The rendered input names are the only proof.

    A controller test that hand-writes `params: { user: ... }` cannot catch any of this: it agrees
    with the controller rather than with the browser. Only clicking the button did.

    Two forms, because the two changes have different costs. A display name should not require
    proving your password; a password change must. GitHub, Stripe and Linear all split them the
    same way, and it is the specific complaint design-todo recorded about Devise's
    registrations#edit - which demanded the current password before it would save anything.

    Username is shown, not edited. It is what a student signs in with and a teacher assigns it. %>
<div class="mx-auto w-full max-w-2xl space-y-6">
  <%= render layout: "components/ui/page_header",
             locals: { title: "Your profile",
                       description: "How your name appears, and your password." } do %><% end %>

  <%= render layout: "components/ui/card", locals: { title: "Your details" } do %>
    <%= form_with model: @user, scope: :user, url: profile_path, method: :patch, class: "space-y-5" do |f| %>
      <%= render "profiles/errors", user: @user, on: %i[name email] %>

      <div>
        <%= f.label :name, "Display name", class: "tw-label-primary mb-1" %>
        <%= f.text_field :name, autocomplete: "name", class: "tw-input-primary" %>
        <p class="tw-field-hint">
          Shown on your portfolio and in the account menu. Leave it blank to use your username.
        </p>
      </div>

      <div>
        <%= f.label :email, "Email address", class: "tw-label-primary mb-1" %>
        <%= f.email_field :email, autocomplete: "email", class: "tw-input-primary" %>
        <p class="tw-field-hint">
          <%= current_user.email_required? ? "Used to reset your password." : "Optional. Used to reset your password if you have one." %>
        </p>
      </div>

      <div>
        <%# Read-only rather than disabled: a disabled field is skipped by keyboard navigation, so
            the value a student needs to remember becomes unreachable. %>
        <%= f.label :username, "Username", class: "tw-label-primary mb-1" %>
        <%= f.text_field :username, readonly: true, class: "tw-input-primary bg-slate-50 text-slate-600" %>
        <p class="tw-field-hint">You sign in with this. Ask your teacher if it needs to change.</p>
      </div>

      <%= f.submit "Save details", class: "tw-btn-primary" %>
    <% end %>
  <% end %>

  <%= render layout: "components/ui/card", locals: { title: "Password" } do %>
    <%= form_with model: @user, scope: :user, url: password_profile_path, method: :patch, class: "space-y-5" do |f| %>
      <%= render "profiles/errors", user: @user, on: %i[current_password password password_confirmation] %>

      <div>
        <%= f.label :current_password, "Current password", class: "tw-label-primary mb-1" %>
        <%= f.password_field :current_password,
                             autocomplete: "current-password",
                             class: "tw-input-primary" %>
      </div>

      <div>
        <%= f.label :password, "New password", class: "tw-label-primary mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "tw-input-primary" %>
        <% if @minimum_password_length %>
          <p class="tw-field-hint"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "tw-label-primary mb-1" %>
        <%= f.password_field :password_confirmation,
                             autocomplete: "new-password",
                             class: "tw-input-primary" %>
      </div>

      <%# Secondary, not primary: design.md allows one filled primary per page and "Save details"
          above is this page's main action. A second card's submit is the sub-form case. %>
      <%= f.submit "Change password", class: "tw-btn-secondary" %>
    <% end %>
  <% end %>
</div>
