<%= turbo_frame_tag @grade_book do %>
  <%# This is a standalone page at /classrooms/:id/grade_books/:id, and it had no
      h1 at all - its only heading was an h3. Every page needs exactly one h1, and
      the quarter it belongs to is the thing that identifies it.

      The wrapper's data attributes are conditional, so the opening tag is built in
      one expression rather than split across an `if`, which previously left an
      unterminated tag mid-template. %>
  <% autosave = @grade_book.completed? ? {} : { controller: "autosave", autosave_interval_value: 30_000 } %>

  <%= tag.div data: autosave do %>
    <%# The quarter is the title. "Grade book" identified nothing - every grade book is one, and the
        page's accessible name was the same on all four - so the quarter leads and the classroom is the
        description, which is what classrooms#show does with name and meta.

        The status is on the page for the first time. It is a real enum the classroom list now shows on
        every row, and the page it links to did not say which state it was in - so a teacher could see
        "Completed" in the list and find no confirmation of it here. A pill against the title is where
        every system puts entity state. %>
    <% grade_book_subtitle = [@classroom.name, "grade book"].compact.join(" ") %>
    <% status_tones = { "draft" => :neutral, "verified" => :info, "completed" => :success } %>
    <%= render layout: "components/ui/page_header",
               locals: { title: @grade_book.quarter&.name || "Grade book",
                         description: grade_book_subtitle } do %>
      <%= render "components/ui/badge",
                 label: @grade_book.status.capitalize,
                 tone: status_tones.fetch(@grade_book.status, :neutral) %>
    <% end %>

    <%# A completed grade book has already paid out, so there is nothing to add to it. %>
    <% can_populate = policy(@grade_book).populate? && !@grade_book.completed? %>
    <% entries = @grade_book.grade_entries.any? %>
    <%# One instance for the page: the rows, the footer total and the finalize block all read from it,
        and it fetches the previous quarter's entries once rather than per student. %>
    <% earnings = GradeBookEarnings.new(@grade_book) if entries %>

    <%# What the columns pay, which the table never said. "Perfect attendance" as a bare checkbox
        headed by two words gave a teacher no way to know whether it was required, what it was worth, or
        why it sits beside a day count - reported as the column not making sense. It is a flat bonus on
        top of the per-day rate.

        Every figure is interpolated from GradeEntry's constants rather than written out, so the sentence
        cannot claim one rate while the model pays another. %>
    <div class="mb-3">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-base font-semibold text-slate-900">Student grades</h2>

      <div class="flex items-center gap-4">
        <%# Announced politely so a screen reader hears "Saving" without losing focus. %>
        <div data-autosave-target="status" role="status" aria-live="polite" class="text-sm text-slate-600"></div>

        <% if entries && can_populate %>
          <%= render partial: "populate_button", locals: { label: "Add new students", button_class: "tw-btn-secondary" } %>
        <% end %>
        </div>
      </div>

      <% if entries %>
        <p class="mt-1 text-sm text-slate-600">
          Each day attended earns
          <%= number_to_currency(GradeEntry::EARNINGS_PER_DAY_ATTENDANCE / 100.0) %>, and perfect
          attendance adds a <%= number_to_currency(GradeEntry::EARNINGS_FOR_PERFECT_ATTENDANCE / 100.0) %>
          bonus on top. An A earns <%= number_to_currency(GradeEntry::EARNINGS_FOR_A_GRADE / 100.0) %>
          and a B <%= number_to_currency(GradeEntry::EARNINGS_FOR_B_GRADE / 100.0) %>, per subject, with
          <%= number_to_currency(GradeEntry::EARNINGS_FOR_IMPROVED_GRADE / 100.0) %> more for a grade that
          improved on last quarter.
        </p>
      <% end %>
    </div>

    <%# The populate buttons stay outside this form. A form cannot be nested inside
        another - the browser drops the inner one - so a button_to placed within the
        grades form would silently submit the grades instead of adding students. %>
    <%# The summary half of the warning. An entry claiming the perfect-attendance bonus with no days
        recorded is incoherent whatever the quarter's length, so it can be said without knowing how many
        school days there were - the number this app does not store. Pairs with the inline marker under
        the field, which is the shape this app already uses for form errors: a summary plus a
        field-level note. Renders only when there is something to say. %>
    <% if entries && earnings.unattended_bonus? %>
      <% affected = earnings.unattended_bonus_entries %>
      <div class="mb-6">
        <%= render "components/ui/callout",
                   title: "#{pluralize(affected.size, 'student')} set to be paid a bonus with no attendance recorded",
                   body: "#{affected.map { |e| e.user.display_name }.to_sentence} " \
                         "#{affected.one? ? 'is' : 'are'} marked as having perfect attendance but " \
                         "#{affected.one? ? 'has' : 'have'} no days entered. Finalizing pays the " \
                         "#{number_to_currency(GradeEntry::EARNINGS_FOR_PERFECT_ATTENDANCE / 100.0)} " \
                         "bonus anyway." %>
      </div>
    <% end %>

    <% if entries %>
      <%= form_with model: [@classroom, @grade_book],
                    url: classroom_grade_book_path(@classroom, @grade_book),
                    method: :patch,
                    html: { data: { autosave_target: "form" } } do %>

        <%= render partial: "table", locals: { grade_book: @grade_book, grade_book_earnings: earnings } %>

        <%# Left-aligned, not centred. Nothing else in the app centres a form action - the classroom
            form puts its submit on the left - and Polaris, Primer and Tailwind UI all anchor form
            actions to the form's leading edge or to a footer bar, never to its centre. This was one of
            two centred stacks on the page. %>
        <div class="mt-6">
          <%= render partial: "submit_button" %>
        </div>
      <% end %>
    <% else %>
      <div class="tw-card">
        <%= render layout: "components/ui/empty_state",
                   locals: { icon: "users",
                             title: "No students yet",
                             body: "Add the students in this class to start entering grades." } do %>
          <% if can_populate %>
            <%= render partial: "populate_button", locals: { label: "Add this class's students", button_class: "tw-btn-primary" } %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# Finalizing pays the students, and it cannot be undone - so it says so, next to the control,
        rather than being a second filled primary floating at the foot of the page. Same reasoning as
        the trading setting: the consequence belongs in the copy, never in the control.

        `:secondary`, because design.md allows one filled primary per page and "Save grades" is it.
        Irreversibility is carried by the sentence and by the existing turbo_confirm, not by making the
        button red - a red button at rest is an always-on alarm. %>
    <% if current_user.admin? && entries && !@grade_book.completed? %>
      <%# The action sits at the bottom, after the copy and the figures it acts on. That is the reading
          order every section pattern uses for a consequential action - GitHub's danger zone, Stripe's
          section footers - and it was floated to the right of the copy before.

          The total appears here and in the table footer and in the confirmation, each doing a different
          job: the footer is the working figure, this is the decision, the confirmation is the
          commitment. The split by reason is here rather than in the footer because it matters once. %>
      <section class="tw-card mt-6 p-5" aria-labelledby="finalize-heading">
        <p id="finalize-heading" class="text-sm font-medium text-slate-900">Finalize this quarter</p>
        <p class="mt-1 max-w-2xl text-sm text-slate-600">
          Pays <span class="font-medium text-slate-900"><%= number_to_currency(earnings.total_cents / 100.0) %></span>
          to <%= pluralize(earnings.student_count, "student") %> and locks these entries.
          This cannot be undone.
        </p>

        <dl class="mt-3 max-w-xs space-y-1 text-sm">
          <% { attendance: "Attendance", math: "Math", reading: "Reading" }.each do |key, label| %>
            <div class="flex justify-between gap-4">
              <dt class="text-slate-600"><%= label %></dt>
              <dd class="tabular-nums text-slate-900">
                <%= number_to_currency(earnings.totals_by_reason[key] / 100.0) %>
              </dd>
            </div>
          <% end %>
        </dl>

        <div class="mt-5">
          <%= render partial: "finalize_button", locals: { earnings: earnings } %>
        </div>
      </section>
    <% end %>
  <% end %>
<% end %>
