<%# The call site does not render this for a finalized grade book, so there is no disabled variant:
    a control that can never act is not shown at all. The id stays because the autosave response
    replaces this by id. %>
<div id="submit-button">
  <%= button_tag "Save grades",
                 type: "submit",
                 class: "tw-btn-primary",
                 data: { autosave_target: "button" } %>
</div>
