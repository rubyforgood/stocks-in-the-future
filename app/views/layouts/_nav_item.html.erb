<%# One sidebar navigation link. Render with `layout:` and pass the icon as a block.

    Locals:
      path   - link target
      label  - visible text
      active - true when this is the current page

    The wrapping <label for="mobile-menu-toggle"> closes the mobile menu on tap;
    that is the CSS-only menu mechanism, so it must stay.

    aria-current="page" is what conveys "you are here" to assistive tech - the
    accent fill alone would violate WCAG 1.4.1. Minimum height is 44px per
    docs/responsive-design-guidelines.md. %>
<li>
  <label for="mobile-menu-toggle" class="block lg:cursor-default cursor-pointer">
    <%= link_to path, aria: { current: ("page" if active) }, class: "flex items-center gap-3 min-h-11 px-3 py-3 rounded-lg w-full hover:bg-black/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white #{active ? 'bg-sitf-accent text-sitf-on-accent' : 'text-sitf-on-primary'}" do %>
      <span class="flex w-6 h-6 shrink-0 items-center justify-center" aria-hidden="true"><%= yield %></span>
      <span class="font-medium text-sm"><%= label %></span>
    <% end %>
  </label>
</li>
