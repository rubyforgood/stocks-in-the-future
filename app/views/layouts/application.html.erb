<!DOCTYPE html>
<html lang="en">
  <head>
    <%# Per-page titles: set with `content_for :title` in a view.
        WCAG 2.4.2 - each page needs a title describing its topic. %>
    <title><%= content_for?(:title) ? "#{yield(:title)} | Stocks in the Future" : "Stocks in the Future" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, 'data-turbo-track': "reload" %>
    <%= stylesheet_link_tag "actiontext", 'data-turbo-track': "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-sitf-surface">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:rounded-md focus:bg-sitf-primary focus:px-4 focus:py-2 focus:text-sitf-on-primary focus:outline-2 focus:outline-offset-2 focus:outline-sitf-primary-dark">Skip to main content</a>
    <% if user_signed_in? %>
      <%# shadow-xs, not a rule. The bar is fixed and the same colour as the page, so it
          needs some cue that content passes beneath it; a very low shadow reads as a layer
          rather than as a divider. What was here was a full-width 1px bar in
          sitf-primary-dark - an 8.5:1 dark line across the page, far heavier than chrome. %>
      <header class="fixed top-0 left-0 w-full z-50 flex items-center justify-between py-4 px-6 h-16 bg-sitf-surface shadow-xs">
        <div class="flex items-center gap-4">
          <label
            for="mobile-menu-toggle"
            class="lg:hidden cursor-pointer flex items-center justify-center min-w-11 min-h-11 bg-sitf-primary text-sitf-on-primary rounded-lg hover:bg-sitf-primary-dark focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-sitf-primary-dark transition-colors"
            aria-label="Toggle navigation menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </label>
          <%= image_tag "SITF-Horz-no-tag-logo.svg", class: "h-8 w-auto", alt: "Stocks in The Future" %>
        </div>
        <div class="flex items-center gap-4">
          <div class="hidden lg:block">
            <%= render 'layouts/stock_ticker' %>
          </div>

          <%# Admin stays in the sidebar as navigation; the menu carries account actions. %>
          <% account_links = [] %>
          <% if current_user.portfolio && policy(current_user.portfolio).show? %>
            <%# Named portfolio_target, not portfolio_path: that is a real route helper and
                shadowing it here would be a trap for the next reader. %>
            <% portfolio_target = user_portfolio_path(current_user, current_user.portfolio) %>
            <% account_links << { label: "My portfolio", path: portfolio_target } %>
          <% end %>

          <%= render 'layouts/account_menu', extra_links: account_links %>
        </div>
      </header>

      <%= render 'layouts/navbar' %>

      <!-- Main: responsive margins and padding -->
      <main id="main-content" class="min-h-screen overflow-auto px-4 lg:px-6 ml-0 lg:ml-64 mt-16 pb-6 bg-sitf-surface">
        <%= render 'layouts/flash' %>

        <%= yield %>
      </main>
    <% else %>
      <%# Signed out there was no header at all, so the only route in was whatever page you
          happened to land on. The logo and one Sign in action, matching the signed-in bar. %>
      <header class="flex h-16 w-full items-center justify-between px-6 py-4 bg-sitf-surface shadow-xs">
        <%= link_to root_path, class: "inline-flex items-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary-dark" do %>
          <%= image_tag "SITF-Horz-no-tag-logo.svg", class: "h-8 w-auto", alt: "Stocks in The Future" %>
        <% end %>

        <% unless request.path == new_user_session_path %>
          <%= link_to "Sign in", new_user_session_path, class: "tw-btn-primary" %>
        <% end %>
      </header>

      <main id="main-content" class="min-h-screen overflow-auto p-6 bg-sitf-surface">
        <%= render 'layouts/flash' %>

        <%= yield %>
      </main>
    <% end %>

    <!-- Trading Modal -->
    <%= render 'shared/modal' %>
  </body>
</html>
