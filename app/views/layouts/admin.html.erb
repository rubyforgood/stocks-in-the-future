<!DOCTYPE html>
<html lang="en">
  <head>
    <%# Per-page title, derived from the last breadcrumb - the one without a path,
        which every admin controller already sets to the current page's label. Was
        a single static string on every admin page (WCAG 2.4.2), still using the
        old un-spaced brand name. %>
    <% admin_page_title = @breadcrumbs&.last&.dig(:label).presence || "Admin" %>
    <title><%= admin_page_title %> | Admin | Stocks in the Future</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, 'data-turbo-track': "reload" %>
    <%= stylesheet_link_tag "actiontext", 'data-turbo-track': "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50" data-controller="admin-sidebar">
    <!-- Admin Header -->
    <div class="fixed top-0 left-0 w-full z-50 bg-white border-b border-slate-200">
      <div class="flex items-center justify-between py-3 px-6 h-16">
        <div class="flex items-center gap-4">
          <button
            type="button"
            data-action="click->admin-sidebar#toggle"
            class="lg:hidden inline-flex items-center justify-center w-10 h-10 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors"
            aria-label="Toggle menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
<%# Branding and a link home, not a page heading. This was an h1, so every
    admin page announced the same title regardless of what it showed, and
    /admin ended up with three. The real heading is in the content area. %>
<span class="text-xl font-semibold text-slate-900">
            <%= link_to admin_root_path, class: "inline-flex items-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary" do %>
              <%= lucide_icon("wrench", class: "text-sitf-primary mr-2 w-4 h-4 shrink-0") %>
              Admin
            <% end %>
          </span>
        </div>
        <div class="flex items-center gap-4">
          <span class="hidden lg:inline text-sm text-slate-600">
            <%= current_user.email %>
          </span>
          <%= link_to "View site", root_path, class: "text-sm text-blue-600 hover:text-blue-800" %>
          <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm text-red-600 hover:text-red-800" %>
        </div>
      </div>
    </div>

    <!-- Admin Sidebar Navigation -->
    <div class="fixed top-16 left-0 h-[calc(100vh-4rem)] w-64 bg-white border-r border-slate-200 overflow-y-auto lg:block hidden" id="admin-sidebar">
      <nav class="p-4">
        <%= render "admin/shared/navigation" %>
      </nav>
    </div>

    <!-- Mobile Sidebar Overlay -->
    <div class="fixed inset-0 bg-black/50 z-40 hidden"
         data-admin-sidebar-target="overlay"
         data-action="click->admin-sidebar#toggle"
         style="display: none;"></div>

    <!-- Mobile Sidebar -->
    <div class="fixed top-16 left-0 h-[calc(100vh-4rem)] w-64 bg-white border-r border-slate-200 overflow-y-auto z-50 transform -translate-x-full transition-transform duration-300 lg:hidden"
         data-admin-sidebar-target="mobileSidebar">
      <nav class="p-4">
        <%= render "admin/shared/navigation" %>
      </nav>
    </div>

    <!-- Main Content -->
    <main class="pt-16 lg:pl-64 min-h-screen">
      <div class="p-6">
        <%# The shared partial, so admin gets the same role=status announcement and
            the icon-plus-text treatment as the rest of the app. %>
        <%= render "layouts/flash" %>

        <%# The page heading, from the same breadcrumb the title uses. Admin pages
            previously had no heading describing them - their only h1 was the
            branding in the header bar, identical on every page.

            Index and show pages lead with a section title rather than a page
            title, so this is visually hidden to avoid saying the same word twice
            on screen while still naming the page for assistive tech. A page that
            has its own visible h1 declares `content_for :own_heading` and this
            steps aside. %>
        <% unless content_for?(:own_heading) %>
          <h1 class="sr-only"><%= @breadcrumbs&.last&.dig(:label).presence || "Admin dashboard" %></h1>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
