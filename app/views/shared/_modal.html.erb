<%# Trading modal shell. Content is streamed into #modal_frame by the order forms.

    role="dialog" + aria-modal tells assistive tech this is a modal layer.
    aria-label describes it generically because the frame content is dynamic; if
    this shell is ever reused for something other than orders, point
    aria-labelledby at the loaded heading instead.

    Focus management (move in on open, trap while open, restore on close) lives
    in modal_controller.js. tabindex="-1" makes the panel itself focusable as a
    fallback when it contains no focusable children yet. %>
<div id="modal_overlay"
     data-controller="modal"
     data-modal-target="overlay"
     data-action="click->modal#backdropClick"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 hidden">

  <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full mx-4 p-6 relative"
       data-modal-target="content"
       role="dialog"
       aria-modal="true"
       aria-label="Order form"
       tabindex="-1">

    <button type="button"
            data-action="modal#close"
            class="absolute top-2 right-2 flex min-w-11 min-h-11 items-center justify-center rounded-full text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary transition-colors cursor-pointer">
      <span class="sr-only">Close order form</span>
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <%# The form is loaded here %>
    <turbo-frame id="modal_frame"></turbo-frame>

  </div>
</div>
