<div class="bg-white rounded-xl border border-slate-200 h-[150px] py-5 px-6 overflow-visible relative">
  <div class="h-full flex items-center justify-between gap-2">
    <div class="flex flex-col justify-center">
      <p class="text-sm text-slate-600">My earnings to invest</p>
      <p class="text-2xl font-semibold leading-tight tracking-tight mt-1 tabular-nums"><%= number_to_currency(@portfolio.cash_balance) %></p>
      <% if current_user.student? %>
        <%= link_to "Invest now", stocks_path, class: "tw-btn-primary mt-2 w-fit" %>
      <% else %>
        <%# Was bg-slate-400 with slate-700 ink: 4.04:1, under the 4.5:1 gate for text, in a
            hand-rolled rounded-full pill. tw-btn-primary-disabled is the named token. %>
        <span aria-disabled="true" class="tw-btn-primary-disabled mt-2 w-fit">Invest now</span>
      <% end %>
    </div>

    <%# Decorative: the card already states "Earnings to invest" and the figure, so alt is
        empty rather than a description a screen reader would read out twice. It was
        "Investment Funds", which was also Title Case. Matches the piggy bank on home/index.

        tw h-[170px] and -mb-2 do not work here, so the overflow effect uses a direct style. %>
    <%= image_tag 'investment-funds.png', class: 'w-auto object-contain select-none pointer-events-none self-end -mr-8', style: 'height: 170px; margin-bottom: -8px;', alt: '' %>
  </div>
</div>
