<div class="bg-white rounded-[22px] border border-black/30 h-[150px] py-5 px-6 overflow-visible relative">
  <div class="h-full flex items-center justify-between gap-2">
    <div class="flex flex-col justify-center">
      <p class="text-sm text-slate-600">My earnings to invest</p>
      <p class="text-2xl font-semibold leading-tight tracking-tight mt-1 tabular-nums"><%= number_to_currency(@portfolio.cash_balance) %></p>
      <% if current_user.student? %>
        <%= link_to "Invest now", stocks_path, class: "mt-2 bg-teal-700 hover:bg-teal-800 text-white font-medium px-6 py-2.5 rounded-full shadow-sm w-fit transition-colors" %>
      <% else %>
        <span aria-disabled="true" class="mt-2 font-medium px-6 py-2.5 rounded-full shadow-sm w-fit cursor-not-allowed bg-slate-400 text-slate-700">Invest now</span>
      <% end %>
    </div>

    <!--  tw h-[170px], -mb-2 does not work... so we use direct style for this overflow effect-->
    <%= image_tag 'investment-funds.png', class: 'w-auto object-contain select-none pointer-events-none self-end -mr-8', style: 'height: 170px; margin-bottom: -8px;', alt: 'Investment Funds' %>
  </div>
</div>
