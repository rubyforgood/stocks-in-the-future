<div class="mx-auto lg:w-2/3 w-full flex">
  <div class="mx-auto">
    <%= render @school %>
    <%= link_to "Edit this school", edit_school_path(@school), class: "mt-2 rounded-lg py-3 px-5 bg-slate-100 inline-block font-medium" %>
    <div class="inline-block ml-2">
      <%= button_to "Destroy this school", school_path(@school), method: :delete, class: "tw-btn-danger" %>
    </div>
    <%= link_to "Back to schools", schools_path, class: "ml-2 rounded-lg py-3 px-5 bg-slate-100 inline-block font-medium" %>
  </div>
</div>
