<%# Icon-only action button. `options[:icon]` is a Lucide icon name.
    44px minimum target per docs/responsive-design-guidelines.md; the visual
    glyph stays small while the hit area is full size. %>
<% btn_class = "inline-flex items-center justify-center w-11 h-11 #{options[:text_class] || 'text-black'} hover:text-sitf-primary-dark hover:bg-blue-50 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary transition-all duration-150 group" %>
<% icon_class = "w-4 h-4 lg:w-5 lg:h-5 shrink-0 group-hover:scale-110 transition-transform duration-150" %>

<% if options[:method] %>
  <%= button_to options[:path], method: options[:method], data: options[:data] || {}, class: btn_class, title: options[:title], aria: { label: options[:aria_label] } do %>
    <%= lucide_icon(options[:icon], class: icon_class) %>
  <% end %>
<% else %>
  <%= link_to options[:path], class: btn_class, title: options[:title], aria: { label: options[:aria_label] }, data: options[:data] || {} do %>
    <%= lucide_icon(options[:icon], class: icon_class) %>
  <% end %>
<% end %>
