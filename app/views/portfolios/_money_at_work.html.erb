<%# One plain-English sentence over figures already on the page.
    It restates rather than adds, which is the point: reading "$4.00 is still waiting to be
    invested" makes an idle balance feel like a decision instead of a number in a card.

    Withheld when a student has earned nothing yet - there is no story to tell, and the empty
    state above says the useful thing instead. %>
<% return if @insights.earned_cents.zero? %>

<div class="tw-card p-5">
  <p class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900">
    <%= lucide_icon "lightbulb", class: "size-4 shrink-0 text-amber-600" %>
    Your money at work
  </p>
  <p class="mt-2 text-sm text-slate-700">
    You have earned
    <span class="font-semibold tabular-nums"><%= number_to_currency(@insights.earned_cents / 100.0) %></span>.
    <% if @insights.holdings? %>
      <%# pluralize, so a student with one company does not read "1 companies". %>
      You put
      <span class="font-semibold tabular-nums"><%= number_to_currency(@insights.invested_cents / 100.0) %></span>
      into <%= pluralize(@insights.company_count, "company") %>,
      and
      <span class="font-semibold tabular-nums"><%= number_to_currency(@insights.cash_cents / 100.0) %></span>
      is still waiting to be invested.
    <% else %>
      All
      <span class="font-semibold tabular-nums"><%= number_to_currency(@insights.cash_cents / 100.0) %></span>
      of it is waiting to be invested.
    <% end %>
  </p>
</div>
