<%# Student portfolio.

    The Trade control appears in every holdings row and in the empty state, so its
    classes are named once here. sitf-primary on white is 6.18:1 with a white
    label; the previous sky-800 was fine for contrast but off-brand, and its focus
    ring was sky-500. %>
<% trade_class = "inline-flex min-h-11 items-center justify-center rounded-full bg-sitf-primary px-5 py-2 text-sm font-medium text-sitf-on-primary shadow-xs transition-colors hover:bg-sitf-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sitf-primary-dark" %>
<% trade_disabled_class = "inline-flex min-h-11 cursor-not-allowed items-center justify-center rounded-full bg-slate-300 px-5 py-2 text-sm font-medium text-slate-600 shadow-xs" %>

<div class="max-w-7xl mx-auto py-6 space-y-6">
  <!-- Header with badge icons and title -->
  <%# The heading used to upcase the username and append a comma plus the word
      PORTFOLIO in capitals - shouty all-caps, which design.md rules out. It was
      built with .upcase, so no copy sweep could have found it. A username is a
      proper noun, so it now keeps its own capitalisation. %>
  <%= render layout: "components/ui/page_header",
             locals: { title: "#{@portfolio.username}'s portfolio",
                       description: @portfolio.school_name } do %><% end %>

  <% if @portfolio.student? && !@portfolio.trading_enabled? %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-lg">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-yellow-800">Trading is currently disabled for your classroom.</p>
          <p class="mt-1 text-sm text-yellow-700">You cannot place buy or sell orders at this time. Please contact your teacher for more information.</p>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left area (spans 2 columns on large screens): metrics + holdings table -->
    <div class="flex flex-col gap-6 lg:col-span-2">
      <%= render 'portfolios/portfolio_chart' %>

      <%# Three stats, on the shared _stat primitive rather than hand-rolled cards
          with a 22px radius and a black/30 border.

          "Total earnings" and "Total cash value" both rendered
          @portfolio.cash_balance - the same number under two different labels.
          Earnings now come from the EarningsSummary already loaded for the panel
          further down this page, which is what the label describes. %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <%= render "components/ui/stat",
                   label: "Total earnings",
                   value: number_to_currency(@earnings_summary.total_earnings_cents / 100.0),
                   hint: "Attendance, reading, math and rewards" %>

        <%= render "components/ui/stat",
                   label: "Total cash value",
                   value: number_to_currency(@portfolio.cash_balance),
                   hint: "Available to invest",
                   testid: "cash-balance" %>

        <%= render "components/ui/stat",
                   label: "Total stocks",
                   value: @portfolio.portfolio_stocks.sum(:shares).to_i,
                   hint: "Shares held across all companies",
                   testid: "total-stocks" %>
      </div>
      <%# Holdings, on the shared table system.

          Was a saturated amber header band inside a black/60 border with a
          black/40 rule under every row, and a min-w-[700px] that forced a
          horizontal scroll at any width. Money columns were left-aligned.

          Numeric columns are now right-aligned with tabular figures so they read
          down the column, and there is an empty state - previously an empty
          portfolio rendered a header with nothing under it. %>
      <div data-testid="holdings-table">
        <%= render layout: "components/ui/data_table", locals: { caption: "Your current holdings" } do %>
          <thead class="table-header-row">
            <tr>
              <th scope="col" class="table-header-cell table-header-cell-left">Company</th>
              <th scope="col" class="table-header-cell table-header-cell-right">Qty.</th>
              <th scope="col" class="table-header-cell table-header-cell-right">Last price</th>
              <th scope="col" class="table-header-cell table-header-cell-right">Change</th>
              <th scope="col" class="table-header-cell table-header-cell-right">Total return</th>
              <th scope="col" class="table-header-cell"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% if @portfolio.positions.any? %>
              <% @portfolio.positions.each do |position| %>
                <% change_amount = position.change_amount %>
                <% total_return_amount = position.total_return_amount %>
                <% logo_path = "stock_logos/#{position.stock_ticker}-logo.svg" %>
                <tr class="table-body-row">
                  <td class="table-body-cell">
                    <div class="flex items-center gap-3">
                      <% if File.exist?("app/assets/images/#{logo_path}") %>
                        <%= image_tag asset_path(logo_path),
                                      class: "w-9 h-9 rounded-lg shrink-0",
                                      alt: "",
                                      loading: "lazy" %>
                      <% end %>
                      <span class="font-medium text-slate-900"><%= position.stock_ticker %></span>
                    </div>
                  </td>
                  <td class="table-body-cell table-body-cell-right"><%= position.shares %></td>
                  <td class="table-body-cell table-body-cell-right"><%= number_to_currency(position.stock_current_price) %></td>

                  <%# A sign as well as a colour, so the direction is not carried by
                      colour alone. green-700/red-700 clear AA where 600 does not. %>
                  <td class="table-body-cell table-body-cell-right <%= change_amount >= 0 ? 'text-green-700' : 'text-red-700' %>">
                    <%= change_amount >= 0 ? "+" : "" %><%= number_to_currency(change_amount) %>
                  </td>
                  <td class="table-body-cell table-body-cell-right <%= total_return_amount >= 0 ? 'text-green-700' : 'text-red-700' %>">
                    <%= total_return_amount >= 0 ? "+" : "" %><%= number_to_currency(total_return_amount) %>
                  </td>

                  <td class="table-body-cell text-right">
                    <% if current_user.student? %>
                      <%= link_to "Trade", stocks_path, class: trade_class %>
                    <% else %>
                      <span aria-disabled="true" class="<%= trade_disabled_class %>">Trade</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="p-0">
                  <%= render layout: "components/ui/empty_state",
                             locals: { icon: "chart-line",
                                       title: "No holdings yet",
                                       body: "Buy your first shares on the trading floor and they will appear here." } do %>
                    <% if current_user.student? %>
                      <%= link_to "Go to the trading floor", stocks_path, class: trade_class %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </div>
    </div>

    <!-- Right column (single column on large screens): My Earnings to Invest + Summary -->
    <div class="flex flex-col gap-6 lg:col-span-1">
      <%= render 'shared/earnings_to_invest_card' %>
      <%= render 'portfolios/earnings_summary_card' %>
    </div>
  </div>
</div>
