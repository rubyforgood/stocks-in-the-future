<%# The ten logos already in the repo, used as a collection rather than as row icons.

    Only what a student owns. The preview showed greyed-out slots for the rest, and they read as
    "collect them all" - a nudge to buy for completeness rather than for a reason, which is the
    opposite of what this app teaches. So there is no total and no empty slot.

    The ticker is the accessible name; the logo is decorative beside it. %>
<% return unless @insights.holdings? %>

<div class="tw-card p-5">
  <p class="text-sm font-medium text-slate-600">Companies you own</p>
  <ul class="mt-3 flex flex-wrap items-center gap-3">
    <% @insights.companies.each do |ticker| %>
      <% logo = "stock_logos/#{ticker}-logo.svg" %>
      <li>
        <span class="grid size-12 place-items-center rounded-xl border border-slate-200 bg-white shadow-xs">
          <% if File.exist?("app/assets/images/#{logo}") %>
            <%= image_tag asset_path(logo), class: "size-8", alt: "" %>
            <span class="sr-only"><%= ticker %></span>
          <% else %>
            <span class="text-xs font-semibold text-slate-700"><%= ticker %></span>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
</div>
